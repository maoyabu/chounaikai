# Local development only. Production: authenticated Atlas SRV URI (TLS is default).
MONGODB_URI=mongodb://127.0.0.1:27017/finance
# Production example: mongodb+srv://chounaikai_app:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/finance?retryWrites=true&w=majority
# List the exact Atlas SRV hostname from the URI. This does not replace Atlas Network Access.
MONGODB_ALLOWED_HOSTS=cluster.example.mongodb.net
# Custom/private CA only; leave empty for the public CA used by Atlas.
MONGODB_TLS_CA_FILE=
# Optional fixed-egress SOCKS5 proxy. Heroku Fixie Socks sets FIXIE_SOCKS_HOST automatically.
# Set only one of these; empty means a direct connection.
MONGODB_SOCKS_PROXY_URL=
FIXIE_SOCKS_HOST=
# Development: false. Heroku: 1. Nginx: trusted proxy IP/CIDR (e.g. loopback).
TRUST_PROXY=false
CHOUNAIKAI_SESSION_SECRET=replace-with-a-long-random-value
PORT=3003
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3003
# Production must use its HTTPS origin, e.g. https://your-app.herokuapp.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=町内会管理 <no-reply@example.com>
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_KEY=replace-with-api-key
CLOUDINARY_SECRET=replace-with-api-secret
# Google Drive credentials are encrypted in MongoDB. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIVE_ENCRYPTION_KEY=replace-with-64-hex-characters
