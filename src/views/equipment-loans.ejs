<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell equipment-page"><a class="back-link" href="<%= base %>">← 設備・備品管理へ戻る</a><% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %><section class="page-heading"><div><h1><%= item.name %>の貸出カレンダー</h1><p>所有数量：<%= item.quantity %><%= item.unit %> ／ 貸出可能期間：<%= item.availableFrom || '指定なし' %>〜<%= item.availableUntil || '指定なし' %></p></div></section>
<% if (!item.lendable || item.wishlist || item.quantity <= 0) { %><div class="alert">現在は<%= item.wishlist ? '購入希望のため貸出対象外です' : !item.lendable ? '貸出可能に設定されていません' : '在庫数量がありません' %>。<% if (canAnswer) { %><a href="<%= base %>/<%= item._id %>/edit">備品の編集</a>で貸出設定と数量を確認してください。<% } %></div><% } %>
<section class="content-card"><div class="section-heading"><a class="button button-quiet" href="?month=<%= previous %>">‹ 前月</a><h2><%= month.replace('-','年') %>月</h2><a class="button button-quiet" href="?month=<%= next %>">次月 ›</a></div><p class="help-text">承認待ちの申込みも空き数量に反映しています。日付を選ぶと空き時間を確認して申し込めます。時刻は日本時間です。</p><div class="equipment-calendar"><% ['日','月','火','水','木','金','土'].forEach(day=>{ %><strong><%= day %></strong><% }) %><% cells.forEach(cell=>{ %><% if(!cell){ %><span></span><% } else { %><button type="button" class="equipment-calendar-day <%= cell.available ? 'equipment-calendar-available' : '' %>" data-loan-date="<%= cell.date %>" ><strong><%= cell.day %></strong><span class="equipment-calendar-mini" aria-label="時間帯ごとの利用状況"><% (cell.segments || []).forEach(segment => { %><i class="<%= segment.blocked ? 'time-blocked' : segment.used ? segment.available ? 'time-partial' : 'time-full' : 'time-free' %>" style="flex:<%= segment.endMinute-segment.startMinute %>" title="<%= segment.startTime %>〜<%= segment.endTime %> <%= segment.blocked ? '利用NG・対象外' : segment.used ? '予約あり' : '空き' %>"></i><% }) %></span><small><% if ((cell.segments || []).some(segment => segment.used > 0)) { %><%= cell.segments.length > 1 ? '時間予約あり・' : '予約あり・' %><% } %><%= cell.available ? `空きあり（最大${cell.capacity}${item.unit}）` : '空きなし' %></small></button><% } %><% }) %></div></section>
<dialog id="equipment-day-dialog" class="equipment-day-dialog" aria-labelledby="equipment-day-title"><div class="section-heading"><h2 id="equipment-day-title"></h2><button type="button" data-day-close aria-label="閉じる">×</button></div>
<div class="equipment-day-body"><p class="help-text">緑：空きあり ／ 黄：一部貸出中 ／ 赤：満数 ／ 灰：利用NG・貸出対象外</p>
<div class="equipment-time-scroll"><div class="equipment-time-scale"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div><div id="equipment-time-bar" class="equipment-time-bar"></div></div><div id="equipment-time-details"></div>
<p id="equipment-day-error" class="alert alert-error" role="alert" hidden></p>
<% if(item.lendable && !item.wishlist && item.quantity > 0){ %><form id="equipment-day-loan" class="form-stack" data-day-form action="<%= base %>/<%= item._id %>/loans" method="post"><h3>貸出を申し込む</h3><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="equipment-form-grid equipment-time-form-grid"><label>開始日<input name="startDate" type="date" min="<%= today %>" required></label><label>終了日<input name="endDate" type="date" min="<%= today %>" required></label><label class="equipment-time-all-day"><input name="allDay" type="checkbox">終日</label><label>開始時間<input name="startTime" type="time" value="09:00" required></label><label>終了時間（24:00も可）<input name="endTime" value="17:00" placeholder="17:00" pattern="([01][0-9]|2[0-3]):[0-5][0-9]|24:00" required></label><label class="equipment-time-wide equipment-time-quantity">数量<input name="quantity" type="number" value="1" min="1" max="<%= item.quantity %>" required></label><label class="equipment-time-wide">利用目的<input name="purpose" maxlength="500" required></label></div><button class="button button-primary">貸出を申し込む</button></form><% } %>
<% if(canAnswer){ %><section><h3>利用NGの日を設定</h3><p class="help-text">メンテナンスや棚卸しなど、全員が利用できない日時です。重なる予約がある場合は先に申込みを取り消してください。</p><div id="equipment-day-blocks"></div><form id="equipment-day-block" class="form-stack" data-day-form action="<%= base %>/<%= item._id %>/loan-blocks" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="equipment-form-grid equipment-time-form-grid"><label>開始日<input name="startDate" type="date" min="<%= today %>" required></label><label>終了日<input name="endDate" type="date" min="<%= today %>" required></label><label class="equipment-time-all-day"><input name="allDay" type="checkbox" checked>終日</label><label>開始時間<input name="startTime" type="time" value="09:00" required disabled></label><label>終了時間（24:00も可）<input name="endTime" value="17:00" pattern="([01][0-9]|2[0-3]):[0-5][0-9]|24:00" required disabled></label><label class="equipment-time-wide">理由<input name="reason" maxlength="500" placeholder="メンテナンス、棚卸しなど" required></label></div><button class="button button-quiet">利用NGにする</button></form></section><% } %></div></dialog>
<script id="equipment-day-data" type="application/json"><%- JSON.stringify({ cells, blocks: (item.loanBlocks || []).map(block => ({ _id: block._id, startDate: block.startDate, endDate: block.endDate, reason: block.reason, allDay: block.allDay, startTime: block.startTime, endTime: block.endTime })), today, unit: item.unit, canAnswer, blockUrl: `${base}/${item._id}/loan-blocks`, csrfToken }).replace(/</g, '\\u003c') %></script>
<section class="content-card equipment-place"><h2><%= canAnswer ? '貸出申込みの管理' : '自分の申込み' %></h2><% if(!requests.length){ %><p>申込みはありません。</p><% } %><% requests.forEach(loan=>{ %><article class="equipment-loan-row"><div><strong><%= loan.startDate %>〜<%= loan.endDate %> ／ <%= loan.quantity %><%= item.unit %> ／ <%= loan.allDay === false ? `${loan.startTime}〜${loan.endTime}` : '終日' %></strong><span class="status-badge"><%= ({pending:'承認待ち',approved:'承認済み',rejected:'却下',cancelled:'取消済み',returned:'返却済み'})[loan.status] %></span><% if(canAnswer){ %><p><%= loan.borrower?.displayname || loan.borrower?.username || '退会済みの会員' %> ／ <%= loan.purpose %></p><% } else { %><p><%= loan.purpose %></p><% } %></div><div class="equipment-toolbar"><% (canAnswer ? loan.status==='pending' ? ['approved','rejected','cancelled'] : loan.status==='approved' ? ['returned','cancelled'] : [] : ['pending','approved'].includes(loan.status) ? ['cancelled'] : []).forEach(action=>{ %><form action="<%= base %>/loans/<%= loan._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= action %>"><button class="button button-quiet button-small"><%= ({approved:'承認',rejected:'却下',cancelled:'取消',returned:'返却済みにする'})[action] %></button></form><% }) %></div></article><% }) %></section>
</main><script src="/assets/equipment-calendar.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>
