<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell page-narrow resident-participation-shell">
  <a class="back-link" href="/dashboard">← ホームへ戻る</a>
  <section class="page-heading"><div><p class="eyebrow">住民登録</p><h1><%= association.name %>への参加申請</h1><p>世帯主として町内会への参加を申請します。家族は世帯主が世帯情報に登録し、招待してください。</p></div></section>
  <% if (!districtGroups.length) { %><div class="alert alert-error">現在、参加先として選択できる班がありません。</div><% } else { %>
  <form action="/associations/<%= association._id %>/join" method="post" class="form-card form-stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>地区 <span class="required">必須</span><select id="join-district" required><option value="">選択してください</option><% districtGroups.forEach((district) => { %><option value="<%= district._id %>"><%= district.name %></option><% }) %></select></label><label>班 <span class="required">必須</span><select id="join-group"><option value="">地区を選択してください</option></select></label><input type="hidden" name="districtGroupId" id="join-district-group" value="<%= values.districtGroupId || '' %>">
    <input type="hidden" name="residentMode" value="representative">
    <div id="join-representative-fields" class="form-stack">
    <div class="form-columns"><label>郵便番号 <span class="required">必須</span><input name="postalCode" value="<%= values.postalCode || '' %>" autocomplete="postal-code" required></label><label>電話番号（任意）<input type="tel" name="phone" value="<%= values.phone || '' %>" autocomplete="tel"></label></div>
    <label>住所 <span class="required">必須</span><input name="street" value="<%= values.street || '' %>" autocomplete="street-address" required></label>
    <label>建物名など<input name="building" value="<%= values.building || '' %>"></label>
    </div>
    <div class="form-columns"><label>代表者氏名（本人情報と共通）<input value="<%= currentUser.displayname || currentUser.username %>" disabled><small>氏名はプロフィールの「本人情報」で変更できます。</small></label><label>氏名（よみ） <span class="required">必須</span><input name="representativeKana" value="<%= values.representativeKana || '' %>" required></label></div>
    <div class="form-columns"><label>生年月日 <span class="required">必須</span><input type="date" name="birthDate" value="<%= values.birthDate || '' %>" required></label><label>性別 <span class="required">必須</span><select name="gender" required><% [['unspecified', '回答しない'], ['male', '男性'], ['female', '女性'], ['other', 'その他']].forEach(([value, label]) => { %><option value="<%= value %>" <%= (values.gender || 'unspecified') === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label></div>
    <div class="form-columns"><label>メールアドレス <span class="required">必須</span><input type="email" name="email" value="<%= currentUser.email || '' %>" required></label><label>LINEアカウント（任意）<input name="lineAccount" value="<%= values.lineAccount || '' %>"></label></div>
    <label>班長へのメッセージ（任意）<textarea name="applicantNote" rows="3"><%= values.applicantNote || '' %></textarea></label>
    <div class="form-actions"><a class="button button-quiet" href="/dashboard">キャンセル</a><button class="button button-primary">参加を申請する</button></div>
  </form><% } %>
</main>
<script>const joinLocations=<%- JSON.stringify(typeof locationOptions !== 'undefined' ? locationOptions : []) %>,joinDistrict=document.getElementById('join-district'),joinGroup=document.getElementById('join-group'),joinLocation=document.getElementById('join-district-group'),joinCurrent=String(joinLocation?.value||'');if(joinDistrict&&joinGroup&&joinLocation){const refreshJoinGroups=()=>{const district=joinLocations.find(item=>String(item._id)===String(joinDistrict.value)),groups=joinLocations.filter(item=>String(item.parentDistrict)===String(joinDistrict.value));joinGroup.innerHTML=groups.length?'<option value="">選択してください</option>'+groups.map(item=>`<option value="${item._id}">${item.label.replace(district?.label||'','')}</option>`).join(''):'<option value="">地区全体</option>';joinGroup.required=Boolean(groups.length);joinGroup.value=groups.some(item=>String(item._id)===joinCurrent)?joinCurrent:'';joinLocation.value=joinGroup.value||joinDistrict.value;};joinDistrict.addEventListener('change',refreshJoinGroups);joinGroup.addEventListener('change',()=>{joinLocation.value=joinGroup.value||joinDistrict.value;});if(joinCurrent){const selected=joinLocations.find(item=>String(item._id)===joinCurrent);joinDistrict.value=String(selected?.parentDistrict||joinCurrent);}refreshJoinGroups();}</script>
<%- include('partials/foot') %>
