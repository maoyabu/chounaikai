<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %><a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a>
<section class="page-heading annual-heading"><div><p class="eyebrow">役員一覧</p><h1><%= fiscalYear %>年度の役員一覧</h1><p>行を選択すると役員情報を編集できます。</p></div><form class="year-selector" method="get"><label>表示年度<select name="year" onchange="this.form.submit()"><% for(let y=fiscalYear-2;y<=fiscalYear+2;y++){ %><option value="<%= y %>" <%= y===fiscalYear?'selected':'' %>><%= y %>年度</option><% } %></select></label></form></section>
<section class="content-card management-card"><label class="resident-search">役員を検索<input type="search" id="officer-directory-search" placeholder="氏名・班・メール・住所を入力"></label><div class="resident-selection-list"><% officers.forEach((o)=>{const n=o.user?.displayname||o.user?.username||'退会済みユーザー',d=o.membership?.districtGroup?.name||'班未設定',e=o.user?.email||'メール未登録',a=`〒${o.membership?.household?.address?.postalCode||'—'} ${o.membership?.household?.address?.street||''} ${o.membership?.household?.address?.building||''}`;%><article data-directory-row data-search="<%= [n,d,e,a].join(' ') %>"><button type="button" class="resident-row-button" data-open-officer-dialog="od-<%= o._id %>"><% if(o.user?.avatar){%><img class="profile-avatar resident-avatar" src="<%= o.user.avatar %>" alt=""><%}else{%><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%= n.charAt(0) %></span><%}%><strong><%= n %>さん</strong><span class="resident-tags"><span class="status-badge"><%= d %></span><span class="status-badge member-attribute-tag">役員</span><%if(o.role?.name){%><span class="status-badge member-attribute-tag"><%= o.role.name %></span><%}%><%if(o.department?.name){%><span class="status-badge member-attribute-tag"><%= o.department.name %></span><%}%></span><span><%= e %></span><span class="resident-address"><%= a %></span></button><dialog class="officer-dialog" id="od-<%= o._id %>"><div class="dialog-heading"><h3><%= n %>さんの役員設定</h3><button type="button" class="dialog-close" data-close-officer-dialog>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/officers/configure" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><input type="hidden" name="userId" value="<%= o.user?._id %>"><input type="hidden" name="returnTo" value="officers"><label class="officer-flag"><input type="checkbox" name="isOfficer" value="1" checked>年度役員</label><label>所属班<select name="membershipDistrictGroupId" required><%districtGroups.forEach(g=>{%><option value="<%=g._id%>" <%=String(o.membership?.districtGroup?._id||'')===String(g._id)?'selected':''%>><%=g.name%></option><%})%></select></label><label>役職<select name="roleId"><option value="">役職なし</option><%roles.forEach(r=>{%><option value="<%=r._id%>" <%=String(o.role?._id||'')===String(r._id)?'selected':''%>><%=r.name%></option><%})%></select></label><label>所属部署<select name="departmentId"><option value="">所属部署なし</option><%departments.forEach(dpt=>{%><option value="<%=dpt._id%>" <%=String(o.department?._id||'')===String(dpt._id)?'selected':''%>><%=dpt.name%></option><%})%></select></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-officer-dialog>キャンセル</button><button class="button button-primary">設定を保存</button></div></form></dialog></article><%})%></div><p id="officer-directory-empty" hidden>条件に一致する役員はいません。</p></section>
<script>(()=>{const q=document.getElementById('officer-directory-search'),rows=[...document.querySelectorAll('[data-directory-row]')],norm=v=>String(v||'').normalize('NFKC').toLowerCase();q?.addEventListener('input',()=>rows.forEach(r=>r.hidden=!norm(r.dataset.search).includes(norm(q.value))));document.querySelectorAll('[data-open-officer-dialog]').forEach(b=>b.onclick=()=>document.getElementById(b.dataset.openOfficerDialog)?.showModal());document.querySelectorAll('[data-close-officer-dialog]').forEach(b=>b.onclick=()=>b.closest('dialog')?.close())})();</script></main><%- include('partials/foot') %>
