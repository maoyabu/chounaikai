<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell">
  <a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a>
  <section class="page-heading annual-heading"><div><p class="eyebrow">役員一覧</p><h1><%= fiscalYear %>年度の役員一覧</h1></div><form class="year-selector"><label>表示年度<select name="year" onchange="this.form.submit()"><% for (let y = fiscalYear - 2; y <= fiscalYear + 2; y++) { %><option value="<%= y %>" <%= y === fiscalYear ? 'selected' : '' %>><%= y %>年度</option><% } %></select></label></form></section>
  <section class="content-card management-card"><label class="resident-search">役員を検索<input type="search" id="officer-directory-search" placeholder="氏名・地区・班・メール・住所を入力"></label><div class="resident-selection-list">
    <% officers.forEach((o) => { const name = o.name || o.user?.displayname || o.user?.username || '氏名未登録'; const district = o.districtGroup?.name || '地区・班未設定'; const email = o.user?.email || ''; const address = o.address || o.membership?.household?.address?.street || ''; %>
    <article class="annual-directory-row" data-directory-row data-search="<%= [name, district, email, address].join(' ') %>"><div class="resident-row-button resident-row-static" data-open-record="officer-<%= o._id %>"><strong><%= name %>さん</strong><span class="resident-tags"><span class="status-badge"><%= district %></span><span class="status-badge member-attribute-tag"><%= o.role?.name || '一般役員' %></span><% if (o.department?.name) { %><span class="status-badge member-attribute-tag"><%= o.department.name %></span><% } %></span><span><%= email || 'メール未登録' %></span><span class="resident-address"><%= address || '住所未登録' %></span><% if (o.phone || o.mobilePhone) { %><small><%= o.phone || '' %>　<%= o.mobilePhone || '' %></small><% } %><% if (o.user) { %><small>会員：<%= o.user.displayname || o.user.username || o.user.email %></small><% } %></div><dialog class="officer-dialog" id="officer-<%= o._id %>"><div class="dialog-heading"><h3>役員を編集</h3><button type="button" class="dialog-close">×</button></div><form method="post" action="/associations/<%= association._id %>/manage/annual/officers/<%= o._id %>/update" class="resident-officer-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>役職<select name="roleId"><option value="">一般役員</option><% roles.forEach((role) => { %><option value="<%= role._id %>" <%= String(o.role?._id || '') === String(role._id) ? 'selected' : '' %>><%= role.name %></option><% }) %></select></label><label>部会<select name="departmentId" required><option value="">選択してください</option><% departments.forEach((department) => { %><option value="<%= department._id %>" <%= String(o.department?._id || '') === String(department._id) ? 'selected' : '' %>><%= department.name %></option><% }) %></select></label><label>氏名<input name="name" value="<%= o.name || '' %>" required></label><label>氏名よみ<input name="nameKana" value="<%= o.nameKana || '' %>" required></label><label>住所<input name="address" value="<%= o.address || '' %>"></label><label>電話番号<input name="phone" value="<%= o.phone || '' %>" type="tel"></label><label>携帯電話番号<input name="mobilePhone" value="<%= o.mobilePhone || '' %>" type="tel"></label><div class="form-actions"><button type="button" class="button button-quiet dialog-cancel">キャンセル</button><button class="button button-primary">保存</button></div></form></dialog></article>
    <% }) %>
  </div><p id="officer-directory-empty" hidden>条件に一致する役員はいません。</p></section>
  <script>(()=>{const q=document.getElementById('officer-directory-search'),rows=[...document.querySelectorAll('[data-directory-row]')],norm=v=>String(v||'').normalize('NFKC').toLowerCase();q?.addEventListener('input',()=>rows.forEach(r=>r.hidden=!norm(r.dataset.search).includes(norm(q.value))));document.querySelectorAll('[data-open-record]').forEach(b=>b.addEventListener('click',()=>document.getElementById(b.dataset.openRecord)?.showModal()));document.querySelectorAll('.dialog-close,.dialog-cancel').forEach(b=>b.addEventListener('click',()=>b.closest('dialog')?.close()))})();</script>
</main><%- include('partials/foot') %>
