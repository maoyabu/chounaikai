<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell question-box-shell">
  <a class="back-link" href="/dashboard">← ホームへ戻る</a>
  <section class="page-heading association-title-heading"<% if (association.symbolImage?.url) { %> style="--symbol-url: url('<%= association.symbolImage.url %>')"<% } %>><h1><%= association.name %>　役員メニュー</h1></section>
  <div class="officer-menu-layout"><section class="admin-section question-home-section officer-menu-section">
    <div class="section-heading"><h2>役員の連絡</h2></div>
    <div class="question-home-list">
      <a class="question-home-link" href="/associations/<%= association._id %>/questions/officer"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'question' }) %><span>住人からの質問・ご意見</span></strong><small>投稿と再質問を確認して回答する</small></span><span class="question-home-counts"><% if (unansweredCount) { %><span class="status-badge status-pending">未回答 <%= unansweredCount %>件</span><% } %></span><span class="list-arrow" aria-hidden="true">›</span></a>
      <a class="question-home-link communication-menu-link" href="/associations/<%= association._id %>/announcements/officer"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'announcement' }) %><span>町内会役員から住人への連絡・回覧板</span></strong><small>班長または全住人へ送信し、確認状況を確認する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
      <a class="question-home-link communication-menu-link" href="/associations/<%= association._id %>/officer-network"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'network' }) %><span>役員間の連絡網</span></strong><small>全役員・部・個別役員・役員グループへ連絡する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
      <a class="question-home-link" href="/associations/<%= association._id %>/events/manage"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'calendar' }) %><span>町内会行事管理</span></strong><small>行事の登録・編集・公開・完了を管理する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
    </div>
  </section><aside class="admin-section question-home-section officer-functions-section">
    <div class="section-heading"><h2>役員機能</h2></div>
    <div class="question-home-list">
      <a class="question-home-link finance-menu-link" href="/associations/<%= association._id %>/finance"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'finance' }) %><span>町内会会計管理</span></strong><small>年度予算・収支・会計データを管理する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
      <a class="question-home-link officer-function-blue" href="/associations/<%= association._id %>/equipment"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'equipment' }) %><span>設備・備品管理</span></strong><small>保管場所・棚卸し・期限・貸出を管理する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
      <a class="question-home-link officer-function-blue" href="/associations/<%= association._id %>/documents"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'documents' }) %><span>町内会ドキュメント管理</span></strong><small>Google Driveの資料を閲覧・アップロード・ダウンロード・削除する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
      <a class="question-home-link officer-function-green" href="/associations/<%= association._id %>/department-plans"><span><strong class="officer-menu-title"><%- include('partials/officer-menu-icon', { icon: 'target' }) %><span>各部会の年度目標管理</span></strong><small>部会の目標を確認し、年度末に実施報告を入力する</small></span><span class="list-arrow" aria-hidden="true">›</span></a>
    </div>
  </aside></div>
</main>
<%- include('partials/foot') %>
