<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell finance-shell"><a class="back-link" href="/associations/<%= association._id %>/finance">← 町内会会計管理へ戻る</a><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>月別支出項目別グラフ</h1><p>最大3年度を月別に比較できます。</p></div></div><section class="content-card"><form class="finance-chart-year-picker" method="get"><p>比較する年度を選択（最大3件）</p><% for (let fiscal = new Date().getFullYear() - 4; fiscal <= new Date().getFullYear(); fiscal++) { %><label><input type="checkbox" name="years" value="<%= fiscal %>" <%= years.includes(fiscal) ? 'checked' : '' %>> <%= fiscal %>年度</label><% } %><button class="button button-primary button-small">表示</button></form></section><section class="content-card finance-chart-card"><div class="finance-monthly-chart" data-chart='<%- JSON.stringify({ years, months, data, items }) %>'><div class="finance-monthly-bars"></div><div class="finance-chart-legend"></div><div class="finance-chart-tooltip" hidden></div></div></section></main><script>(()=>{const root=document.querySelector('.finance-monthly-chart'),chart=JSON.parse(root.dataset.chart),colors=['#176b4d','#2f7f68','#469b83','#6eb39a','#9ac9a9','#d5a846','#d58b46','#b85c52','#8d6aa8','#5078a8','#5f9aaa','#7d8b73'],hidden=new Set(),max=Math.max(...chart.months.flatMap(m=>chart.data.map(y=>Object.values(y.values[m]||{}).reduce((a,b)=>a+b,0))),1),tip=root.querySelector('.finance-chart-tooltip'),legend=root.querySelector('.finance-chart-legend');chart.items.forEach((item,i)=>{const b=document.createElement('button');b.innerHTML='<i style="background:'+colors[i%colors.length]+'"></i>'+item;b.onclick=()=>{hidden.has(item)?hidden.delete(item):hidden.add(item);b.classList.toggle('is-hidden');render()};legend.append(b)});function render(){const area=root.querySelector('.finance-monthly-bars');area.innerHTML='';chart.months.forEach(month=>{const group=document.createElement('div');group.className='finance-month-group';const label=document.createElement('span');label.textContent=month+'月';const yearBars=document.createElement('div');yearBars.className='finance-month-year-bars';chart.data.forEach(year=>{const bar=document.createElement('div');bar.className='finance-month-bar';chart.items.forEach((item,i)=>{const value=year.values[month]?.[item]||0;if(hidden.has(item)||!value)return;const s=document.createElement('div');s.className='finance-chart-segment';s.style.height=value/max*100+'%';s.style.background=colors[i%colors.length];s.onmouseenter=e=>{tip.innerHTML='<strong>'+year.year+'年度 '+month+'月</strong><br><span class="finance-tooltip-color" style="background:'+colors[i%colors.length]+'"></span>'+item+'<br>合計金額：¥'+value.toLocaleString();tip.hidden=false;tip.style.left=e.offsetX+12+'px';tip.style.top=e.offsetY-12+'px'};s.onmouseleave=()=>tip.hidden=true;bar.append(s)});yearBars.append(bar)});group.append(yearBars,label);area.append(group)})}render()})();</script><%- include('partials/foot') %>
