<% const latest = goodPlaces.reduce((newest, report) => report.createdAt > newest.createdAt ? report : newest); const latestAssociationId = typeof galleryAssociationId !== 'undefined' ? galleryAssociationId : latest.association._id; %>
<span class="good-place-gallery-latest"><img src="/associations/<%= latestAssociationId %>/good-places/<%= latest._id %>/photo" alt="最新投稿：<%= latest.title %>" loading="lazy"><span><time datetime="<%= latest.createdAt.toISOString() %>"><%= latest.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }) %></time></span></span>
