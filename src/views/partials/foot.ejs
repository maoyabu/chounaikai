<script>(()=>{const cf=document.getElementById('finance-entry-cf'),payment=document.querySelector('select[name="payment_type"]');if(!cf||!payment)return;const field=payment.closest('label'),update=()=>{const income=cf.value==='収入';field.hidden=income;field.style.display=income?'none':'';payment.required=!income;payment.disabled=income;if(income)payment.value=''};cf.addEventListener('change',update);update()})();</script>
<script>(()=>{document.addEventListener('close',event=>{const dialog=event.target;if(!dialog.matches('.finance-detail-budget-dialog')||dialog.returnValue!=='ok'||!dialog.row)return;const total=[...dialog.querySelectorAll('[data-key="budget"]')].reduce((sum,input)=>sum+(Number(input.value.replace(/,/g,''))||0),0),amount=dialog.row.querySelector('.finance-amount-input');if(amount){amount.value=total.toLocaleString('ja-JP');amount.readOnly=true}},true)})();</script>
<script>(()=>{document.addEventListener('close',event=>{const dialog=event.target;if(!dialog.matches('.finance-detail-budget-dialog')||dialog.returnValue!=='ok'||!dialog.row)return;const details=[...dialog.querySelectorAll('.finance-detail-row')].map(row=>Object.fromEntries([...row.querySelectorAll('[data-key]')].map(input=>[input.dataset.key,input.dataset.key==='budget'?Number(input.value.replace(/,/g,''))||0:input.value.trim()]))).filter(detail=>detail.name||detail.content||detail.budget||detail.memo);const hidden=dialog.row.querySelector('[name="itemDetails"]');if(hidden)hidden.value=JSON.stringify(details)},true)})();</script>
<script>(()=>{document.addEventListener('click',event=>{const button=event.target.closest('.finance-detail-budget-dialog button[value="ok"]');if(!button)return;const dialog=button.closest('.finance-detail-budget-dialog');if(!dialog?.row)return;const details=[...dialog.querySelectorAll('.finance-detail-row')].map(row=>Object.fromEntries([...row.querySelectorAll('[data-key]')].map(input=>[input.dataset.key,input.dataset.key==='budget'?Number(input.value.replace(/,/g,''))||0:input.value.trim()]))).filter(detail=>detail.name||detail.content||detail.budget||detail.memo);const hidden=dialog.row.querySelector('[name="itemDetails"]');if(hidden)hidden.value=JSON.stringify(details)},true)})();</script>
<dialog class="finance-detail-view-dialog"><div class="finance-detail-view-heading"><h2>予算明細</h2><button type="button" class="finance-detail-view-close" aria-label="閉じる">×</button></div><div class="finance-detail-view-content"></div><div class="finance-detail-view-subtotal"></div></dialog><script>(()=>{const dialog=document.querySelector('.finance-detail-view-dialog'),content=dialog.querySelector('.finance-detail-view-content'),subtotal=dialog.querySelector('.finance-detail-view-subtotal');dialog.querySelector('.finance-detail-view-close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});document.addEventListener('click',event=>{const trigger=event.target.closest('.finance-budget-detail-trigger');if(!trigger)return;const details=JSON.parse(decodeURIComponent(trigger.dataset.details||'[]'));content.replaceChildren(...details.map(detail=>{const article=document.createElement('article');article.className='finance-detail-view-item finance-detail-view-row';const title=document.createElement('strong');title.className='finance-detail-view-name';title.textContent=detail.name||'';const description=document.createElement('span');description.className='finance-detail-view-description';description.textContent=detail.content||'';const amount=document.createElement('strong');amount.className='finance-detail-view-amount';amount.textContent='¥'+Number(detail.budget||0).toLocaleString('ja-JP');const memo=document.createElement('div');memo.className='finance-detail-view-memo';memo.textContent=detail.memo||'';article.append(title,description,amount,memo);return article}));const sum=details.reduce((total,detail)=>total+(Number(detail.budget)||0),0);subtotal.textContent='小計：¥'+sum.toLocaleString('ja-JP');dialog.showModal()})})();</script>
<script>(()=>{const cf=document.getElementById('finance-entry-cf');if(!cf)return;const fields=['receiptNo','usedBy'].map(name=>document.querySelector(`[name="${name}"]`)?.closest('label')).filter(Boolean),update=()=>{const income=cf.value==='収入';fields.forEach(field=>{field.hidden=income;field.style.display=income?'none':''})};cf.addEventListener('change',update);update()})();</script>
<script>(()=>{if(Array.isArray(window.financeYears)&&window.financeYears.length){document.querySelectorAll('.finance-annual-year-selector select,.finance-public-summary select').forEach(select=>{const current=select.value;[...select.options].forEach(option=>{if(!window.financeYears.includes(Number(option.value)))option.remove()});if([...select.options].some(option=>option.value===current))select.value=current});document.querySelectorAll('input[name="years"]').forEach(input=>{if(!window.financeYears.includes(Number(input.value)))input.closest('label')?.remove()})}if(new URLSearchParams(location.search).get('public')!=='1')return;const match=location.pathname.match(/^\/associations\/([^/]+)\/finance\/(?:expense-chart|monthly-expense-chart)/);if(!match)return;const back=document.querySelector('.back-link');if(back){back.href=`/associations/${match[1]}/finance/public`;back.textContent='← 住人用の会計報告のページに戻る'}})();</script>
<script>(()=>{document.addEventListener('click',event=>{const row=event.target.closest('.association-event-manage-item');if(!row||event.target.closest('button,form,a,input,select,textarea,[data-event-open],.association-event-completed-tag'))return;const edit=row.querySelector('[data-event-open^="edit-event-"]');if(edit)document.getElementById(edit.dataset.eventOpen)?.showModal()})})();</script>
<% if (currentUser) { %><dialog id="notification-permission-dialog" class="officer-dialog" data-login-prompt="<%= showNotificationPrompt ? 'true' : 'false' %>"><div class="dialog-heading"><div><p class="eyebrow">通知設定</p><h2>通知をONにしますか？</h2></div><button type="button" class="dialog-close" data-notification-dismiss aria-label="閉じる">×</button></div><p>参加申請、行事変更、町内会からの重要なお知らせをブラウザで受け取れるようになります。</p><p id="notification-consent-error" class="help-text" role="status" hidden></p><div class="form-actions"><button type="button" class="button button-quiet" data-notification-dismiss>後で設定</button><button type="button" class="button button-primary" id="notification-enable-button">通知をONにする</button></div></dialog><script src="/assets/notification-consent.js?v=<%= assetVersion %>"></script><% } %>
