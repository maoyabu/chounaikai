<script>(()=>{if(Array.isArray(window.financeYears)&&window.financeYears.length){document.querySelectorAll('.finance-annual-year-selector select,.finance-public-summary select').forEach(select=>{const current=select.value;[...select.options].forEach(option=>{if(!window.financeYears.includes(Number(option.value)))option.remove()});if([...select.options].some(option=>option.value===current))select.value=current});document.querySelectorAll('input[name="years"]').forEach(input=>{if(!window.financeYears.includes(Number(input.value)))input.closest('label')?.remove()})}if(new URLSearchParams(location.search).get('public')!=='1')return;const match=location.pathname.match(/^\/associations\/([^/]+)\/finance\/(?:expense-chart|monthly-expense-chart)/);if(!match)return;const back=document.querySelector('.back-link');if(back){back.href=`/associations/${match[1]}/finance/public`;back.textContent='← 住人用の会計報告のページに戻る'}})();</script>
</body>
</html>
