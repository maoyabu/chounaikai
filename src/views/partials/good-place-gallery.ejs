<% if (typeof goodPlaces !== 'undefined' && goodPlaces.length) { const count = goodPlaces.length; const slots = count <= 2 ? 1 : count <= 4 ? 3 : 5; const rotating = count === 2 || count >= 4; %>
<section class="content-card good-place-gallery" data-good-place-gallery data-slots="<%= slots %>" data-rotating="<%= rotating %>"><a class="section-heading good-place-gallery-link" href="/associations/<%= association._id %>/good-places"><h2>わがまちのいいところ</h2><span aria-hidden="true">→</span></a>
<div class="good-place-grid good-place-layout-<%= slots %>"><% goodPlaces.forEach((report, index) => { %><a class="good-place-feature <%= index === 0 ? 'is-featured' : '' %>" href="/associations/<%= association._id %>/good-places/<%= report._id %>" <%= index >= slots ? 'hidden' : '' %>><img src="/associations/<%= association._id %>/good-places/<%= report._id %>/photo" alt="<%= report.title %>" loading="lazy"><div><strong><%= report.title %></strong><small><time datetime="<%= report.createdAt.toISOString() %>"><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></time><% if (typeof showGoodPlaceAuthors !== 'undefined' && showGoodPlaceAuthors) { %> · <%= report.author?.displayname || '退会した住人' %><% } %></small></div></a><% }) %></div>
<% if (rotating) { %><div class="good-place-gallery-controls" hidden><button type="button" class="button button-quiet" data-gallery-prev aria-label="前の写真に切り替える">‹ 前へ</button><button type="button" class="button button-quiet" data-gallery-pause aria-pressed="false">一時停止</button><button type="button" class="button button-quiet" data-gallery-next aria-label="次の写真に切り替える">次へ ›</button></div><% } %>
</section>
<script src="/assets/good-place-gallery.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
<% } %>
