<article class="equipment-inventory-item"><div class="equipment-card-main"><% if(item.productImageUrl){ %><img src="<%= item.productImageUrl %>" alt="" loading="lazy"><% } %><div><strong><%= item.name %></strong><p><%= item.quantity %><%= item.unit %><% if(item.shortage){ %> <span class="equipment-warning">不足 <%= item.shortage %><%= item.unit %></span><% } %></p><% if(item.check?.checkedAt){ %><small>最終チェック：<%= new Date(item.check.checkedAt).toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}) %> ／ <%= item.check.checkedBy?.displayname || item.check.checkedBy?.username || '退会済みの会員' %></small><% } %></div></div><form class="form-stack" action="<%= base %>/inventory/<%= item._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="period" value="<%= period %>"><input type="hidden" name="place" value="<%= item.place %>"><div class="equipment-form-grid"><label>棚卸数量<input type="number" name="count" value="<%= item.check?.count ?? item.quantity %>" min="0" max="1000000" step="any" required></label><label>コメント<input name="comment" value="<%= item.check?.comment || '' %>" maxlength="1000"></label></div><label class="announcement-option"><input type="checkbox" name="checked" <%= item.check?.checked ? 'checked' : '' %>><span>チェック済み</span></label><button class="button button-quiet button-small">記録を保存</button></form></article>
