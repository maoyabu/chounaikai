<% if (announcement.attachments?.length) { %>
  <section class="announcement-attachments" data-announcement-attachments>
    <h2>添付ファイル</h2>
    <% const images = announcement.attachments.filter(file => /^image\//i.test(file.mimeType || '') || (!file.mimeType && file.resourceType === 'image')); const documents = announcement.attachments.filter(file => !images.includes(file)); %>
    <% if (images.length) { %><div class="announcement-image-carousel" data-image-carousel>
      <div class="announcement-image-track" data-image-track tabindex="0" role="region" aria-label="添付画像（左右にスライド）">
      <% images.forEach(file => { %>
        <figure class="announcement-image">
          <button type="button" class="announcement-image-trigger" data-announcement-image aria-label="<%= file.originalName %>を拡大表示" aria-haspopup="dialog">
            <img src="<%= file.url %>" alt="<%= file.originalName %>" loading="lazy">
          </button>
          <figcaption><%= file.originalName %></figcaption>
        </figure>
      <% }) %>
      </div>
      <% if (images.length > 1) { %><div class="announcement-image-navigation"><button type="button" class="button button-quiet button-small" data-image-previous aria-label="前の画像">‹</button><span data-image-position aria-live="polite">1 / <%= images.length %></span><button type="button" class="button button-quiet button-small" data-image-next aria-label="次の画像">›</button></div><% } %>
    </div><% } %>
    <% documents.forEach(file => { %>
        <p><a href="<%= file.url %>" target="_blank" rel="noopener"><%= file.originalName %></a></p>
    <% }) %>
    <dialog class="announcement-image-dialog" aria-label="添付画像の拡大表示">
      <div class="announcement-image-dialog-heading"><strong data-image-caption></strong><button type="button" class="dialog-close" data-close-image aria-label="閉じる">×</button></div>
      <img data-expanded-image alt="">
    </dialog>
  </section>
  <script>(() => {
    document.querySelectorAll('[data-announcement-attachments]').forEach(section => {
      if (section.dataset.imageViewerReady) return;
      section.dataset.imageViewerReady = '1';
      const dialog = section.querySelector('dialog');
      const expanded = dialog.querySelector('[data-expanded-image]');
      const caption = dialog.querySelector('[data-image-caption]');
      section.querySelectorAll('[data-announcement-image]').forEach(button => button.addEventListener('click', () => {
        const image = button.querySelector('img');
        expanded.src = image.src;
        expanded.alt = image.alt;
        caption.textContent = image.alt;
        dialog.showModal();
      }));
      dialog.querySelector('[data-close-image]').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', event => {
        const bounds = dialog.getBoundingClientRect();
        if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
      });
      dialog.addEventListener('close', () => { expanded.removeAttribute('src'); });
    });
  })();</script>
<% } %>
<script>(() => {
  document.querySelectorAll('[data-image-carousel]').forEach(carousel => {
    if (carousel.dataset.ready) return;
    carousel.dataset.ready = '1';
    const track = carousel.querySelector('[data-image-track]');
    const slides = [...track.querySelectorAll('.announcement-image')];
    const previous = carousel.querySelector('[data-image-previous]');
    const next = carousel.querySelector('[data-image-next]');
    if (!previous || !next) return;
    const position = carousel.querySelector('[data-image-position]');
    const index = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1))));
    const update = () => { const current = index(); position.textContent = `${current + 1} / ${slides.length}`; previous.disabled = current === 0; next.disabled = current === slides.length - 1; };
    const move = step => track.scrollTo({ left: Math.max(0, Math.min(slides.length - 1, index() + step)) * track.clientWidth, behavior: 'smooth' });
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', event => { if (event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return; event.preventDefault(); move(event.key === 'ArrowLeft' ? -1 : 1); });
    update();
  });
})();</script>
