<div class="support-accordion">
  <% items.forEach(item => { %>
  <details class="support-qa" name="support-questions">
    <summary><span><%= item.question %></span><span class="support-chevron" aria-hidden="true"></span></summary>
    <div class="support-answer">
      <% const images = item.images || []; if (images[0] && images[0].url) { %>
      <div class="faq-images"><button class="faq-image-trigger faq-image-<%= ['large', 'medium', 'small'].includes(images[0].size) ? images[0].size : 'large' %>" type="button" aria-label="回答の画像1を拡大"><img src="<%= images[0].url %>" alt="回答の画像1" loading="lazy"></button></div>
      <% } %>
      <div class="faq-answer-content"><% if (typeof item.answerHtml === 'string') { %><%- item.answerHtml %><% } else { %><p><%= item.answer %></p><% } %></div>
      <div class="faq-images"><% images.slice(1, 3).forEach((image, index) => { if (image && image.url) { %><button class="faq-image-trigger faq-image-<%= ['large', 'medium', 'small'].includes(image.size) ? image.size : 'large' %>" type="button" aria-label="回答の画像<%= index + 2 %>を拡大"><img src="<%= image.url %>" alt="回答の画像<%= index + 2 %>" loading="lazy"></button><% } }); %></div>
      <% if (item.relatedUrl) { %><a href="<%= item.relatedUrl %>" target="_blank" rel="noopener noreferrer">詳しくはこちら<span class="sr-only">（新しいタブで開く）</span></a><% } %>
    </div>
  </details>
  <% }) %>
</div>
<% if (!items.length) { %><p class="support-empty" role="status"><%= typeof category !== 'undefined' && category ? '該当するカテゴリーのQ&Aはありません。' : '公開中のQ&Aはありません。' %></p><% } %>

<dialog class="faq-image-dialog" aria-label="回答画像の拡大表示">
  <button class="faq-image-close" type="button" aria-label="拡大画像を閉じる" autofocus>閉じる ×</button>
  <img alt="">
</dialog>
