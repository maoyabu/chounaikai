<% if (reports.length) { const points = reports.map(report => ({ id: String(report._id), latitude: report.latitude, longitude: report.longitude, address: report.locationSource === 'address' ? report.address : null, title: report.title, url: `/associations/${association._id}/dangers/${report._id}` })); %>
<p>写真をタップすると、対応する場所のピンを強調して表示します。住所から検索したピンは大まかな場所です。</p>
<p id="danger-map-status" role="status"><%= mapsKey ? '地図を読み込んでいます…' : 'Googleマップの複数地点表示には地図の接続設定が必要です。現在は選択した場所を表示します。' %></p>
<% if (mapsKey) { %>
<div id="danger-history-map" class="danger-map" data-points="<%= JSON.stringify(points) %>"></div>
<script src="/assets/danger-map.js?v=<%= assetVersion %>"></script>
<script src="https://maps.googleapis.com/maps/api/js?key=<%= encodeURIComponent(mapsKey) %>&amp;callback=initDangerMap" onerror="window.dangerMapFailed()" referrerpolicy="strict-origin-when-cross-origin" async defer></script>
<% } else { %>
<iframe id="danger-history-frame" class="danger-map" title="緊急・危険情報のGoogleマップ" src="https://www.google.com/maps?q=<%= encodeURIComponent(points[0].address || `${points[0].latitude},${points[0].longitude}`) %>&amp;output=embed" referrerpolicy="no-referrer-when-downgrade"></iframe>
<% } %>
<p>このページの投稿（最大50件）を表示しています。</p>
<div class="danger-history-list"><% reports.forEach((report, index) => { %>
<article class="danger-history-item" data-danger-report="<%= report._id %>">
  <button type="button" class="danger-history-photo" data-danger-focus="<%= report._id %>" data-danger-query="<%= points[index].address || `${points[index].latitude},${points[index].longitude}` %>" aria-label="<%= report.title %>の場所を地図で表示" aria-pressed="false"><img src="/associations/<%= association._id %>/dangers/<%= report._id %>/photo" alt="<%= report.title %>の現場写真" loading="lazy"></button>
  <div class="danger-history-description"><a href="<%= points[index].url %>"><strong><%= report.title %></strong></a><p><time datetime="<%= report.createdAt.toISOString() %>"><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></time> · <%= report.author?.displayname || '退会した住人' %></p><% if (points[index].address) { %><p><%= report.address %>（大まかな場所）</p><% } %></div>
</article>
<% }) %></div>
<% } else { %><p>緊急・危険情報の投稿はありません。</p><% } %>
