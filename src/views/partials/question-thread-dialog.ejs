<dialog class="question-dialog" id="question-dialog-<%= mode %>-<%= thread._id %>" aria-labelledby="question-title-<%= mode %>-<%= thread._id %>">
  <div class="dialog-heading"><div><p class="eyebrow"><%= association.name %> ・ <%= thread.districtGroup?.name || '班未設定' %></p><h3 id="question-title-<%= mode %>-<%= thread._id %>"><%= thread.title %></h3><small>投稿者：<%= thread.author?.displayname || thread.author?.username || '退会済みの住人' %> ・ <%= new Date(thread.createdAt).toLocaleString('ja-JP') %></small></div><button type="button" class="dialog-close" data-close-question aria-label="閉じる">×</button></div>
  <div class="question-messages"><% thread.messages.forEach((message) => { %>
    <article class="question-message <%= message.kind === 'officer' ? 'from-officer' : 'from-resident' %> <%= (mode === 'resident' && message.kind === 'resident') || (mode === 'officer' && message.kind === 'officer') ? 'question-message-own' : 'question-message-other' %>"><div class="question-message-meta"><strong><%= message.kind === 'officer' ? '役員' : '住人' %>：<%= message.sender?.displayname || message.sender?.username || '退会済みの利用者' %></strong><time><%= new Date(message.createdAt).toLocaleString('ja-JP') %></time></div><p><%= message.body %></p></article>
  <% }) %></div>
  <% if ((mode === 'officer' && thread.status === 'unanswered') || (mode === 'resident' && thread.status === 'answered')) { %>
    <form class="form-stack question-reply" action="/associations/<%= association._id %>/questions/<%= thread._id %>/messages" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><%= mode === 'officer' ? '回答' : '返信・再質問' %><textarea name="body" rows="5" maxlength="3000" required></textarea></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-question>閉じる</button><button class="button button-primary" type="submit"><%= mode === 'officer' ? '回答を送信' : '返信・再質問を送信' %></button></div></form>
  <% } else if (['no_reply', 'completed'].includes(thread.status)) { %><p class="help-text">質問者が「<%= thread.status === 'no_reply' ? '返信不要' : '完了' %>」として、このやり取りを終了しました。</p>
  <% } else { %><p class="help-text"><%= mode === 'officer' ? '住人からの返信を待っています。' : '役員からの回答を待っています。' %></p><% } %>
  <% if (mode === 'resident' && ['unanswered', 'answered'].includes(thread.status)) { %><form class="question-close-form" action="/associations/<%= association._id %>/questions/<%= thread._id %>/close" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="help-text">やり取りを終了すると、返信・再質問はできなくなります。</p><div class="form-actions"><button class="button button-quiet" type="submit" name="resolution" value="no_reply">返信不要で終了</button><button class="button button-quiet" type="submit" name="resolution" value="completed">完了にする</button></div></form><% } %>
</dialog>
