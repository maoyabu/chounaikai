<% if (memberships.length) { %>
<div class="hazard-map-actions">
  <% memberships.forEach(item => { const association = item.association; const active = Number.isInteger(association.alertLevel) && association.alertLevel >= 1 && association.alertLevel <= 5; %>
  <a class="button disaster-home-button <%= active ? 'alert-level-color-' + association.alertLevel : 'disaster-home-normal' %>" href="/associations/<%= association._id %>/disaster" aria-label="<%= association.name %>の防災情報<%= active ? '：警戒レベル' + association.alertLevel + '・' + (item.safetyState?.complete ? '安否登録完了' : '安否登録') : '' %>">
    <% if (memberships.length > 1) { %><small><%= association.name %></small><% } %><span><%= active ? '警戒レベル' + association.alertLevel + '・' + (item.safetyState?.complete ? '安否登録完了' : '安否登録') : '防災情報' %></span>
  </a>
  <% }) %>
</div>
<% } %>
