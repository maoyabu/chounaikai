<% const hazardMemberships = memberships.filter(item => /^https?:\/\//i.test(item.association.hazardMapUrl || '') || (Number.isInteger(item.association.alertLevel) && item.association.alertLevel >= 1 && item.association.alertLevel <= 5) || (item.association.alertLevel === 0 && item.association.alertLevelUpdatedAt)); if (hazardMemberships.length) { %>
<div class="hazard-map-actions">
  <% hazardMemberships.forEach(item => { const association = item.association; %><div class="hazard-association-actions" role="group" aria-label="<%= association.name %>の防災情報">
    <% if (Number.isInteger(association.alertLevel) && association.alertLevel >= 1 && association.alertLevel <= 5) { %><button type="button" class="button alert-level-button alert-level-color-<%= association.alertLevel %>" data-alert-open="alert-guide-<%= association._id %>" aria-haspopup="dialog" aria-controls="alert-guide-<%= association._id %>" aria-label="<%= association.name %>の警戒レベル<%= association.alertLevel %>の説明を表示">警戒レベル<%= association.alertLevel %></button><a class="button safety-register-button <%= item.safetyState?.complete ? 'safety-register-complete' : '' %>" href="/associations/<%= association._id %>/safety" aria-label="<%= association.name %>の安否登録<%= item.safetyState?.complete ? '（全員登録完了）' : '' %>"><%= item.safetyState?.complete ? '安否登録完了' : '安否登録' %></a><% } else { %><span class="button alert-level-none" role="status" aria-label="<%= association.name %>：警戒情報なし">警戒情報なし</span><% } %>
    <% if (/^https?:\/\//i.test(association.hazardMapUrl || '')) { %><a class="button hazard-map-button" href="<%= association.hazardMapUrl %>" target="_blank" rel="noopener noreferrer" aria-label="<%= association.name %>のハザードマップ（別タブで開く）" title="<%= association.name %>のハザードマップ（別タブで開く）">ハザードマップ</a><% } %>
  </div><% }) %>
</div>
<% } %>
