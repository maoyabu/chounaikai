<% if (typeof goodPlaces !== 'undefined' && goodPlaces.length) { %>
<details open class="content-card good-place-gallery directory-gallery-accordion" data-directory-photo-gallery>
  <summary class="section-heading good-place-gallery-link"><span class="directory-gallery-title"><h2>わがまちのいいところ</h2></span><span class="directory-gallery-chevron" aria-hidden="true">⌄</span></summary>
  <div class="directory-photo-viewport"><div class="directory-photo-track">
    <% goodPlaces.forEach((report, index) => { %>
    <a class="directory-photo-card" href="/associations/<%= report.association._id %>/good-places/<%= report._id %>" <%= index >= 3 ? 'hidden' : '' %>>
      <img src="/associations/<%= report.association._id %>/good-places/<%= report._id %>/photo" alt="<%= report.title %>" loading="lazy">
      <span class="directory-photo-likes" aria-label="ライク <%= report.likeCount || 0 %>件"><span aria-hidden="true">♥</span> <%= report.likeCount || 0 %></span>
      <div class="directory-photo-caption"><strong><%= report.title %></strong><small><%= report.association.name %></small></div>
    </a>
    <% }) %>
  </div></div>
</details>
<script src="/assets/directory-photo-gallery.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
<% } %>
