<details class="content-card finance-payment-settings"><summary>支払い方法の管理</summary><form id="finance-payment-form" action="/associations/<%= association._id %>/finance/settings" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalStartMonth" value="<%= association.financeFiscalStartMonth || 4 %>"><div class="finance-payment-table"><div class="finance-payment-header"><span></span><span>表示順</span><span>支払い方法名</span><span>有効</span><span>操作</span></div><div id="finance-payment-rows"><% paymentMethods.forEach((method, index) => { %><div class="finance-payment-row" draggable="true"><span class="finance-drag-handle">☷</span><span class="finance-payment-order"><%= index + 1 %></span><input name="paymentName" value="<%= method.name %>"><label><input type="checkbox" name="paymentActive" value="<%= index %>" <%= method.active !== false ? 'checked' : '' %>> 有効</label><button type="button" class="button button-danger-outline finance-remove-payment">削除</button></div><% }) %></div></div><button type="button" class="button button-quiet finance-add-payment">＋支払い方法を追加</button><div class="form-actions"><button class="button button-primary">支払い方法を保存</button></div></form></details><script>(()=>{const rows=document.getElementById('finance-payment-rows'),add=document.querySelector('.finance-add-payment');if(!rows||!add)return;let dragging=null;const renumber=()=>rows.querySelectorAll('.finance-payment-row').forEach((row,i)=>{row.querySelector('.finance-payment-order').textContent=i+1;row.querySelector('input[type="checkbox"]').value=i});const bind=row=>{row.addEventListener('dragstart',()=>{dragging=row;row.classList.add('is-dragging')});row.addEventListener('dragend',()=>{dragging=null;row.classList.remove('is-dragging');renumber()});row.addEventListener('dragover',event=>{event.preventDefault();if(!dragging||dragging===row)return;const box=row.getBoundingClientRect();rows.insertBefore(dragging,event.clientY<box.top+box.height/2?row:row.nextSibling)});row.querySelector('.finance-remove-payment').addEventListener('click',()=>{row.remove();renumber()})};rows.querySelectorAll('.finance-payment-row').forEach(bind);add.addEventListener('click',()=>{const row=document.createElement('div');row.className='finance-payment-row';row.draggable=true;row.innerHTML='<span class="finance-drag-handle">☷</span><span class="finance-payment-order"></span><input name="paymentName" placeholder="支払い方法名"><label><input type="checkbox" name="paymentActive"> 有効</label><button type="button" class="button button-danger-outline finance-remove-payment">削除</button>';rows.append(row);bind(row);renumber()});renumber()})();</script>
