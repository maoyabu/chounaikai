  <% if (informationLinks.length) { %><section class="content-card shelter-information-links"><h2>公共の指定避難所の情報</h2><% informationLinks.forEach(link => { %><a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.name %>（別タブ）</a><% }) %></section><% } %>
  <% if (!shelters.length) { %><section class="content-card"><p>避難所はまだ登録されていません。</p></section><% } else { %>
  <div class="shelter-display-layout"><section class="content-card shelter-selector"><h2>登録された避難所（<%= shelters.length %>件）</h2><nav aria-label="地図に表示する避難所"><% shelters.forEach(shelter => { %><a href="?<%= shelterQueryPrefix %>selected=<%= shelter._id %>#shelter-map" data-shelter-select="<%= shelter._id %>" data-shelter-address="<%= shelter.address %>" data-shelter-name="<%= shelter.name %>" <%= String(selected?._id) === String(shelter._id) ? 'aria-current=true' : '' %>><strong><%= shelter.name %></strong><small><%= shelter.address %></small></a><% }) %></nav></section>
  <section class="content-card" id="shelter-map"><h2 id="shelter-map-title"><%= selected.name %></h2><iframe class="shelter-map-frame" id="shelter-map-frame" title="選択した避難所のGoogleマップ" src="https://www.google.com/maps?q=<%= encodeURIComponent(selected.address) %>&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><p><a id="shelter-map-external" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(selected.address) %>" target="_blank" rel="noopener noreferrer">Googleマップで大きく開く（別タブ）</a></p><p id="shelter-map-status" class="help-text" role="status"><%= selected.name %>の場所を表示しています。</p>
  <% shelters.forEach(shelter => { %><article class="shelter-details" data-shelter-details="<%= shelter._id %>" <%= String(selected._id) === String(shelter._id) ? '' : 'hidden' %>><h3><%= shelter.name %></h3><dl><div><dt>住所</dt><dd><%= shelter.address %></dd></div><div><dt>電話番号</dt><dd><%= shelter.phone || '未登録' %></dd></div><div><dt>収容人数</dt><dd><%= shelter.capacity == null ? '未登録' : shelter.capacity + '人' %></dd></div><div><dt>種別</dt><dd><%= shelter.kind || '未登録' %></dd></div><div><dt>注意すべき危険箇所</dt><dd class="shelter-danger-points"><%= shelter.dangerPoints || '未登録' %></dd></div></dl><% if (shelter.photos.length) { %><div class="shelter-photo-gallery"><% shelter.photos.forEach((photo,index) => { %><a href="<%= photo.url %>" target="_blank" rel="noopener noreferrer"><img src="<%= photo.url %>" alt="<%= shelter.name %>の写真<%= index + 1 %>" loading="lazy"></a><% }) %></div><% } %></article><% }) %>
  </section></div>
  <% } %>
