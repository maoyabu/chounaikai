<section class="admin-section association-event-section" id="<%= calendarAnchor %>">
  <div class="section-heading association-event-section-heading"><h2><%= typeof calendarTitle !== 'undefined' ? calendarTitle : '町内会行事カレンダー' %></h2><nav class="association-event-navigation" aria-label="カレンダーの月を移動"><a class="calendar-nav-prev" href="<%= calendarPath %>?month=<%= calendarWindow.previousMonth %>#<%= calendarAnchor %>" aria-label="前の月へ">‹ 前月</a><form class="calendar-nav-date" action="<%= calendarPath %>#<%= calendarAnchor %>" method="get"><label><input type="month" name="month" value="<%= calendarWindow.currentMonth %>" min="1900-01" max="2200-12" aria-label="年月を選択"></label><button type="submit">移動</button></form><a class="calendar-nav-next" href="<%= calendarPath %>?month=<%= calendarWindow.nextMonth %>#<%= calendarAnchor %>" aria-label="次の月へ">次月 ›</a></nav></div>
  <% if (typeof associationName !== 'undefined' && associationName) { %><p class="association-event-association"><%= associationName %></p><% } %>
  <div class="association-event-months">
    <% months.forEach(month => { %>
      <div class="association-event-month"><h3><%= month.label %></h3><div class="association-event-days"><% ['日','月','火','水','木','金','土'].forEach(day => { %><span class="association-event-weekday"><%= day %></span><% }); %>
        <% month.cells.forEach(date => { const dayEvents = date ? events.filter(event => event.startDate <= date && event.endDate >= date) : []; %>
          <% if (date) { %><button type="button" class="association-event-day <%= dayEvents.length ? 'has-event' : '' %>" title="<%= dayEvents.map(event => event.title).join('、') %>" data-calendar-events="<%= encodeURIComponent(JSON.stringify(dayEvents.map(event => ({ title: event.title, category: event.category, startDate: event.startDate, endDate: event.endDate, startTime: event.startTime, endTime: event.endTime })))) %>"><span><%= Number(date.slice(-2)) %></span><span class="association-event-dots"><% dayEvents.slice(0, 3).forEach(event => { %><i style="background-color:<%= event.color %>"></i><% }); %></span></button><% } else { %><span class="association-event-day is-empty"></span><% } %>
        <% }); %>
      </div></div>
    <% }); %>
  </div>
  <div class="association-event-list"><h3>行事一覧</h3>
    <% if (!events.length) { %><p>この３ヶ月に表示する行事はありません。</p><% } %>
    <% const weekdayNames = ['日','月','火','水','木','金','土']; const repeatText = event => { const r = event.recurrence || {}; if (!r.frequency || r.frequency === 'none') return ''; if (r.frequency === 'weekly') return '毎週 ' + (r.weekdays || []).map(day => weekdayNames[day]).join('・'); if (r.frequency === 'monthly') return '毎月 ' + (r.monthDays || []).join('・'); if (r.frequency === 'yearly') return '毎年 ' + r.yearMonth + '月' + r.yearDay + '日'; return '毎日'; }; const listedEvents = events.filter((event, index, list) => list.findIndex(item => String(item._id) === String(event._id)) === index); listedEvents.forEach(event => { %><button type="button" class="association-event-list-item" data-event-dialog="event-<%= event._id %>"><span class="association-event-color" style="background-color:<%= event.color %>"></span><span><% if (repeatText(event)) { %><em class="event-recurrence-tag"><%= repeatText(event) %></em><% } %><small><%= event.startDate %><%= event.endDate !== event.startDate ? ` 〜 ${event.endDate}` : '' %>・<%= event.category %></small><strong><%= event.title %></strong></span><% if (event.completed) { %><span class="status-badge">完了</span><% } %><span aria-hidden="true">›</span></button>
      <dialog class="association-event-dialog" id="event-<%= event._id %>"><div class="dialog-heading"><h3><%= event.title %></h3><button type="button" class="dialog-close" data-event-close aria-label="閉じる">×</button></div><p><span class="association-event-color" style="background-color:<%= event.color %>"></span> <%= event.category %> <% if (event.completed) { %><span class="status-badge">完了</span><% } %></p><p><strong>日時：</strong><%= event.startDate %> <%= event.startTime %> ～ <%= event.endDate !== event.startDate ? `${event.endDate} ` : '' %><%= event.endTime %></p><p class="association-event-body"><%= event.body %></p><% if (event.image?.url) { %><figure class="association-event-media"><img src="<%= event.image.url %>" alt="<%= event.imageCaption || '' %>"><% if (event.imageCaption) { %><figcaption><%= event.imageCaption %></figcaption><% } %></figure><% } %><% if (event.youtubeUrl) { const yt = event.youtubeUrl.match(/(?:youtu\.be\/|v=)([\w-]{11})/); if (yt) { %><div class="association-event-video"><iframe src="https://www.youtube.com/embed/<%= yt[1] %>" title="YouTube動画" allowfullscreen></iframe></div><% } } %><% if (event.qrUrl) { %><div class="association-event-qr"><img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=<%= encodeURIComponent(event.qrUrl) %>" alt="QRコード"><span><%= event.qrCaption || '' %></span></div><% } %><div class="form-actions"><button type="button" class="button button-quiet" data-event-close>閉じる</button></div></dialog>
    <% }); %>
  </div>
</section>
<script>
  if (!window.associationEventDialogsReady) {
    window.associationEventDialogsReady = true;
    document.addEventListener('click', event => {
      const opener = event.target.closest('[data-event-dialog]');
      if (opener) document.getElementById(opener.dataset.eventDialog)?.showModal();
      if (event.target.closest('[data-event-close]')) event.target.closest('dialog')?.close();
    });
  }
</script>
<script>(() => { document.querySelectorAll('[data-calendar-events]').forEach(day => day.addEventListener('click', event => { event.stopPropagation(); document.querySelectorAll('.calendar-event-popover').forEach(item => item.remove()); const items = JSON.parse(decodeURIComponent(day.dataset.calendarEvents || '%5B%5D')); if (!items.length) return; const popover = document.createElement('div'); popover.className = 'calendar-event-popover'; popover.innerHTML = items.map(item => '<strong></strong><small></small>').join(''); items.forEach((item, index) => { const strong = popover.querySelectorAll('strong')[index], small = popover.querySelectorAll('small')[index]; strong.textContent = item.title; small.textContent = [item.category, item.startDate + (item.endDate !== item.startDate ? '〜' + item.endDate : ''), item.startTime + '〜' + item.endTime].filter(Boolean).join('・'); }); document.body.append(popover); const rect = day.getBoundingClientRect(); popover.style.left = Math.min(rect.left, window.innerWidth - popover.offsetWidth - 12) + 'px'; popover.style.top = (rect.bottom + 8) + 'px'; })); document.addEventListener('click', () => document.querySelectorAll('.calendar-event-popover').forEach(item => item.remove())); })();</script>
