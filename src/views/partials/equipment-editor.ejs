<form class="form-stack equipment-editor-form" action="<%= base %><%= item._id ? `/${item._id}/edit` : '' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="equipment-editor-panel"><% if (item._id) { %><div class="equipment-editor-target">対象：<%= item.name %><% if (item.disasterCategory) { %> <small><%= item.disasterCategory %></small><% } %></div><% } %><div class="equipment-form-grid"><label>備品名<input name="name" value="<%= item.name || '' %>" maxlength="120" required></label><label>備品名補足（任意）<input name="note" value="<%= item.note || '' %>" maxlength="500"></label>
<% [['place','保管場所',100],['unit','単位',20],['stockCategory','ストック分類',100],['disasterCategory','防災分類',100]].forEach(([key,label,max])=>{ %><label><%= label %>（選択または新規入力）<input name="<%= key %>" list="equipment-<%= key %>" value="<%= item[key] || '' %>" maxlength="<%= max %>" <%= ['place','unit'].includes(key) ? 'required' : '' %>><datalist id="equipment-<%= key %>"><% choices[key].forEach(value=>{ %><option value="<%= value %>"><% }) %></datalist></label><% }) %>
<label>数量<input type="number" name="quantity" value="<%= item.quantity %>" min="0" max="1000000" step="any" required></label><label>必要数量（不足分の計算に使用）<input type="number" name="minimumQuantity" value="<%= item.minimumQuantity || 0 %>" min="0" max="1000000" step="any" required></label>
<label>商品URL<input type="url" name="productUrl" value="<%= item.productUrl || '' %>" maxlength="2000"></label><label>商品画像URL<input type="url" name="productImageUrl" value="<%= item.productImageUrl || '' %>" maxlength="2000"><img class="equipment-editor-preview" data-equipment-image-preview <% if (item.productImageUrl) { %>src="<%= item.productImageUrl %>"<% } %> alt="商品画像プレビュー" <%= item.productImageUrl ? '' : 'hidden' %>></label>
<label>賞味・消費期限<input type="date" name="expiryDate" value="<%= item.expiryDate || '' %>"></label><label>メンテナンス内容<textarea name="maintenance" rows="3" maxlength="1000"><%= item.maintenance || '' %></textarea></label></div>
<div class="equipment-toolbar"><% [['isConsumable','消耗品'],['tracked','棚卸し対象'],['wishlist','ウィッシュリスト（購入希望）'],['lendable','貸出可能']].forEach(([key,label])=>{ %><label class="announcement-option"><input type="checkbox" name="<%= key %>" <%= item[key] && !(item.wishlist && ['tracked', 'lendable'].includes(key)) ? 'checked' : '' %> <%= item.wishlist && ['tracked', 'lendable'].includes(key) ? 'disabled' : '' %>><span><%= label %></span></label><% }) %></div>
<div class="equipment-form-grid"><label>貸出可能期間：開始（任意）<input type="date" name="availableFrom" value="<%= item.availableFrom || '' %>"></label><label>貸出可能期間：終了（任意）<input type="date" name="availableUntil" value="<%= item.availableUntil || '' %>"></label></div>
<p class="help-text">期限が異なる在庫は別の備品として登録してください。貸出可能な備品の数量は整数で登録します。</p></div><p class="alert alert-error" data-equipment-editor-error role="alert" hidden></p><div class="form-actions equipment-editor-footer"><% if (modal) { %><button type="button" class="button button-quiet" data-close-equipment-dialog>キャンセル</button><% } else { %><a class="button button-quiet" href="<%= base %>">キャンセル</a><% } %><button class="button button-primary" type="submit">保存</button></div>
</form>
