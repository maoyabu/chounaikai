<section class="content-card join-benefits"><h2>町内会に参加するメリット</h2>
<% if (association.joinBenefits?.length) { %><div class="join-benefit-grid bulletin-benefit-grid"><% association.joinBenefits.forEach(benefit => { %><article class="bulletin-benefit-card benefit-color-<%= benefit.color || 'green' %>"><h3><span class="join-benefit-icon-wrap"><%- include('join-benefit-icon', { icon: benefit.icon || 'town' }) %></span><span><%= benefit.title %></span></h3><p class="body-copy join-benefit-content"><%= benefit.content %></p></article><% }) %></div><% } else { %><p>参加するメリットのご案内は準備中です。</p><% } %></section>
<section class="content-card join-benefits"><h2>まちの伝言板を利用するメリット</h2><div class="join-benefit-grid bulletin-benefit-grid">
<% const benefits = [
['災害時に住民を守る', ['災害発生時の避難経路、避難所の状況をタイムリーに共有','安否状況、要支援の共有と支援活動','ハザードマップをいつでも確認できる','防災時の備品管理や賞味期限管理','町内の危険情報を共有し修繕']],
['まちの情報がここにある', ['ゴミ出しのルールやスケジュールを確認','町内会が企画して、実施されるイベントの情報を知ることができる','町内会にあるクラブ活動を知り、参加することもできる','町内会費の使途などを把握してより良いまちづくりに活かしていく']],
['必要な情報がすぐ届く', ['回覧板や緊急情報がすぐ手元に届き、いつでも見返せる','天候によりイベントの実行、中止連絡','町内会館などの設備の空き状況が分かり、その場で予約ができる']],
['防犯・見守りをみんなで', ['不審者情報の共有','散歩しながら町内の見回り情報を共有','行方不明者やペットの行方不明情報などの共有や発見情報の共有','詐欺情報の共有','町内の危険情報を共有し修繕']],
['みんなの力でより良いまちに', ['まちをよくするアイディアを町内会に提案できる','まちのいいところ発信でまちのいいを共有','お困りごとを集約し、市や区などに意見提案する窓口に']],
['手間の削減', ['町内会費徴収の手間','回覧板の作成、回収の手間','イベント参加など様々な集計作業の軽減']],
['スピーディーに', ['災害情報、防犯、見守り情報の共有','イベント開催、中止連絡']],
['参加しやすく', ['町内会への参加','町内会の行事やイベントへの参加','クラブ活動への参加']]

]; const styles = [['shield', 'red'], ['info', 'green'], ['bell', 'green'], ['eye', 'blue'], ['town', 'orange'], ['check', 'brown'], ['bolt', 'green'], ['people', 'blue']];
benefits.slice(0, 5).forEach(([title, items], index) => { const [icon, color] = styles[index]; %>
<article class="bulletin-benefit-card benefit-color-<%= color %>"><h3><span class="join-benefit-icon-wrap"><%- include('join-benefit-icon', { icon }) %></span><span><%= title %></span></h3><ul><% items.forEach(item => { %><li><%= item %></li><% }) %></ul></article><% }) %>
</div>
<section class="bulletin-outcomes" aria-label="まちの伝言板で変わる日々の活動"><p class="bulletin-outcomes-label">日々の活動を、もっと便利に</p><div class="bulletin-outcome-grid">
<% benefits.slice(5).forEach(([title, items], index) => { const [icon, color] = styles[index + 5]; %>
<article class="bulletin-outcome-card benefit-color-<%= color %>"><h3><%- include('join-benefit-icon', { icon }) %><span><%= title %></span></h3><ul><% items.forEach(item => { %><li><%= item %></li><% }) %></ul></article><% }) %>
</div></section></section>
