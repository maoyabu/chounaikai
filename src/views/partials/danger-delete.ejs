<% if (canDelete) { %>
<form class="danger-delete-form" action="/associations/<%= association._id %>/dangers/<%= report._id %>/delete" method="post" onsubmit="return confirm('この緊急・危険情報を削除しますか？削除すると元に戻せません。');">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="button button-danger-outline" type="submit">この緊急・危険情報を削除する</button>
</form>
<% } %>
