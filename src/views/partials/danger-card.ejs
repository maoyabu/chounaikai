<a class="danger-card" href="/associations/<%= report.association %>/dangers/<%= report._id %>"><img src="/associations/<%= report.association %>/dangers/<%= report._id %>/photo" alt="投稿された現場の写真" loading="lazy"><span><strong><%= report.title %></strong><small><time datetime="<%= report.createdAt.toISOString() %>"><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></time> · <%= report.author?.displayname || '退会した住人' %></small></span></a>