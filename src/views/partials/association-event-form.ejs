<form class="form-stack association-event-form" action="<%= action %>" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>行事タイトル<input name="title" value="<%= event?.title || '' %>" maxlength="120" required></label><label>行事内容<textarea name="body" rows="4" maxlength="5000" required><%= event?.body || '' %></textarea></label><div class="form-columns"><label>開始年月日<input type="date" name="startDate" value="<%= event?.startDate || '' %>" required></label><label>終了年月日<input type="date" name="endDate" value="<%= event?.endDate || '' %>"></label></div><div class="form-columns"><label>開始時間<input type="time" name="startTime" value="<%= event?.startTime || '' %>" required></label><label>終了時間<input type="time" name="endTime" value="<%= event?.endTime || '' %>" required></label></div><div class="form-columns"><label>行事分類<input name="category" list="event-categories" value="<%= event?.category || '' %>" required></label><label>分類カラー<input type="color" name="color" value="<%= event?.color || '#287b68' %>" required></label></div><label>画像<input type="file" name="eventImage" accept="image/*"><% if (event?.image?.url) { %><img class="event-edit-image" src="<%= event.image.url %>" alt="現在の画像"><% } %></label><label>画像キャプション<input name="imageCaption" value="<%= event?.imageCaption || '' %>" maxlength="200"></label><label>YouTube URL<input type="url" name="youtubeUrl" value="<%= event?.youtubeUrl || '' %>"></label><label>QRコードURL<input type="url" name="qrUrl" value="<%= event?.qrUrl || '' %>"></label><label>QRコードキャプション<input name="qrCaption" value="<%= event?.qrCaption || '' %>" maxlength="200"></label><div class="association-event-flags"><label><input type="checkbox" name="visible" <%= event?.visible !== false ? 'checked' : '' %>> 表示する</label><label><input type="checkbox" name="open" <%= event?.open ? 'checked' : '' %>> 公開ページにも表示する</label></div><div class="form-actions"><button class="button button-primary"><%= event ? '変更を保存' : '行事を登録' %></button></div></form>
