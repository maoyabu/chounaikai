<form class="form-stack association-event-form" action="<%= action %>" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>行事タイトル<input name="title" value="<%= event?.title || '' %>" maxlength="120" required></label><label>行事内容<textarea name="body" rows="4" maxlength="5000" required><%= event?.body || '' %></textarea></label><label class="event-toggle event-inline-toggle"><input type="checkbox" name="allDay" id="event-all-day" <%= event?.allDay ? 'checked' : '' %>><span></span>終日のイベントとして登録</label><div class="event-datetime-panel"><div class="event-start-row"><div class="form-columns event-start-fields"><label>開始日<input type="date" name="startDate" value="<%= event?.startDate || '' %>" required></label><label class="event-start-time-field">開始時間<input type="time" name="startTime" value="<%= event?.startTime || '09:00' %>" required></label></div></div><div class="event-end-row"><label class="event-toggle event-inline-toggle"><input type="checkbox" name="hasEndDate" id="event-has-end-date" <%= event?.hasEndDate !== false ? 'checked' : '' %>><span></span>終了日を指定</label><div class="form-columns event-end-fields"><label>終了日<input type="date" name="endDate" value="<%= event?.endDate || '' %>"></label><label>終了時間<input type="time" name="endTime" value="<%= event?.endTime || '10:00' %>"></label></div></div></div><fieldset class="event-recurrence-fieldset"><legend>繰り返し設定</legend><select name="recurrenceFrequency" id="event-recurrence"><option value="none">繰り返さない</option><option value="daily" <%= event?.recurrence?.frequency === 'daily' ? 'selected' : '' %>>毎日</option><option value="weekly" <%= event?.recurrence?.frequency === 'weekly' ? 'selected' : '' %>>毎週</option><option value="monthly" <%= event?.recurrence?.frequency === 'monthly' ? 'selected' : '' %>>毎月</option><option value="yearly" <%= event?.recurrence?.frequency === 'yearly' ? 'selected' : '' %>>毎年</option></select><div class="event-recurrence-options" data-frequency="weekly"><p>曜日を複数選択</p><% [['日',0],['月',1],['火',2],['水',3],['木',4],['金',5],['土',6]].forEach(([label,value]) => { %><label class="event-weekday-toggle"><input type="checkbox" name="weekdays" value="<%= value %>" <%= event?.recurrence?.weekdays?.includes(value) ? 'checked' : '' %>><span><%= label %></span></label><% }) %></div><div class="event-recurrence-options" data-frequency="monthly"><label>日付（カンマ区切り）<input name="monthDays" value="<%= event?.recurrence?.monthDays?.join(',') || '' %>" placeholder="例：1,15,29"></label></div><div class="event-recurrence-options" data-frequency="yearly"><div class="form-columns"><label>月<input type="number" name="yearMonth" min="1" max="12" value="<%= event?.recurrence?.yearMonth || '' %>"></label><label>日<input type="number" name="yearDay" min="1" max="31" value="<%= event?.recurrence?.yearDay || '' %>"></label></div></div><label>繰り返し終了日<input type="date" name="recurrenceUntil" value="<%= event?.recurrence?.until || '' %>"></label></fieldset><div class="form-columns"><fieldset class="event-category-fieldset"><legend>行事分類</legend><label>分類名<input name="category" value="<%= event?.category || '' %>" required></label><div class="event-category-tags"><% (categories || []).forEach(category => { %><button type="button" class="event-category-tag" data-event-category="<%= category %>"><%= category %></button><% }) %></div></fieldset><fieldset class="event-color-fieldset"><legend>分類カラー</legend><div class="event-color-palette"><button type="button" class="event-color-swatch" data-event-color="#176b4d" style="background:#176b4d" aria-label="#176b4d"></button><button type="button" class="event-color-swatch" data-event-color="#287b68" style="background:#287b68" aria-label="#287b68"></button><button type="button" class="event-color-swatch" data-event-color="#0f766e" style="background:#0f766e" aria-label="#0f766e"></button><button type="button" class="event-color-swatch" data-event-color="#2563eb" style="background:#2563eb" aria-label="#2563eb"></button><button type="button" class="event-color-swatch" data-event-color="#4f46e5" style="background:#4f46e5" aria-label="#4f46e5"></button><button type="button" class="event-color-swatch" data-event-color="#7c3aed" style="background:#7c3aed" aria-label="#7c3aed"></button><button type="button" class="event-color-swatch" data-event-color="#9333ea" style="background:#9333ea" aria-label="#9333ea"></button><button type="button" class="event-color-swatch" data-event-color="#c026d3" style="background:#c026d3" aria-label="#c026d3"></button><button type="button" class="event-color-swatch" data-event-color="#db2777" style="background:#db2777" aria-label="#db2777"></button><button type="button" class="event-color-swatch" data-event-color="#e11d48" style="background:#e11d48" aria-label="#e11d48"></button><button type="button" class="event-color-swatch" data-event-color="#dc2626" style="background:#dc2626" aria-label="#dc2626"></button><button type="button" class="event-color-swatch" data-event-color="#ea580c" style="background:#ea580c" aria-label="#ea580c"></button><button type="button" class="event-color-swatch" data-event-color="#d97706" style="background:#d97706" aria-label="#d97706"></button><button type="button" class="event-color-swatch" data-event-color="#ca8a04" style="background:#ca8a04" aria-label="#ca8a04"></button><button type="button" class="event-color-swatch" data-event-color="#65a30d" style="background:#65a30d" aria-label="#65a30d"></button><button type="button" class="event-color-swatch" data-event-color="#16a34a" style="background:#16a34a" aria-label="#16a34a"></button><button type="button" class="event-color-swatch" data-event-color="#0891b2" style="background:#0891b2" aria-label="#0891b2"></button><button type="button" class="event-color-swatch" data-event-color="#475569" style="background:#475569" aria-label="#475569"></button><button type="button" class="event-color-swatch" data-event-color="#64748b" style="background:#64748b" aria-label="#64748b"></button><button type="button" class="event-color-swatch" data-event-color="#92400e" style="background:#92400e" aria-label="#92400e"></button></div><button type="button" class="button button-quiet event-color-picker-button" data-open-color-picker>カラーピッカーで選択</button><input class="event-color-picker-input" type="color" name="color" value="<%= event?.color || '#287b68' %>" required><div class="event-selected-color"><strong>現在選択中のカラー</strong><span><i></i><code><%= event?.color || '#287b68' %></code></span></div></fieldset></div><fieldset class="event-media-fieldset"><legend>画像</legend><label>画像<input type="file" name="eventImage" accept="image/*"><% if (event?.image?.url) { %><img class="event-edit-image" src="<%= event.image.url %>" alt="現在の画像"><% } %></label><label>画像キャプション<input name="imageCaption" value="<%= event?.imageCaption || '' %>" maxlength="200"></label></fieldset><label>YouTube URL<input type="url" name="youtubeUrl" value="<%= event?.youtubeUrl || '' %>"></label><fieldset class="event-media-fieldset"><legend>QRコード</legend><label>QRコード用のURL<input type="url" name="qrUrl" value="<%= event?.qrUrl || '' %>"></label><label>QRコードキャプション<input name="qrCaption" value="<%= event?.qrCaption || '' %>" maxlength="200"></label></fieldset><fieldset class="event-public-settings"><legend>公開設定</legend><label class="event-toggle"><input type="checkbox" name="visible" <%= event?.visible ? 'checked' : '' %>><span></span>公開 / 下書き</label><small>OFFの場合は下書きとして保存されます。</small><label class="event-toggle"><input type="checkbox" name="open" <%= event?.open ? 'checked' : '' %>><span></span><span class="event-public-label">町内会の住人限定 / 一般公開</span></label><small>OFFの場合は町内会の住人限定です。</small></fieldset><div class="form-actions"><button class="button button-primary"><%= event ? '変更を保存' : '行事を登録' %></button></div></form><script>(() => { const form = document.currentScript.previousElementSibling, allDay = form.querySelector('#event-all-day'), hasEnd = form.querySelector('#event-has-end-date'), endFields = form.querySelector('.event-end-fields'), recurrence = form.querySelector('#event-recurrence'); const update = () => { endFields.hidden = !hasEnd.checked; form.querySelectorAll('[name="endDate"],[name="endTime"]').forEach(input => input.disabled = !hasEnd.checked); form.querySelectorAll('.event-recurrence-options').forEach(box => box.hidden = box.dataset.frequency !== recurrence.value); const startTime = form.querySelector('[name="startTime"]'), endTime = form.querySelector('[name="endTime"]'); startTime.disabled = allDay.checked; endTime.disabled = allDay.checked || !hasEnd.checked; startTime.closest('label').hidden = allDay.checked; endTime.closest('label').hidden = allDay.checked || !hasEnd.checked; }; [allDay,hasEnd,recurrence].forEach(input => input.addEventListener('change', update)); update(); })();</script><script>(() => { const fieldset = document.currentScript.previousElementSibling?.previousElementSibling?.querySelector('.event-color-fieldset'); const input = fieldset?.querySelector('input[name="color"]'); if (!input) return; fieldset.querySelector('[data-open-color-picker]').addEventListener('click', () => input.click()); const preview = fieldset.querySelector('.event-selected-color'), sync = () => { preview.querySelector('i').style.backgroundColor = input.value; preview.querySelector('code').textContent = input.value; }; input.addEventListener('input', sync); sync(); fieldset.querySelectorAll('[data-event-color]').forEach(button => button.addEventListener('click', () => { input.value = button.dataset.eventColor; sync(); })); })();</script><script>(() => { const container = document.currentScript.parentElement; const input = container?.querySelector('input[name="category"]'); if (!input) return; container.querySelectorAll('[data-event-category]').forEach(tag => tag.addEventListener('click', () => { input.value = tag.dataset.eventCategory; })); })();</script>
