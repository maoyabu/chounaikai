<span class="finance-entry-title"><span class="finance-entry-type <%= entry.cf === '収入' ? 'finance-entry-type-income' : 'finance-entry-type-expense' %>"><%= entry.cf %></span><span class="finance-entry-group"><%= entry.cf === '支出' ? (entry.expense_department_name || entry.expense_department || '未設定') : (entry.income_category || '未設定') %></span><strong><%= entry.cf === '支出' ? entry.expense_item : entry.income_item %></strong></span>
