<form class="form-card finance-budget-form" action="/associations/<%= association._id %>/finance/settings/budgets" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="year" value="<%= year %>"><h2><select class="finance-title-year-select" aria-label="予算年度" onchange="location.href='?year='+this.value"><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { %><option value="<%= fiscal %>" <%= Number(year) === fiscal ? 'selected' : '' %>><%= fiscal %>年度</option><% } %></select>の予算設定</h2><p class="help-text">収入と支出をタブで切り替えて編集できます。行をつまんで並べ替えられます。</p><div class="finance-budget-tabs"><button type="button" class="is-active" data-budget-tab="収入">収入項目</button><button type="button" data-budget-tab="支出">支出項目</button></div><% ['収入','支出'].forEach((type) => { const typeRows = budgets.filter(item => item.cf === type); %><section class="finance-budget-section" data-budget-panel="<%= type %>"><h3><%= type %>項目</h3><div class="finance-budget-table"><div class="finance-budget-header"><span>表示順</span><span><%= type === '収入' ? '項目分類' : '部' %></span><span>項目名</span><span>予算額（年間）</span><span>操作</span></div><div class="finance-budget-rows"><% (typeRows.length ? typeRows : [{ cf: type, budget: 0 }]).forEach((item, index) => { %><div class="finance-budget-row" draggable="true"><span class="finance-drag-handle">☷</span><input class="finance-order-input" type="text" name="itemOrder" value="<%= index + 1 %>" inputmode="numeric"><input type="hidden" name="itemCf" value="<%= type %>"><% if (type === '収入') { %><input name="itemCategory" value="<%= item.income_category || '' %>" placeholder="分類"><% } else { %><select name="itemDepartment"><option value="">部を選択</option><% (departments || []).forEach(department => { %><option value="<%= department._id %>" <%= String(item.expense_department || '') === String(department._id) ? 'selected' : '' %>><%= department.name %></option><% }) %></select><input name="itemDepartmentName" value="<%= item.expense_department_name || '' %>" placeholder="部名を入力"><% } %><input name="itemName" value="<%= item.expense_item || item.income_item || '' %>" placeholder="項目名"><input class="finance-amount-input" name="itemBudget" value="<%= Number(item.budget || 0).toLocaleString('ja-JP') %>" inputmode="numeric"><button type="button" class="button button-danger-outline finance-remove-budget">削除</button></div><% }) %></div></div><button type="button" class="button button-quiet finance-add-budget">＋項目追加</button></section><% }) %><div class="form-actions"><button class="button button-primary">予算を保存</button></div></form><script>(()=>{const form=document.querySelector('.finance-budget-form'),departments=<%- JSON.stringify((departments||[]).map(d=>({_id:String(d._id),name:d.name}))) %>;const setup=section=>{const rows=section.querySelector('.finance-budget-rows'),renumber=()=>rows.querySelectorAll('.finance-budget-row').forEach((r,i)=>r.querySelector('.finance-order-input').value=i+1);let dragging=null;const bind=row=>{row.addEventListener('dragstart',()=>{dragging=row;row.classList.add('is-dragging')});row.addEventListener('dragend',()=>{dragging=null;row.classList.remove('is-dragging');renumber()});row.addEventListener('dragover',e=>{e.preventDefault();if(!dragging||dragging===row)return;const box=row.getBoundingClientRect();rows.insertBefore(dragging,e.clientY<box.top+box.height/2?row:row.nextSibling)});row.querySelector('.finance-remove-budget').addEventListener('click',()=>{row.remove();renumber()})};const add=()=>{const row=document.createElement('div');row.className='finance-budget-row';row.draggable=true;const income=section.dataset.budgetPanel==='収入';row.innerHTML='<span class="finance-drag-handle">☷</span><input class="finance-order-input" type="text" name="itemOrder" value="1" inputmode="numeric"><input type="hidden" name="itemCf" value="'+section.dataset.budgetPanel+'">'+(income?'<input name="itemCategory" placeholder="分類">':'<select name="itemDepartment"><option value="">部を選択</option>'+departments.map(d=>'<option value="'+d._id+'">'+d.name+'</option>').join('')+'</select><input name="itemDepartmentName" placeholder="部名を入力">')+'<input name="itemName" placeholder="項目名"><input class="finance-amount-input" name="itemBudget" value="0" inputmode="numeric"><button type="button" class="button button-danger-outline finance-remove-budget">削除</button>';rows.append(row);bind(row);renumber()};rows.querySelectorAll('.finance-budget-row').forEach(bind);section.querySelector('.finance-add-budget').addEventListener('click',add)};document.querySelectorAll('.finance-budget-section').forEach(setup);document.querySelectorAll('[data-budget-tab]').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('[data-budget-tab]').forEach(t=>t.classList.toggle('is-active',t===tab));document.querySelectorAll('[data-budget-panel]').forEach(p=>p.hidden=p.dataset.budgetPanel!==tab.dataset.budgetTab)}));document.querySelectorAll('[data-budget-panel]').forEach(p=>p.hidden=p.dataset.budgetPanel!=='収入');form?.addEventListener('submit',()=>document.querySelectorAll('.finance-amount-input').forEach(input=>input.value=input.value.replace(/,/g,'')))})();</script>
