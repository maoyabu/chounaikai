<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= association._id %>">← 町内会ページへ戻る</a><section class="page-heading"><div><p class="eyebrow"><%= fiscalYear %>年度</p><h1><%= association.name %>の役員</h1></div></section>
<section class="content-card"><div class="public-officer-list"><% officers.forEach((officer) => { const name = officer.displayLabel || '担当者'; %><article><% if (officer.user?.avatar) { %><img class="profile-avatar resident-avatar" src="<%= officer.user.avatar %>" alt=""><% } else { %><span class="profile-avatar resident-avatar profile-avatar-placeholder">人</span><% } %><div><small><%= officer.role?.name || '一般役員' %><% if (officer.department?.name) { %> ／ <%= officer.department.name %><% } %></small><strong><%= name %></strong><% if (officer.districtGroup) { %><span><%= officer.districtGroup.name %></span><% } %><% if (officer.address) { %><span>住所：<%= officer.address %></span><% } %><% if (officer.phone) { %><span>電話：<%= officer.phone %></span><% } %><% if (officer.mobilePhone) { %><span>携帯：<%= officer.mobilePhone %></span><% } %><% if (officer.email) { %><span>メール：<%= officer.email %></span><% } %></div></article><% }) %></div><% if (!officers.length) { %><p class="help-text">この年度の役員情報はまだ登録されていません。</p><% } %></section></main><%- include('partials/foot') %>
