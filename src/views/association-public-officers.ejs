<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= association._id %>">← 町内会ページへ戻る</a><section class="page-heading"><div><p class="eyebrow"><%= fiscalYear %>年度</p><h1><%= association.name %>の役員</h1></div></section>
<section class="content-card"><div class="public-officer-list"><% officers.forEach((officer) => { const name = officer.name || officer.user?.displayname || officer.user?.username || '氏名未登録'; %><article><% if (officer.user?.avatar) { %><img class="profile-avatar resident-avatar" src="<%= officer.user.avatar %>" alt=""><% } else { %><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%= name.charAt(0) %></span><% } %><div><small><%= officer.role?.name || '一般役員' %><% if (officer.department?.name) { %> ／ <%= officer.department.name %><% } %></small><strong><%= name %>さん</strong><span><%= officer.districtGroup?.name || '地区・班未設定' %></span><% if (officer.phone || officer.mobilePhone) { %><span><%= officer.phone || '' %>　<%= officer.mobilePhone || '' %></span><% } %><% if (officer.user) { %><small>会員：<%= officer.user.displayname || officer.user.username || officer.user.email %>（<%= officer.user.email || 'メール未登録' %>）</small><% } %></div></article><% }) %></div><% if (!officers.length) { %><p class="help-text">この年度の役員情報はまだ登録されていません。</p><% } %></section></main><%- include('partials/foot') %>
