<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell communication-theme question-box-shell">
  <a class="back-link" href="/associations/<%= association._id %>/officer">← 役員メニューへ戻る</a>
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <section class="page-heading"><h1>役員間の連絡網</h1><a class="button button-primary" href="/associations/<%= association._id %>/officer-network/new">新しい連絡を送る</a></section>
  <section class="admin-section question-home-section"><div class="section-heading"><h2>連絡メニュー</h2></div><div class="question-home-list">
    <a class="question-home-link" href="/associations/<%= association._id %>/officer-network/inbox"><span><strong>届いた役員間の連絡</strong><small>確認と回答を行う</small></span><% if (unreadReceivedCount) { %><span class="status-badge question-unread">未確認 <%= unreadReceivedCount %>件</span><% } %><span class="list-arrow" aria-hidden="true">›</span></a>
    <a class="question-home-link" href="/associations/<%= association._id %>/officer-network/groups"><span><strong>役員グループ管理</strong><small>グループを作成・編集・削除する</small></span><span class="status-badge"><%= groupCount %>件</span><span class="list-arrow" aria-hidden="true">›</span></a>
  </div></section>
  <section class="admin-section question-home-section"><div class="section-heading"><h2>送信した連絡</h2></div>
    <% if (!announcements.length) { %><div class="admin-empty"><p>送信した連絡はありません。</p></div><% } else { %><div class="question-home-list"><% announcements.forEach((item) => { %><a class="question-home-link" href="/associations/<%= association._id %>/officer-network/<%= item._id %>"><span><strong><%= item.title %></strong><small><%= new Date(item.createdAt).toLocaleString('ja-JP') %> ・ <%= item.audience === 'officers_all' ? '全役員' : item.audience === 'department' ? '部' : item.audience === 'officer_group' ? '役員グループ' : '個別役員' %> ・ 緊急度 <%= '★'.repeat(item.urgency) %><%= item.urgency === 5 ? ' 緊急' : '' %></small></span><span class="status-badge <%= item.unreadCount ? 'status-pending' : '' %>">未確認 <%= item.unreadCount %> / <%= item.recipientCount %>人</span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div><% } %>
  </section>
</main>
<%- include('partials/foot') %>
