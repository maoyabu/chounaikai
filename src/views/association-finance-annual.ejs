<%- include('partials/head') %><%- include('partials/header') %><script>window.financeYears=<%- JSON.stringify(fiscalYears || []) %>;</script>
<main class="page-shell finance-shell">
<a class="back-link" href="<%= publicMode ? `/associations/${association._id}/finance/public` : `/associations/${association._id}/finance` %>">← <%= publicMode ? '住人用の会計報告のページに戻る' : '町内会会計管理へ戻る' %></a>
<% const periodStart = Number(association.financeFiscalStartMonth || 4); const periodEnd = periodStart === 1 ? 12 : periodStart - 1; const periodEndYear = periodStart === 1 ? year : year + 1; %><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>年度集計</h1><p>予算と月別の収支を項目ごとに確認できます。</p><form class="finance-annual-year-selector"><select name="year" onchange="this.form.submit()"><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { %><option value="<%= fiscal %>" <%= fiscal === year ? 'selected' : '' %>><%= fiscal %>年度</option><% } %></select><span class="finance-annual-period">期間：<%= year %>年<%= periodStart %>月 〜 <%= periodEndYear %>年<%= periodEnd %>月</span></form></div><% if (!publicMode) { %><a class="button button-blue" href="/associations/<%= association._id %>/finance/annual/export?year=<%= year %>">Excel出力</a><% } %></div>
<section class="content-card finance-annual-card"><div class="finance-annual-table-wrap"><table class="finance-annual-table"><thead><tr><th>項目</th><th>予算</th><% months.forEach(month => { %><th><%= month %>月</th><% }) %><th>累計</th><th>累計差</th></tr></thead><tbody>
<% const renderRow = (row, section) => { const total = row.months.reduce((sum, value) => sum + value, 0); const diff = row.budget - total; const subtotal = row.name === '収入' || row.name === '支出'; %>
<tr class="finance-annual-row finance-annual-<%= section %> <%= subtotal ? 'finance-annual-subtotal' : '' %>"><th><%= row.name %></th><td><%= row.budget.toLocaleString() %></td><% row.months.forEach((value, index) => { %><td><% if ((section === 'expense' || section === 'income') && !subtotal && value > 0) { %><a href="/associations/<%= association._id %>/finance/<%= publicMode ? 'public/' : '' %>entries?cf=<%= section === 'income' ? '収入' : '支出' %>&item=<%= encodeURIComponent(row.name) %>&month=<%= months[index] %>&year=<%= year %>"><%= value.toLocaleString() %></a><% } else { %><%= value.toLocaleString() %><% } %></td><% }) %><td><strong><%= total.toLocaleString() %></strong></td><td class="<%= diff < 0 ? 'is-negative' : '' %>"><strong><%= diff.toLocaleString() %></strong></td></tr><% }; %>
<% renderRow(incomeRows[0], 'income'); incomeRows.slice(1).forEach(row => renderRow(row, 'income')); renderRow(totalRow, 'balance'); %><tr class="finance-annual-separator"><td colspan="16"></td></tr><% renderRow(expenseRows[0], 'expense'); expenseRows.slice(1).forEach(row => renderRow(row, 'expense')); %>
</tbody></table></div></section></main><%- include('partials/foot') %>
