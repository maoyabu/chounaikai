<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a href="/associations/<%= association._id %>/officer">← 役員メニューへ戻る</a><h1>加入申し込みページ管理</h1>
<% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<p>参加するメリットを10件まで登録できます。上から順に公開されます。変更後は「変更を保存する」を押してください。</p>
<p><a class="button button-quiet" href="/associations/<%= association._id %>/join">加入案内ページを見る・PDF保存</a></p>
<form method="post" id="benefits-form" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<ol id="benefit-rows" class="benefit-management-list"><% (association.joinBenefits || []).forEach(benefit => { %><li class="content-card benefit-row"><strong class="benefit-row-title"><%= benefit.title %></strong><input type="hidden" name="benefitTitle" value="<%= benefit.title %>"><input type="hidden" name="benefitContent" value="<%= benefit.content %>"><input type="hidden" name="benefitColor" value="<%= benefit.color || 'green' %>"><input type="hidden" name="benefitIcon" value="<%= benefit.icon || 'town' %>"><div class="benefit-row-actions"><button type="button" class="button button-quiet" data-action="up" aria-label="上に移動">↑</button><button type="button" class="button button-quiet" data-action="down" aria-label="下に移動">↓</button><button type="button" class="button button-quiet" data-action="edit">編集</button><button type="button" class="button button-quiet" data-action="delete">削除</button></div></li><% }) %></ol>
<p id="benefit-empty">メリットを追加してください。</p><div class="form-actions"><button type="button" id="add-benefit" class="button button-quiet">＋ メリットを追加</button><button class="button button-primary" type="submit">変更を保存する</button></div><p id="benefit-status" role="status" aria-live="polite"></p></form>
<dialog id="benefit-dialog" class="benefit-edit-dialog" aria-labelledby="benefit-dialog-title"><form id="benefit-editor" class="form-stack"><h2 id="benefit-dialog-title">メリットを追加</h2><label>タイトル<input name="title" maxlength="100" required></label><label>内容<textarea name="content" rows="5" maxlength="2000" required></textarea></label>
<fieldset><legend>カラー</legend><div class="benefit-color-options"><% benefitColors.forEach(([value, label, hex]) => { %><label class="benefit-color-option"><input type="radio" name="color" value="<%= value %>" required><span class="benefit-color-swatch" style="background:<%= hex %>"></span><span><%= label %></span></label><% }) %></div></fieldset>
<fieldset><legend>アイコン</legend><div class="benefit-icon-options"><% benefitIcons.forEach(([value, label]) => { %><label class="benefit-icon-option"><input type="radio" name="icon" value="<%= value %>" required><%- include('partials/join-benefit-icon', { icon: value }) %><span><%= label %></span></label><% }) %></div></fieldset>
<div class="form-actions"><button type="submit" class="button button-primary">一覧に反映する</button><button type="button" id="cancel-benefit" class="button button-quiet">キャンセル</button></div><p class="help-text">反映後、一覧画面の「変更を保存する」で公開ページに保存されます。</p></form></dialog></main>
<script type="module" src="/assets/join-manage.js?v=<%= assetVersion %>"></script><%- include('partials/foot') %>
