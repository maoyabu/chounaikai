<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell finance-shell"><a class="back-link" href="/associations/<%= association._id %>/finance">← 町内会会計管理へ戻る</a><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>支出項目別グラフ</h1><p>年度別の支出項目を積み上げて比較できます。</p></div></div><section class="content-card finance-chart-card"><div class="finance-expense-chart" data-chart='<%- JSON.stringify({ years, data, items }) %>'><div class="finance-chart-axis"></div><div class="finance-chart-bars"></div><div class="finance-chart-legend"></div><div class="finance-chart-tooltip" hidden></div></div></section></main><script>(()=>{const root=document.querySelector('.finance-expense-chart');const chart=JSON.parse(root.dataset.chart);const colors=['#176b4d','#2f7f68','#469b83','#6eb39a','#9ac9a9','#d5a846','#d58b46','#b85c52','#8d6aa8','#5078a8','#5f9aaa','#7d8b73'];const totals=chart.data.map(row=>Object.values(row.values).reduce((a,b)=>a+b,0));const max=Math.max(...totals,1);const hidden=new Set();const axis=root.querySelector('.finance-chart-axis');[1,.75,.5,.25,0].forEach(rate=>{const tick=document.createElement('span');tick.textContent='¥'+Math.round(max*rate).toLocaleString();axis.append(tick)});const tooltip=root.querySelector('.finance-chart-tooltip');const legend=root.querySelector('.finance-chart-legend');chart.items.forEach((item,index)=>{const button=document.createElement('button');button.type='button';button.innerHTML='<i style="background:'+colors[index%colors.length]+'"></i>'+item;button.onclick=()=>{hidden.has(item)?hidden.delete(item):hidden.add(item);button.classList.toggle('is-hidden');render()};legend.append(button)});function render(){const bars=root.querySelector('.finance-chart-bars');bars.innerHTML='';chart.data.forEach(row=>{const group=document.createElement('div');group.className='finance-chart-group';const bar=document.createElement('div');bar.className='finance-chart-bar';chart.items.forEach((item,index)=>{if(hidden.has(item))return;const value=row.values[item]||0;if(!value)return;const segment=document.createElement('div');segment.className='finance-chart-segment';segment.style.height=(value/max*100)+'%';segment.style.background=colors[index%colors.length];segment.addEventListener('mouseenter',(event)=>{tooltip.innerHTML='<strong>'+row.year+'年度</strong><br><span class="finance-tooltip-color" style="background:'+colors[index%colors.length]+'"></span>'+item+'<br>合計金額：¥'+value.toLocaleString();tooltip.hidden=false;tooltip.style.left=(event.clientX-root.getBoundingClientRect().left+12)+'px';tooltip.style.top=(event.clientY-root.getBoundingClientRect().top-12)+'px'});segment.addEventListener('mousemove',(event)=>{tooltip.style.left=(event.clientX-root.getBoundingClientRect().left+12)+'px';tooltip.style.top=(event.clientY-root.getBoundingClientRect().top-12)+'px'});segment.addEventListener('mouseleave',()=>{tooltip.hidden=true});bar.append(segment)});const label=document.createElement('span');label.textContent=row.year+'年度';group.append(bar,label);bars.append(group)})}render()})();</script><%- include('partials/foot') %>
