<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell annual-settings-shell">
  <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
  <a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a>
  <section class="page-heading annual-heading"><div><p class="eyebrow">年度設定</p><h1><select class="annual-title-year-selector" aria-label="年度を選択" onchange="window.location.href='?year='+this.value"><% for (let year = fiscalYear - 2; year <= fiscalYear + 2; year++) { %><option value="<%= year %>" <%= year === fiscalYear ? 'selected' : '' %>><%= year %>年度</option><% } %></select>の運営体制</h1><p>前年度末に次年度の役員・班長を設定できます。</p></div><div class="annual-heading-actions"></div></section>
  <div class="management-tabs" role="tablist"><button type="button" role="tab" data-annual-tab="officers">役員の選定・設定</button><button type="button" role="tab" data-annual-tab="leaders">班長の設定</button><button type="button" role="tab" data-annual-tab="plans">部会の事業計画</button></div>
  <section class="content-card management-card annual-officer-admin-panel" data-annual-panel="officers">
    <h2>役員の設定</h2><p class="help-text">役員を先に登録し、必要に応じて町内会の会員を紐付けます。</p><button type="button" class="button button-primary" data-open-new-officer>新規登録</button>
    <dialog class="officer-dialog" id="new-officer-dialog"><div class="dialog-heading"><h3>役員を新規登録</h3><button type="button" class="dialog-close" data-close-new-officer>×</button></div>
    <form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/officers/create" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>">
      <label>役職<select name="roleId"><option value="">選択してください（任意）</option><% roles.forEach((role) => { %><option value="<%= role._id %>"><%= role.name %></option><% }) %></select></label>
      <label>部会<select name="departmentId" required><option value="">選択してください</option><% departments.forEach((department) => { %><option value="<%= department._id %>"><%= department.name %></option><% }) %></select></label>
      <label>氏名<input name="name" required></label><label>氏名よみ<input name="nameKana" required></label>
      <label>地区・班<select name="districtGroupId" required><option value="">選択してください</option><% districtGroups.forEach((group) => { %><option value="<%= group._id %>"><%= group.name %></option><% }) %></select></label>
      <label>住所<input name="address" type="text"></label>
      <label>電話番号<input name="phone" type="tel"></label><label>携帯電話番号<input name="mobilePhone" type="tel"></label>
      <div class="form-actions"><button class="button button-primary">新規登録</button></div>
    </form></dialog>
    <h3>役員一覧</h3><div class="annual-officer-record-list"><% (officerRecords || []).forEach((officer) => { %><article><div><strong><%= officer.name || officer.user?.displayname || officer.user?.username || '氏名未登録' %></strong><span><%= officer.role?.name || '一般役員' %> / <%= officer.districtGroup?.name || '地区・班未設定' %></span><small><%= officer.nameKana || '' %>　<%= officer.phone || '' %>　<%= officer.mobilePhone || '' %></small><% if (officer.user) { %><small>紐付け済み：<%= officer.user.displayname || officer.user.username || officer.user.email %></small><% } %></div><div class="form-actions"><button type="button" class="button button-quiet" data-open-link-dialog="link-officer-<%= officer._id %>">会員を紐付け</button><form method="post" action="/associations/<%= association._id %>/manage/annual/officers/<%= officer._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">削除</button></form></div></article><dialog class="officer-dialog" id="link-officer-<%= officer._id %>"><div class="dialog-heading"><h3>会員を紐付け</h3><button type="button" class="dialog-close" data-close-link-dialog>×</button></div><label class="resident-search">名前・メールアドレスで検索<input type="search" data-link-search="<%= officer._id %>"></label><div data-link-results="<%= officer._id %>"><% (officerCandidates || []).forEach((candidate) => { %><form method="post" action="/associations/<%= association._id %>/manage/annual/officers/<%= officer._id %>/link" data-link-candidate data-search="<%= [candidate.name, candidate.email].join(' ') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= candidate._id %>"><button class="resident-row-button"><strong><%= candidate.name %></strong><span><%= candidate.email %></span></button></form><% }) %></div></dialog><% }) %></div>
    <h3>次年度へコピー</h3><form class="inline-form" method="post" action="/associations/<%= association._id %>/manage/annual/officers/copy" onsubmit="if (!confirm('コピー先に役員・班長・部会の事業計画がある場合は上書きされます。会員の紐付けは引き継ぎ、実施報告は空欄で複製します。続行しますか？')) return false; this.overwrite.value='1'; return true"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="overwrite" value="0"><label>コピー元年度<input type="number" name="fromYear" value="<%= fiscalYear %>" required></label><label>コピー先年度<input type="number" name="toYear" value="<%= fiscalYear + 1 %>" required></label><button class="button button-primary">年度設定をコピー</button></form>
  </section>
  <section class="content-card management-card" data-annual-panel="legacy-officers" hidden>
    <h2>世帯主から役員を選定・設定</h2>
    <p class="help-text">氏名、メールアドレス、住所、性別で絞り込み、年度役員フラグと役職・所属部を設定します。</p>
    <label class="resident-search">世帯主を絞り込む<input type="search" id="officer-resident-search" placeholder="氏名・メール・性別を入力" autocomplete="off"></label>
    <% const genderLabels = { male: '男性', female: '女性', other: 'その他', unspecified: '回答なし' }; const representatives = typeof householdRepresentatives !== 'undefined' ? householdRepresentatives : []; const officerGroups = [{ title: '役員候補の世帯主', people: representatives.filter((item) => !item.officer), empty: '選定できる世帯主はいません。' }, { title: '選定済みの役員', people: representatives.filter((item) => item.officer), empty: '選定済みの役員はいません。' }]; %>
    <% officerGroups.forEach(({ title, people, empty }) => { %>
    <section class="annual-candidate-group"><div class="annual-candidate-heading"><h3><%= title %></h3><span class="status-badge"><%= people.length %>人</span></div>
    <div class="resident-selection-list">
      <% people.forEach(({ user, household, districtGroup, residentProfile, officer, attributeTags }) => { const residentName = residentProfile?.name || user.displayname || user.username; const residentEmail = user.email || residentProfile?.email || ''; const residentAddress = `〒${household.address?.postalCode || '—'} ${household.address?.street || ''} ${household.address?.building || ''}`; const searchText = [residentName, user.username, residentEmail, districtGroup?.name, genderLabels[residentProfile?.gender], ...(attributeTags || [])].filter(Boolean).join(' '); %>
        <article class="resident-row" data-resident-row data-search="<%= searchText %>">
          <button type="button" class="resident-row-button" data-open-officer-dialog="officer-dialog-<%= user._id %>" aria-label="<%= residentName %>さんの役員設定を開く">
            <% if (user.avatar) { %><img class="profile-avatar resident-avatar" src="<%= user.avatar %>" alt=""><% } else { %><span class="profile-avatar resident-avatar profile-avatar-placeholder" aria-hidden="true"><%= residentName.charAt(0) %></span><% } %>
            <strong><%= residentName %>さん</strong>
            <span class="resident-tags"><span class="status-badge"><%= districtGroup?.name || '班未設定' %></span><% (attributeTags || []).forEach((tag) => { %><span class="status-badge member-attribute-tag"><%= tag %></span><% }) %></span>
            <span><%= residentEmail || 'メール未登録' %></span>
            <span class="resident-address"><%= residentAddress %></span>
          </button>
          <dialog class="officer-dialog" id="officer-dialog-<%= user._id %>">
            <div class="dialog-heading"><div><p class="eyebrow"><%= fiscalYear %>年度</p><h3><%= residentName %>さんの役員設定</h3></div><button type="button" class="dialog-close" data-close-officer-dialog aria-label="閉じる">×</button></div>
          <form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/officers/configure" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><input type="hidden" name="userId" value="<%= user._id %>">
            <label class="officer-flag"><input type="checkbox" name="isOfficer" value="1" <%= officer ? 'checked' : '' %>> <%= fiscalYear %>年度役員</label>
            <label>所属班<select name="membershipDistrictGroupId" required><% districtGroups.forEach((group) => { %><option value="<%= group._id %>" <%= String(districtGroup?._id || '') === String(group._id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label>
            <label>役職<select name="roleId"><option value="">役職なし</option><% roles.forEach((role) => { %><option value="<%= role._id %>" <%= String(officer?.role?._id || officer?.role || '') === String(role._id) ? 'selected' : '' %>><%= role.name %></option><% }) %></select></label>
            <label>所属部<select name="departmentId"><option value="">所属部なし</option><% departments.forEach((department) => { %><option value="<%= department._id %>" <%= String(officer?.department?._id || officer?.department || '') === String(department._id) ? 'selected' : '' %>><%= department.name %></option><% }) %></select></label>
            <div class="form-actions"><button type="button" class="button button-quiet" data-close-officer-dialog>キャンセル</button><button class="button button-primary">設定を保存</button></div>
          </form>
          </dialog>
        </article>
      <% }) %>
      <% if (!people.length) { %><p class="help-text annual-group-empty"><%= empty %></p><% } %>
    </div></section>
    <% }) %>
    <p id="officer-search-empty" class="help-text" hidden>条件に一致する世帯主はいません。</p>
  </section>
  <section class="content-card management-card annual-leader-admin-panel" data-annual-panel="leaders">
    <h2>班長の設定</h2><p class="help-text">班長を先に登録し、必要に応じて町内会の会員を紐付けます。</p><button type="button" class="button button-primary" data-open-new-leader>新規登録</button>
    <dialog class="officer-dialog" id="new-leader-dialog"><div class="dialog-heading"><h3>班長を新規登録</h3><button type="button" class="dialog-close" data-close-new-leader>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/leaders/create" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><label>地区・班<select name="districtGroupId" required><option value="">選択してください</option><% districtGroups.forEach((group) => { %><option value="<%= group._id %>"><%= group.name %></option><% }) %></select></label><label>住所<input name="address" type="text"></label><label>氏名<input name="name" required></label><label>氏名よみ<input name="nameKana" required></label><label>電話番号<input name="phone" type="tel"></label><label>携帯電話番号<input name="mobilePhone" type="tel"></label><div class="form-actions"><button class="button button-primary">登録</button></div></form></dialog>
    <h3>班長一覧</h3><div class="annual-officer-record-list"><% (leaderRecords || []).forEach((leader) => { %><article><div><strong><%= leader.name || leader.representative?.displayname || '氏名未登録' %></strong><span><%= leader.districtGroup?.name || '地区・班未設定' %></span><small><%= leader.nameKana || '' %>　<%= leader.phone || '' %>　<%= leader.mobilePhone || '' %></small><% if (leader.representative) { %><small>紐付け済み：<%= leader.representative.displayname || leader.representative.username || leader.representative.email %></small><% } %></div><div><button type="button" class="button button-quiet" data-open-leader-link="leader-link-<%= leader._id %>">会員を紐付け</button><form method="post" action="/associations/<%= association._id %>/manage/annual/leaders/<%= leader._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">削除</button></form></div></article><dialog class="officer-dialog" id="leader-link-<%= leader._id %>"><div class="dialog-heading"><div><h3>会員を紐付け</h3><p class="selected-officer-summary"><%= leader.name || '氏名未登録' %> ／ <%= leader.districtGroup?.name || '地区・班未設定' %></p></div><button type="button" class="dialog-close" data-close-leader-link>×</button></div><label class="resident-search">名前・メールアドレスで検索<input type="search" data-leader-link-search="<%= leader._id %>"></label><div data-leader-link-results="<%= leader._id %>"><% (leaderCandidates || []).forEach((candidate) => { %><form method="post" action="/associations/<%= association._id %>/manage/leaders/<%= leader._id %>/link" data-leader-link-candidate data-search="<%= [candidate.name, candidate.email].join(' ') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= candidate._id %>"><button class="resident-row-button"><strong><%= candidate.name %></strong><span><%= candidate.email %></span></button></form><% }) %></div></dialog><% }) %></div>
  </section>
  <section class="content-card management-card annual-plan-admin-panel" data-annual-panel="plans">
    <div class="annual-plan-panel-heading"><h2>部会の事業計画</h2><button type="button" class="button button-primary" data-open-new-plan>新規登録</button></div><p class="help-text">各部会の年度目標を登録します。</p>
    <dialog class="officer-dialog" id="new-department-plan-dialog"><div class="dialog-heading"><h3>部会の事業計画を新規登録</h3><button type="button" class="dialog-close" data-close-plan-dialog>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/department-plans/create" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><label>部会<select name="departmentId" required><option value="">選択してください</option><% departments.forEach((department) => { %><option value="<%= department._id %>"><%= department.name %></option><% }) %></select></label><label>年度の目標<textarea name="goal" rows="6" required></textarea></label><div class="form-actions"><button class="button button-primary">登録</button></div></form></dialog>
    <h3>事業計画一覧</h3><div class="annual-plan-list"><% (departmentPlans || []).forEach((plan) => { %><article class="annual-plan-record" data-open-plan-edit="plan-edit-<%= plan._id %>"><div><strong><%= plan.department?.name || '部会未設定' %></strong><p><%= plan.goal %></p></div><dialog class="officer-dialog" id="plan-edit-<%= plan._id %>"><div class="dialog-heading"><h3>部会の事業計画を編集</h3><button type="button" class="dialog-close" data-close-plan-dialog>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/department-plans/<%= plan._id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>部会<select name="departmentId" required><% departments.forEach((department) => { %><option value="<%= department._id %>" <%= String(plan.department?._id || plan.department) === String(department._id) ? 'selected' : '' %>><%= department.name %></option><% }) %></select></label><label>年度の目標<textarea name="goal" rows="6" required><%= plan.goal %></textarea></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-plan-dialog>キャンセル</button><button class="button button-primary">保存</button></div></form></dialog></article><% }) %><% if (!(departmentPlans || []).length) { %><p class="help-text">登録されている事業計画はありません。</p><% } %></div>
  </section>
  <section class="content-card management-card" data-annual-panel="legacy-leaders" hidden>
    <h2>世帯主から班長を選定・設定</h2><p class="help-text">氏名、メールアドレス、班で絞り込み、班長フラグと担当班を設定します。</p>
    <label class="resident-search">世帯主を絞り込む<input type="search" id="leader-resident-search" placeholder="氏名・班・メールを入力" autocomplete="off"></label>
    <% const leaderGroups = [{ title: '班長候補の世帯主', people: representatives.filter((item) => !item.leaderAssignment), empty: '選定できる世帯主はいません。' }, { title: '選定済みの班長', people: representatives.filter((item) => item.leaderAssignment), empty: '選定済みの班長はいません。' }]; %>
    <% leaderGroups.forEach(({ title, people, empty }) => { %>
    <section class="annual-candidate-group"><div class="annual-candidate-heading"><h3><%= title %></h3><span class="status-badge"><%= people.length %>人</span></div>
    <div class="resident-selection-list">
      <% people.forEach(({ user, household, districtGroup, residentProfile, leaderAssignment, attributeTags }) => { const residentName = residentProfile?.name || user.displayname || user.username; const residentEmail = user.email || residentProfile?.email || ''; const residentAddress = `〒${household.address?.postalCode || '—'} ${household.address?.street || ''} ${household.address?.building || ''}`; const searchText = [residentName, user.username, residentEmail, districtGroup?.name, ...(attributeTags || [])].filter(Boolean).join(' '); %>
        <article class="resident-row" data-leader-row data-search="<%= searchText %>"><button type="button" class="resident-row-button" data-open-leader-dialog="leader-dialog-<%= user._id %>"><% if (user.avatar) { %><img class="profile-avatar resident-avatar" src="<%= user.avatar %>" alt=""><% } else { %><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%= residentName.charAt(0) %></span><% } %><strong><%= residentName %>さん</strong><span class="resident-tags"><span class="status-badge"><%= districtGroup?.name || '班未設定' %></span><% (attributeTags || []).forEach((tag) => { %><span class="status-badge member-attribute-tag"><%= tag %></span><% }) %></span><span><%= residentEmail || 'メール未登録' %></span><span class="resident-address"><%= residentAddress %></span></button>
          <dialog class="officer-dialog" id="leader-dialog-<%= user._id %>"><div class="dialog-heading"><div><p class="eyebrow"><%= fiscalYear %>年度</p><h3><%= residentName %>さんの班長設定</h3></div><button type="button" class="dialog-close" data-close-leader-dialog>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/leaders/configure" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><input type="hidden" name="userId" value="<%= user._id %>"><label class="officer-flag"><input type="checkbox" name="isLeader" value="1" <%= leaderAssignment ? 'checked' : '' %>> <%= fiscalYear %>年度班長</label><label>所属班<select name="membershipDistrictGroupId" required><% districtGroups.forEach((group) => { %><option value="<%= group._id %>" <%= String(districtGroup?._id || '') === String(group._id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label><label>班長の担当班<select name="districtGroupId"><option value="">班を選択</option><% districtGroups.forEach((group) => { %><option value="<%= group._id %>" <%= String(leaderAssignment?.districtGroup?._id || leaderAssignment?.districtGroup || districtGroup?._id || '') === String(group._id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-leader-dialog>キャンセル</button><button class="button button-primary">設定を保存</button></div></form></dialog>
        </article>
      <% }) %>
      <% if (!people.length) { %><p class="help-text annual-group-empty"><%= empty %></p><% } %>
    </div></section>
    <% }) %>
    <p id="leader-search-empty" class="help-text" hidden>条件に一致する世帯主はいません。</p>
  </section>
  <script>(()=>{const tabs=[...document.querySelectorAll('[data-annual-tab]')],panels=[...document.querySelectorAll('[data-annual-panel]')],key='annual-settings-tab:<%= association._id %>';const select=(value)=>{tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.annualTab===value)));panels.forEach(p=>p.hidden=p.dataset.annualPanel!==value);localStorage.setItem(key,value)};tabs.forEach(t=>t.addEventListener('click',()=>select(t.dataset.annualTab)));select(localStorage.getItem(key)||'officers');const normalize=value=>String(value||'').normalize('NFKC').toLocaleLowerCase('ja'),setupFilter=(inputId,rowSelector,emptyId)=>{const search=document.getElementById(inputId),rows=[...document.querySelectorAll(rowSelector)],empty=document.getElementById(emptyId),filter=()=>{const terms=normalize(search?.value).trim().split(/\s+/).filter(Boolean);let visible=0;rows.forEach(row=>{const match=terms.every(term=>normalize(row.dataset.search).includes(term));row.hidden=!match;if(match)visible++});document.querySelectorAll(`[data-annual-panel="${inputId.startsWith('officer')?'officers':'leaders'}"] .annual-candidate-group`).forEach(group=>{group.hidden=terms.length>0&&![...group.querySelectorAll(rowSelector)].some(row=>!row.hidden)});if(empty)empty.hidden=!terms.length||visible>0};search?.addEventListener('input',filter);filter()};setupFilter('officer-resident-search','[data-resident-row]','officer-search-empty');setupFilter('leader-resident-search','[data-leader-row]','leader-search-empty');document.querySelectorAll('[data-open-officer-dialog]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.openOfficerDialog)?.showModal()));document.querySelectorAll('[data-open-leader-dialog]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.openLeaderDialog)?.showModal()));document.querySelectorAll('[data-close-officer-dialog],[data-close-leader-dialog]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));document.querySelectorAll('.officer-dialog').forEach(dialog=>dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()}))})();</script>
  <script>
    const officerPanel = document.querySelector('.annual-officer-admin-panel');
    const copyHeading = [...(officerPanel?.querySelectorAll('h3') || [])].find((heading) => heading.textContent.includes('次年度へコピー'));
    const copyForm = copyHeading?.nextElementSibling;
    const tabs = document.querySelector('.management-tabs');
    if (copyHeading && copyForm) {
      copyHeading.remove();
      const dialog = document.createElement('dialog'); dialog.className = 'officer-dialog annual-copy-dialog'; dialog.id = 'annual-copy-dialog';
      dialog.innerHTML = '<div class="dialog-heading"><h3>年度設定の複製</h3><button type="button" class="dialog-close" data-close-copy-dialog>×</button></div>';
      dialog.append(copyForm); document.querySelector('.annual-heading')?.append(dialog);
      const button = document.createElement('button'); button.type = 'button'; button.className = 'button button-primary annual-copy-button'; button.textContent = '年度設定の複製';
      button.addEventListener('click', () => dialog.showModal()); document.querySelector('.annual-heading-actions')?.append(button);
      dialog.querySelector('[data-close-copy-dialog]')?.addEventListener('click', () => dialog.close());
    }
    document.querySelector('[data-open-new-officer]')?.addEventListener('click', () => document.getElementById('new-officer-dialog')?.showModal());
    document.querySelector('[data-close-new-officer]')?.addEventListener('click', () => document.getElementById('new-officer-dialog')?.close());
    document.querySelector('[data-open-new-leader]')?.addEventListener('click', () => document.getElementById('new-leader-dialog')?.showModal());
    document.querySelector('[data-close-new-leader]')?.addEventListener('click', () => document.getElementById('new-leader-dialog')?.close());
    document.querySelector('[data-open-new-plan]')?.addEventListener('click', () => document.getElementById('new-department-plan-dialog')?.showModal());
    document.querySelectorAll('[data-close-plan-dialog]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    document.querySelectorAll('[data-open-plan-edit]').forEach((article) => article.addEventListener('click', (event) => { if (event.target.closest('dialog, form, button, input, select, textarea')) return; document.getElementById(article.dataset.openPlanEdit)?.showModal(); }));
    const leaderDistricts = <%- JSON.stringify(typeof leaderDistricts !== 'undefined' ? leaderDistricts : []) %>;
    const leaderDistrictSelect = document.querySelector('#new-leader-dialog select[name="districtGroupId"]');
    if (leaderDistrictSelect) {
      const label = leaderDistrictSelect.closest('label');
      const hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = 'districtGroupId'; leaderDistrictSelect.remove(); label.append(hidden);
      const district = document.createElement('select'), group = document.createElement('select');
      district.required = true; district.innerHTML = '<option value="">地区を選択してください</option>' + leaderDistricts.map((item) => `<option value="${item._id}">${item.name}</option>`).join('');
      group.innerHTML = '<option value="">班を選択してください</option>';
      const groupLabel = document.createElement('label'); groupLabel.textContent = '班'; groupLabel.append(group); label.after(groupLabel); label.querySelector('span')?.remove(); label.append(district);
      const updateGroups = () => { const item = leaderDistricts.find((districtItem) => String(districtItem._id) === String(district.value)); group.innerHTML = item?.groups?.length ? '<option value="">班を選択してください</option>' + item.groups.map((child) => `<option value="${child._id}">${child.name.replace(item.name, '')}</option>`).join('') : '<option value="">地区全体</option>'; hidden.value = item?.groups?.length ? group.value : (item?._id || ''); };
      district.addEventListener('change', updateGroups); group.addEventListener('change', () => { hidden.value = group.value || district.value; });
      hidden.closest('form')?.addEventListener('submit', () => { hidden.value = group.value || district.value; });
    }
    const officerDistrictSelect = document.querySelector('#new-officer-dialog select[name="districtGroupId"]');
    if (officerDistrictSelect) {
      const label = officerDistrictSelect.closest('label');
      const hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = 'districtGroupId'; officerDistrictSelect.remove(); label.append(hidden);
      const district = document.createElement('select'), group = document.createElement('select');
      district.required = true; district.innerHTML = '<option value="">地区を選択してください</option>' + leaderDistricts.map((item) => `<option value="${item._id}">${item.name}</option>`).join('');
      group.innerHTML = '<option value="">班を選択してください</option>';
      const groupLabel = document.createElement('label'); groupLabel.textContent = '班'; groupLabel.append(group); label.after(groupLabel); label.append(district);
      const updateGroups = () => { const item = leaderDistricts.find((districtItem) => String(districtItem._id) === String(district.value)); group.innerHTML = item?.groups?.length ? '<option value="">班を選択してください</option>' + item.groups.map((child) => `<option value="${child._id}">${child.name.replace(item.name, '')}</option>`).join('') : '<option value="">地区全体</option>'; hidden.value = item?.groups?.length ? group.value : (item?._id || ''); };
      district.addEventListener('change', updateGroups); group.addEventListener('change', () => { hidden.value = group.value || district.value; });
      hidden.closest('form')?.addEventListener('submit', () => { hidden.value = group.value || district.value; });
    }
    document.querySelectorAll('[data-open-leader-link]').forEach((button) => button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.openLeaderLink); const summary = dialog?.querySelector('.selected-officer-summary'); const search = dialog?.querySelector('.resident-search'); if (summary && search) search.before(summary); dialog?.showModal(); }));
    document.querySelectorAll('[data-close-leader-link]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    document.querySelectorAll('[data-leader-link-search]').forEach((input) => input.addEventListener('input', () => { const q = input.value.normalize('NFKC').toLocaleLowerCase('ja'); document.querySelectorAll(`[data-leader-link-results="${input.dataset.leaderLinkSearch}"] [data-leader-link-candidate]`).forEach((row) => { row.hidden = !row.dataset.search.normalize('NFKC').toLocaleLowerCase('ja').includes(q); }); }));
    document.querySelectorAll('[data-open-link-dialog]').forEach((button) => button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.openLinkDialog); const article = button.closest('article'); if (dialog && article) { let summary = dialog.querySelector('.selected-officer-summary'); if (!summary) { summary = document.createElement('p'); summary.className = 'selected-officer-summary'; } summary.textContent = `${article.querySelector('strong')?.textContent || ''}さんを紐づける`; const search = dialog.querySelector('.resident-search'); search?.before(summary); } dialog?.showModal(); }));
    document.querySelectorAll('[data-close-link-dialog]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    document.querySelectorAll('[data-link-search]').forEach((input) => input.addEventListener('input', () => {
      const q = input.value.normalize('NFKC').toLocaleLowerCase('ja');
      document.querySelectorAll(`[data-link-results="${input.dataset.linkSearch}"] [data-link-candidate]`).forEach((row) => { row.hidden = !row.dataset.search.normalize('NFKC').toLocaleLowerCase('ja').includes(q); });
    }));
    const editableOfficerRecords = <%- JSON.stringify(typeof officerRecords !== 'undefined' ? officerRecords : []) %>;
    const editableLeaderRecords = <%- JSON.stringify(typeof leaderRecords !== 'undefined' ? leaderRecords : []) %>;
    const roleOptions = <%- JSON.stringify(typeof roles !== 'undefined' ? roles : []) %>;
    const departmentOptions = <%- JSON.stringify(typeof departments !== 'undefined' ? departments : []) %>;
    const districtOptions = <%- JSON.stringify(typeof leaderDistricts !== 'undefined' ? leaderDistricts : []) %>;
    const openEditDialog = (record, isLeader, articleCsrf) => {
      if (!record || !record._id) return;
      const dialog = document.createElement('dialog'); dialog.className = 'officer-dialog record-edit-dialog';
      const id = record._id, prefix = isLeader ? 'leaders' : 'officers';
      const districts = districtOptions.flatMap((district) => [{ ...district, display: district.name }, ...(district.groups || []).map((group) => ({ ...group, display: `${district.name} ${group.name.replace(district.name, '')}` }))]);
      dialog.innerHTML = `<div class="dialog-heading"><h3>${isLeader ? '班長' : '役員'}を編集</h3><button type="button" class="dialog-close">×</button></div><form method="post" class="resident-officer-form" action="${location.pathname.replace(/\/manage\/annual.*/, '')}/manage/annual/${prefix}/${id}/update">${isLeader ? '' : `<label>役職<select name="roleId"><option value="">選択してください（任意）</option>${roleOptions.map((role) => `<option value="${role._id}" ${String(record.role?._id || record.role) === String(role._id) ? 'selected' : ''}>${role.name}</option>`).join('')}</select></label><label>部会<select name="departmentId" required><option value="">選択してください</option>${departmentOptions.map((department) => `<option value="${department._id}" ${String(record.department?._id || record.department) === String(department._id) ? 'selected' : ''}>${department.name}</option>`).join('')}</select></label>`}<label>地区<select data-edit-district required><option value="">地区を選択してください</option>${districtOptions.map((item) => `<option value="${item._id}">${item.name}</option>`).join('')}</select></label><label>班<select name="groupId" data-edit-group><option value="">班を選択してください</option></select></label><input type="hidden" name="districtId" data-edit-district-id><input type="hidden" name="districtGroupId" data-edit-location><label>氏名<input name="name" value="${record.name || record.representative?.displayname || ''}" required></label><label>氏名よみ<input name="nameKana" value="${record.nameKana || ''}" required></label><label>電話番号<input name="phone" value="${record.phone || ''}" type="tel"></label><label>携帯電話番号<input name="mobilePhone" value="${record.mobilePhone || ''}" type="tel"></label><input type="hidden" name="_csrf" value="${articleCsrf}"><div class="form-actions"><button type="button" class="button button-quiet dialog-cancel">キャンセル</button><button class="button button-primary">保存</button></div></form>`;
      const addressLabel = document.createElement('label'); addressLabel.textContent = '住所'; const addressInput = document.createElement('input'); addressInput.name = 'address'; addressInput.type = 'text'; addressInput.value = record.address || ''; addressLabel.append(addressInput); dialog.querySelector('input[name="name"]')?.closest('label')?.before(addressLabel);
      const districtSelect = dialog.querySelector('[data-edit-district]'), groupSelect = dialog.querySelector('[data-edit-group]'), districtId = dialog.querySelector('[data-edit-district-id]'), locationField = dialog.querySelector('[data-edit-location]');
      const selectedDistrict = String(record.district?._id || record.district || (record.group?.parentDistrict || record.districtGroup?.parentDistrict) || record.districtGroup?._id || '');
      const selectedGroup = String(record.group?._id || record.group || (record.districtGroup?.parentDistrict ? record.districtGroup?._id : '') || '');
      const refreshGroups = () => { const item = districtOptions.find((entry) => String(entry._id) === String(districtSelect.value)); groupSelect.innerHTML = item?.groups?.length ? '<option value="">班を選択してください</option>' + item.groups.map((child) => `<option value="${child._id}">${child.name.replace(item.name, '')}</option>`).join('') : '<option value="">地区全体</option>'; groupSelect.required = Boolean(item?.groups?.length); groupSelect.value = selectedGroup || ''; districtId.value = districtSelect.value; locationField.value = groupSelect.value || districtSelect.value; };
      districtSelect.value = selectedDistrict; districtSelect.addEventListener('change', () => { refreshGroups(); }); groupSelect.addEventListener('change', () => { districtId.value = districtSelect.value; locationField.value = groupSelect.value || districtSelect.value; }); refreshGroups();
      dialog.querySelector('.dialog-close').onclick = () => dialog.close(); dialog.querySelector('.dialog-cancel').onclick = () => dialog.close(); document.body.append(dialog); dialog.showModal();
    };
    document.querySelectorAll('.annual-officer-record-list > article').forEach((article, index) => {
      // 編集対象の dialog は article の子ではなく、article の直後に出力される兄弟要素。
      const editDialog = article.nextElementSibling?.matches('dialog') ? article.nextElementSibling : null;
      const isLeaderRecord = Boolean(article.closest('[data-annual-panel="leaders"]'));
      const recordId = editDialog?.id?.replace(/^(?:leader-link|link-officer)-/, '');
      const records = isLeaderRecord ? editableLeaderRecords : editableOfficerRecords;
      const sourceRecord = records.find((item) => String(item._id) === String(recordId)) || records[index];
      // SSR 側の配列が空でも、既存の紐付けモーダルのIDから編集対象を確定する。
      const record = sourceRecord || { _id: recordId, name: article.querySelector('strong')?.textContent?.trim() || '', nameKana: '', phone: '', mobilePhone: '' };
      article.classList.add('record-editable');
      article.addEventListener('click', (event) => {
        if (event.target.closest('button, form, dialog, a, input, select')) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        openEditDialog(record, isLeaderRecord, article.querySelector('input[name="_csrf"]')?.value);
      }, true);
      const linked = [...article.querySelectorAll('small')].find((item) => item.textContent.includes('紐付け済み'));
      const actions = article.querySelector(':scope > div:last-of-type');
      const linkButton = actions?.querySelector('[data-open-link-dialog], [data-open-leader-link]');
      if (linked && actions && linkButton) { const tag = document.createElement('span'); tag.className = 'member-linked-tag'; tag.textContent = linked.textContent.trim().replace(/^紐付け済み：?\s*/, ''); actions.insertBefore(tag, linkButton); linkButton.classList.add('is-linked'); linked.remove(); }
    });
  </script>
