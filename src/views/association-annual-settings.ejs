<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell annual-settings-shell">
  <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
  <a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a>
  <section class="page-heading annual-heading"><div><p class="eyebrow">年度設定</p><h1><%= fiscalYear %>年度の運営体制</h1><p>前年度末に次年度の役員・班長を設定できます。</p></div><form class="year-selector" method="get"><label>表示年度<select name="year" onchange="this.form.submit()"><% for (let year = fiscalYear - 2; year <= fiscalYear + 2; year++) { %><option value="<%= year %>" <%= year === fiscalYear ? 'selected' : '' %>><%= year %>年度</option><% } %></select></label></form></section>
  <div class="management-tabs" role="tablist"><button type="button" role="tab" data-annual-tab="officers">役員の選定・設定</button><button type="button" role="tab" data-annual-tab="leaders">班長の設定</button></div>
  <section class="content-card management-card annual-officer-admin-panel" data-annual-panel="officers">
    <h2>役員の設定</h2><p class="help-text">役員を先に登録し、必要に応じて町内会の会員を紐付けます。</p><button type="button" class="button button-primary" data-open-new-officer>新規登録</button>
    <dialog class="officer-dialog" id="new-officer-dialog"><div class="dialog-heading"><h3>役員を新規登録</h3><button type="button" class="dialog-close" data-close-new-officer>×</button></div>
    <form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/officers/create" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>">
      <label>役職<select name="roleId" required><option value="">選択してください</option><% roles.forEach((role) => { %><option value="<%= role._id %>"><%= role.name %></option><% }) %></select></label>
      <label>氏名<input name="name" required></label><label>氏名よみ<input name="nameKana" required></label>
      <label>地区・班<select name="districtGroupId" required><option value="">選択してください</option><% districtGroups.forEach((group) => { %><option value="<%= group._id %>"><%= group.name %></option><% }) %></select></label>
      <label>電話番号<input name="phone" type="tel"></label><label>携帯電話番号<input name="mobilePhone" type="tel"></label>
      <div class="form-actions"><button class="button button-primary">新規登録</button></div>
    </form></dialog>
    <h3>役員一覧</h3><div class="annual-officer-record-list"><% (officerRecords || []).forEach((officer) => { %><article><div><strong><%= officer.name || officer.user?.displayname || officer.user?.username || '氏名未登録' %></strong><span><%= officer.role?.name || '役職未設定' %> / <%= officer.districtGroup?.name || '地区・班未設定' %></span><small><%= officer.nameKana || '' %>　<%= officer.phone || '' %>　<%= officer.mobilePhone || '' %></small><small><%= officer.user ? `紐付け済み：${officer.user.displayname || officer.user.username || officer.user.email}` : '会員未紐付け' %></small></div><div class="form-actions"><button type="button" class="button button-quiet" data-open-link-dialog="link-officer-<%= officer._id %>">会員を紐付け</button><form method="post" action="/associations/<%= association._id %>/manage/annual/officers/<%= officer._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">削除</button></form></div></article><dialog class="officer-dialog" id="link-officer-<%= officer._id %>"><div class="dialog-heading"><h3>会員を紐付け</h3><button type="button" class="dialog-close" data-close-link-dialog>×</button></div><label class="resident-search">名前・メールアドレスで検索<input type="search" data-link-search="<%= officer._id %>"></label><div data-link-results="<%= officer._id %>"><% (officerCandidates || []).forEach((candidate) => { %><form method="post" action="/associations/<%= association._id %>/manage/annual/officers/<%= officer._id %>/link" data-link-candidate data-search="<%= [candidate.name, candidate.email].join(' ') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= candidate._id %>"><button class="resident-row-button"><strong><%= candidate.name %></strong><span><%= candidate.email %></span></button></form><% }) %></div></dialog><% }) %></div>
    <h3>次年度へコピー</h3><form class="inline-form" method="post" action="/associations/<%= association._id %>/manage/annual/officers/copy" onsubmit="if (!confirm('コピー先に登録済みの役員がある場合は上書きされます。続行しますか？')) return false; this.overwrite.value='1'; return true"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="overwrite" value="0"><label>コピー元年度<input type="number" name="fromYear" value="<%= fiscalYear %>" required></label><label>コピー先年度<input type="number" name="toYear" value="<%= fiscalYear + 1 %>" required></label><button class="button button-primary">年度設定をコピー</button></form>
  </section>
  <section class="content-card management-card" data-annual-panel="legacy-officers" hidden>
    <h2>世帯主から役員を選定・設定</h2>
    <p class="help-text">氏名、メールアドレス、住所、性別で絞り込み、年度役員フラグと役職・所属部を設定します。</p>
    <label class="resident-search">世帯主を絞り込む<input type="search" id="officer-resident-search" placeholder="氏名・メール・住所・性別を入力" autocomplete="off"></label>
    <% const genderLabels = { male: '男性', female: '女性', other: 'その他', unspecified: '回答なし' }; const representatives = typeof householdRepresentatives !== 'undefined' ? householdRepresentatives : []; const officerGroups = [{ title: '役員候補の世帯主', people: representatives.filter((item) => !item.officer), empty: '選定できる世帯主はいません。' }, { title: '選定済みの役員', people: representatives.filter((item) => item.officer), empty: '選定済みの役員はいません。' }]; %>
    <% officerGroups.forEach(({ title, people, empty }) => { %>
    <section class="annual-candidate-group"><div class="annual-candidate-heading"><h3><%= title %></h3><span class="status-badge"><%= people.length %>人</span></div>
    <div class="resident-selection-list">
      <% people.forEach(({ user, household, districtGroup, residentProfile, officer, attributeTags }) => { const residentName = residentProfile?.name || user.displayname || user.username; const residentEmail = user.email || residentProfile?.email || ''; const residentAddress = `〒${household.address?.postalCode || '—'} ${household.address?.street || ''} ${household.address?.building || ''}`; const searchText = [residentName, user.username, residentEmail, districtGroup?.name, residentAddress, genderLabels[residentProfile?.gender], ...(attributeTags || [])].filter(Boolean).join(' '); %>
        <article class="resident-row" data-resident-row data-search="<%= searchText %>">
          <button type="button" class="resident-row-button" data-open-officer-dialog="officer-dialog-<%= user._id %>" aria-label="<%= residentName %>さんの役員設定を開く">
            <% if (user.avatar) { %><img class="profile-avatar resident-avatar" src="<%= user.avatar %>" alt=""><% } else { %><span class="profile-avatar resident-avatar profile-avatar-placeholder" aria-hidden="true"><%= residentName.charAt(0) %></span><% } %>
            <strong><%= residentName %>さん</strong>
            <span class="resident-tags"><span class="status-badge"><%= districtGroup?.name || '班未設定' %></span><% (attributeTags || []).forEach((tag) => { %><span class="status-badge member-attribute-tag"><%= tag %></span><% }) %></span>
            <span><%= residentEmail || 'メール未登録' %></span>
            <span class="resident-address"><%= residentAddress %></span>
          </button>
          <dialog class="officer-dialog" id="officer-dialog-<%= user._id %>">
            <div class="dialog-heading"><div><p class="eyebrow"><%= fiscalYear %>年度</p><h3><%= residentName %>さんの役員設定</h3></div><button type="button" class="dialog-close" data-close-officer-dialog aria-label="閉じる">×</button></div>
          <form class="resident-officer-form" action="/associations/<%= association._id %>/manage/annual/officers/configure" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><input type="hidden" name="userId" value="<%= user._id %>">
            <label class="officer-flag"><input type="checkbox" name="isOfficer" value="1" <%= officer ? 'checked' : '' %>> <%= fiscalYear %>年度役員</label>
            <label>所属班<select name="membershipDistrictGroupId" required><% districtGroups.forEach((group) => { %><option value="<%= group._id %>" <%= String(districtGroup?._id || '') === String(group._id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label>
            <label>役職<select name="roleId"><option value="">役職なし</option><% roles.forEach((role) => { %><option value="<%= role._id %>" <%= String(officer?.role?._id || officer?.role || '') === String(role._id) ? 'selected' : '' %>><%= role.name %></option><% }) %></select></label>
            <label>所属部<select name="departmentId"><option value="">所属部なし</option><% departments.forEach((department) => { %><option value="<%= department._id %>" <%= String(officer?.department?._id || officer?.department || '') === String(department._id) ? 'selected' : '' %>><%= department.name %></option><% }) %></select></label>
            <div class="form-actions"><button type="button" class="button button-quiet" data-close-officer-dialog>キャンセル</button><button class="button button-primary">設定を保存</button></div>
          </form>
          </dialog>
        </article>
      <% }) %>
      <% if (!people.length) { %><p class="help-text annual-group-empty"><%= empty %></p><% } %>
    </div></section>
    <% }) %>
    <p id="officer-search-empty" class="help-text" hidden>条件に一致する世帯主はいません。</p>
  </section>
  <section class="content-card management-card annual-leader-admin-panel" data-annual-panel="leaders">
    <h2>班長の設定</h2><p class="help-text">班長を先に登録し、必要に応じて町内会の会員を紐付けます。</p><button type="button" class="button button-primary" data-open-new-leader>新規登録</button>
    <dialog class="officer-dialog" id="new-leader-dialog"><div class="dialog-heading"><h3>班長を新規登録</h3><button type="button" class="dialog-close" data-close-new-leader>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/leaders/create" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><label>地区・班<select name="districtGroupId" required><option value="">選択してください</option><% districtGroups.forEach((group) => { %><option value="<%= group._id %>"><%= group.name %></option><% }) %></select></label><label>氏名<input name="name" required></label><label>氏名よみ<input name="nameKana" required></label><label>電話番号<input name="phone" type="tel"></label><label>携帯電話番号<input name="mobilePhone" type="tel"></label><div class="form-actions"><button class="button button-primary">登録</button></div></form></dialog>
    <h3>班長一覧</h3><div class="annual-officer-record-list"><% (leaderRecords || []).forEach((leader) => { %><article><div><strong><%= leader.name || leader.representative?.displayname || '氏名未登録' %></strong><span><%= leader.districtGroup?.name || '地区・班未設定' %></span><small><%= leader.nameKana || '' %>　<%= leader.phone || '' %>　<%= leader.mobilePhone || '' %></small><small><%= leader.representative ? `紐付け済み：${leader.representative.displayname || leader.representative.username || leader.representative.email}` : '会員未紐付け' %></small></div><div><button type="button" class="button button-quiet" data-open-leader-link="leader-link-<%= leader._id %>">会員を紐付け</button><form method="post" action="/associations/<%= association._id %>/manage/annual/leaders/<%= leader._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">削除</button></form></div></article><dialog class="officer-dialog" id="leader-link-<%= leader._id %>"><div class="dialog-heading"><div><h3>会員を紐付け</h3><p class="selected-officer-summary"><%= leader.name || '氏名未登録' %> ／ <%= leader.districtGroup?.name || '地区・班未設定' %></p></div><button type="button" class="dialog-close" data-close-leader-link>×</button></div><label class="resident-search">名前・メールアドレスで検索<input type="search" data-leader-link-search="<%= leader._id %>"></label><div data-leader-link-results="<%= leader._id %>"><% (leaderCandidates || []).forEach((candidate) => { %><form method="post" action="/associations/<%= association._id %>/manage/leaders/<%= leader._id %>/link" data-leader-link-candidate data-search="<%= [candidate.name, candidate.email].join(' ') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= candidate._id %>"><button class="resident-row-button"><strong><%= candidate.name %></strong><span><%= candidate.email %></span></button></form><% }) %></div></dialog><% }) %></div>
  </section>
  <section class="content-card management-card" data-annual-panel="legacy-leaders" hidden>
    <h2>世帯主から班長を選定・設定</h2><p class="help-text">氏名、メールアドレス、住所、班で絞り込み、班長フラグと担当班を設定します。</p>
    <label class="resident-search">世帯主を絞り込む<input type="search" id="leader-resident-search" placeholder="氏名・班・メール・住所を入力" autocomplete="off"></label>
    <% const leaderGroups = [{ title: '班長候補の世帯主', people: representatives.filter((item) => !item.leaderAssignment), empty: '選定できる世帯主はいません。' }, { title: '選定済みの班長', people: representatives.filter((item) => item.leaderAssignment), empty: '選定済みの班長はいません。' }]; %>
    <% leaderGroups.forEach(({ title, people, empty }) => { %>
    <section class="annual-candidate-group"><div class="annual-candidate-heading"><h3><%= title %></h3><span class="status-badge"><%= people.length %>人</span></div>
    <div class="resident-selection-list">
      <% people.forEach(({ user, household, districtGroup, residentProfile, leaderAssignment, attributeTags }) => { const residentName = residentProfile?.name || user.displayname || user.username; const residentEmail = user.email || residentProfile?.email || ''; const residentAddress = `〒${household.address?.postalCode || '—'} ${household.address?.street || ''} ${household.address?.building || ''}`; const searchText = [residentName, user.username, residentEmail, districtGroup?.name, residentAddress, ...(attributeTags || [])].filter(Boolean).join(' '); %>
        <article class="resident-row" data-leader-row data-search="<%= searchText %>"><button type="button" class="resident-row-button" data-open-leader-dialog="leader-dialog-<%= user._id %>"><% if (user.avatar) { %><img class="profile-avatar resident-avatar" src="<%= user.avatar %>" alt=""><% } else { %><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%= residentName.charAt(0) %></span><% } %><strong><%= residentName %>さん</strong><span class="resident-tags"><span class="status-badge"><%= districtGroup?.name || '班未設定' %></span><% (attributeTags || []).forEach((tag) => { %><span class="status-badge member-attribute-tag"><%= tag %></span><% }) %></span><span><%= residentEmail || 'メール未登録' %></span><span class="resident-address"><%= residentAddress %></span></button>
          <dialog class="officer-dialog" id="leader-dialog-<%= user._id %>"><div class="dialog-heading"><div><p class="eyebrow"><%= fiscalYear %>年度</p><h3><%= residentName %>さんの班長設定</h3></div><button type="button" class="dialog-close" data-close-leader-dialog>×</button></div><form class="resident-officer-form" action="/associations/<%= association._id %>/manage/leaders/configure" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><input type="hidden" name="userId" value="<%= user._id %>"><label class="officer-flag"><input type="checkbox" name="isLeader" value="1" <%= leaderAssignment ? 'checked' : '' %>> <%= fiscalYear %>年度班長</label><label>所属班<select name="membershipDistrictGroupId" required><% districtGroups.forEach((group) => { %><option value="<%= group._id %>" <%= String(districtGroup?._id || '') === String(group._id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label><label>班長の担当班<select name="districtGroupId"><option value="">班を選択</option><% districtGroups.forEach((group) => { %><option value="<%= group._id %>" <%= String(leaderAssignment?.districtGroup?._id || leaderAssignment?.districtGroup || districtGroup?._id || '') === String(group._id) ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-leader-dialog>キャンセル</button><button class="button button-primary">設定を保存</button></div></form></dialog>
        </article>
      <% }) %>
      <% if (!people.length) { %><p class="help-text annual-group-empty"><%= empty %></p><% } %>
    </div></section>
    <% }) %>
    <p id="leader-search-empty" class="help-text" hidden>条件に一致する世帯主はいません。</p>
  </section>
  <script>(()=>{const tabs=[...document.querySelectorAll('[data-annual-tab]')],panels=[...document.querySelectorAll('[data-annual-panel]')],key='annual-settings-tab:<%= association._id %>';const select=(value)=>{tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.annualTab===value)));panels.forEach(p=>p.hidden=p.dataset.annualPanel!==value);localStorage.setItem(key,value)};tabs.forEach(t=>t.addEventListener('click',()=>select(t.dataset.annualTab)));select(localStorage.getItem(key)||'officers');const normalize=value=>String(value||'').normalize('NFKC').toLocaleLowerCase('ja'),setupFilter=(inputId,rowSelector,emptyId)=>{const search=document.getElementById(inputId),rows=[...document.querySelectorAll(rowSelector)],empty=document.getElementById(emptyId),filter=()=>{const terms=normalize(search?.value).trim().split(/\s+/).filter(Boolean);let visible=0;rows.forEach(row=>{const match=terms.every(term=>normalize(row.dataset.search).includes(term));row.hidden=!match;if(match)visible++});document.querySelectorAll(`[data-annual-panel="${inputId.startsWith('officer')?'officers':'leaders'}"] .annual-candidate-group`).forEach(group=>{group.hidden=terms.length>0&&![...group.querySelectorAll(rowSelector)].some(row=>!row.hidden)});if(empty)empty.hidden=!terms.length||visible>0};search?.addEventListener('input',filter);filter()};setupFilter('officer-resident-search','[data-resident-row]','officer-search-empty');setupFilter('leader-resident-search','[data-leader-row]','leader-search-empty');document.querySelectorAll('[data-open-officer-dialog]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.openOfficerDialog)?.showModal()));document.querySelectorAll('[data-open-leader-dialog]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.openLeaderDialog)?.showModal()));document.querySelectorAll('[data-close-officer-dialog],[data-close-leader-dialog]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));document.querySelectorAll('.officer-dialog').forEach(dialog=>dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()}))})();</script>
  <script>
    const officerPanel = document.querySelector('.annual-officer-admin-panel');
    const copyHeading = [...(officerPanel?.querySelectorAll('h3') || [])].find((heading) => heading.textContent.includes('次年度へコピー'));
    const copyForm = copyHeading?.nextElementSibling;
    const tabs = document.querySelector('.management-tabs');
    if (copyHeading && copyForm) {
      copyHeading.remove();
      const dialog = document.createElement('dialog'); dialog.className = 'officer-dialog annual-copy-dialog'; dialog.id = 'annual-copy-dialog';
      dialog.innerHTML = '<div class="dialog-heading"><h3>年度設定の複製</h3><button type="button" class="dialog-close" data-close-copy-dialog>×</button></div>';
      dialog.append(copyForm); document.querySelector('.annual-heading')?.append(dialog);
      const button = document.createElement('button'); button.type = 'button'; button.className = 'button button-primary annual-copy-button'; button.textContent = '年度設定の複製';
      button.addEventListener('click', () => dialog.showModal()); document.querySelector('.year-selector')?.after(button);
      dialog.querySelector('[data-close-copy-dialog]')?.addEventListener('click', () => dialog.close());
    }
    document.querySelector('[data-open-new-officer]')?.addEventListener('click', () => document.getElementById('new-officer-dialog')?.showModal());
    document.querySelector('[data-close-new-officer]')?.addEventListener('click', () => document.getElementById('new-officer-dialog')?.close());
    document.querySelector('[data-open-new-leader]')?.addEventListener('click', () => document.getElementById('new-leader-dialog')?.showModal());
    document.querySelector('[data-close-new-leader]')?.addEventListener('click', () => document.getElementById('new-leader-dialog')?.close());
    const leaderDistricts = <%- JSON.stringify(typeof leaderDistricts !== 'undefined' ? leaderDistricts : []) %>;
    const leaderDistrictSelect = document.querySelector('#new-leader-dialog select[name="districtGroupId"]');
    if (leaderDistrictSelect) {
      const hidden = leaderDistrictSelect, label = hidden.closest('label');
      hidden.type = 'hidden'; hidden.style.display = 'none';
      const district = document.createElement('select'), group = document.createElement('select');
      district.required = true; district.innerHTML = '<option value="">地区を選択してください</option>' + leaderDistricts.map((item) => `<option value="${item._id}">${item.name}</option>`).join('');
      group.innerHTML = '<option value="">班を選択してください</option>';
      const groupLabel = document.createElement('label'); groupLabel.textContent = '班'; groupLabel.append(group); label.after(groupLabel); label.querySelector('span')?.remove(); label.append(district);
      const updateGroups = () => { const item = leaderDistricts.find((districtItem) => String(districtItem._id) === String(district.value)); group.innerHTML = item?.groups?.length ? '<option value="">班を選択してください</option>' + item.groups.map((child) => `<option value="${child._id}">${child.name.replace(item.name, '')}</option>`).join('') : '<option value="">地区全体</option>'; hidden.value = item?.groups?.length ? group.value : (item?._id || ''); };
      district.addEventListener('change', updateGroups); group.addEventListener('change', () => { hidden.value = group.value || district.value; });
    }
    const officerDistrictSelect = document.querySelector('#new-officer-dialog select[name="districtGroupId"]');
    if (officerDistrictSelect) {
      const hidden = officerDistrictSelect, label = hidden.closest('label'); hidden.type = 'hidden'; hidden.style.display = 'none';
      const district = document.createElement('select'), group = document.createElement('select');
      district.required = true; district.innerHTML = '<option value="">地区を選択してください</option>' + leaderDistricts.map((item) => `<option value="${item._id}">${item.name}</option>`).join('');
      group.innerHTML = '<option value="">班を選択してください</option>';
      const groupLabel = document.createElement('label'); groupLabel.textContent = '班'; groupLabel.append(group); label.after(groupLabel); label.append(district);
      const updateGroups = () => { const item = leaderDistricts.find((districtItem) => String(districtItem._id) === String(district.value)); group.innerHTML = item?.groups?.length ? '<option value="">班を選択してください</option>' + item.groups.map((child) => `<option value="${child._id}">${child.name.replace(item.name, '')}</option>`).join('') : '<option value="">地区全体</option>'; hidden.value = item?.groups?.length ? group.value : (item?._id || ''); };
      district.addEventListener('change', updateGroups); group.addEventListener('change', () => { hidden.value = group.value || district.value; });
    }
    document.querySelectorAll('[data-open-leader-link]').forEach((button) => button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.openLeaderLink); const summary = dialog?.querySelector('.selected-officer-summary'); const search = dialog?.querySelector('.resident-search'); if (summary && search) search.before(summary); dialog?.showModal(); }));
    document.querySelectorAll('[data-close-leader-link]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    document.querySelectorAll('[data-leader-link-search]').forEach((input) => input.addEventListener('input', () => { const q = input.value.normalize('NFKC').toLocaleLowerCase('ja'); document.querySelectorAll(`[data-leader-link-results="${input.dataset.leaderLinkSearch}"] [data-leader-link-candidate]`).forEach((row) => { row.hidden = !row.dataset.search.normalize('NFKC').toLocaleLowerCase('ja').includes(q); }); }));
    document.querySelectorAll('[data-open-link-dialog]').forEach((button) => button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.openLinkDialog); const article = button.closest('article'); if (dialog && article) { let summary = dialog.querySelector('.selected-officer-summary'); if (!summary) { summary = document.createElement('p'); summary.className = 'selected-officer-summary'; } summary.textContent = `${article.querySelector('strong')?.textContent || ''}さんを紐づける`; const search = dialog.querySelector('.resident-search'); search?.before(summary); } dialog?.showModal(); }));
    document.querySelectorAll('[data-close-link-dialog]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
    document.querySelectorAll('[data-link-search]').forEach((input) => input.addEventListener('input', () => {
      const q = input.value.normalize('NFKC').toLocaleLowerCase('ja');
      document.querySelectorAll(`[data-link-results="${input.dataset.linkSearch}"] [data-link-candidate]`).forEach((row) => { row.hidden = !row.dataset.search.normalize('NFKC').toLocaleLowerCase('ja').includes(q); });
    }));
    document.querySelectorAll('.annual-officer-record-list > article').forEach((article) => {
      const linked = [...article.querySelectorAll('small')].find((item) => item.textContent.includes('紐付け済み'));
      const actions = article.querySelector(':scope > div:last-of-type');
      const linkButton = actions?.querySelector('[data-open-link-dialog], [data-open-leader-link]');
      if (linked && actions && linkButton) { const tag = document.createElement('span'); tag.className = 'member-linked-tag'; tag.textContent = linked.textContent.trim().replace(/^紐付け済み：?\s*/, ''); actions.insertBefore(tag, linkButton); linkButton.classList.add('is-linked'); linked.remove(); }
    });
  </script>
</main>
