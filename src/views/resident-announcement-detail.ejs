<%- include('partials/head') %>
<%- include('partials/header') %>
<% const isNetwork = typeof networkMode !== 'undefined' && networkMode; const isDistrict = typeof districtMode !== 'undefined' && districtMode; const inboxBase = isDistrict ? `/associations/${associationId}/district-messages/inbox` : isNetwork ? `/associations/${associationId}/officer-network/inbox` : `/associations/${associationId}/announcements`; %>
<main class="page-shell communication-theme page-narrow">
  <a class="back-link" href="<%= inboxBase %>">← 届いた連絡へ戻る</a>
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <section class="content-card announcement-card"><p class="eyebrow"><%= isDistrict ? '班内の連絡' : isNetwork ? '役員間の連絡' : '町内会役員から住人への連絡' %> ・ <%= isDistrict ? '班員宛て' : isNetwork ? '役員宛て' : announcement.audience === 'leaders' ? (announcement.targetDistrictGroups?.length ? '指定地区・班の班長宛て' : '班長宛て') : (announcement.targetDistrictGroups?.length ? '指定地区・班の住人宛て' : '全住人宛て') %></p><small class="announcement-date"><%= new Date(announcement.editedAt || announcement.createdAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %><%= announcement.editedAt ? ' ・ 編集済み' : '' %></small><div class="announcement-title-row"><h1><%= announcement.title %></h1><p class="announcement-stars" aria-label="緊急度 <%= announcement.urgency %> / 5<%= announcement.urgency === 5 ? ' 緊急' : '' %>"><%= '★'.repeat(announcement.urgency) %><span><%= '☆'.repeat(5 - announcement.urgency) %></span><% if (announcement.urgency === 5) { %> 緊急<% } %></p></div><p class="body-copy"><%= announcement.body %></p>
    <%- include('partials/announcement-attachments', { announcement }) %>
    <% if (!isDistrict && !isNetwork) { %><form action="<%= inboxBase %>/<%= announcement._id %>/pin" method="post" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="pinned" value="<%= receipt.pinnedAt ? '0' : '1' %>"><button class="<%= receipt.pinnedAt ? 'notification-pin-icon' : 'button button-quiet' %>" type="submit" aria-label="<%= receipt.pinnedAt ? 'ピン留めを外す' : 'ホームのお知らせにピン留め' %>" title="<%= receipt.pinnedAt ? 'ピン留めを外す' : 'ホームのお知らせにピン留め' %>" aria-pressed="<%= Boolean(receipt.pinnedAt) %>"><% if (receipt.pinnedAt) { %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m16 3 5 5-4 1-3 5 1 3-2 2-4-4-6 6-1-1 6-6-4-4 2-2 3 1 5-3z"/></svg><% } else { %>ホームのお知らせにピン留め<% } %></button></form><% } %>
    <form class="form-stack announcement-confirm" action="<%= inboxBase %>/<%= announcement._id %>/confirm" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (announcement.responseMode !== 'none') { %><fieldset><legend>回答を選択（<%= announcement.responseMode === 'single' ? '1つ' : '複数可' %>）</legend><% announcement.options.forEach((option, index) => { %><label class="announcement-option"><input type="<%= announcement.responseMode === 'single' ? 'radio' : 'checkbox' %>" name="selectedOptions" value="<%= index %>" <%= (receipt.selectedOptions || []).includes(index) ? 'checked' : '' %>><span><%= option %></span></label><% }) %></fieldset><% } %>
      <div class="form-actions"><button class="button <%= receipt.readAt && announcement.responseMode === 'none' ? 'button-quiet' : 'button-primary' %>" type="submit" <%= receipt.readAt && announcement.responseMode === 'none' ? 'disabled' : '' %>><%= receipt.readAt ? announcement.responseMode === 'none' ? '確認済み' : '回答を更新' : announcement.responseMode === 'none' ? '確認済みにする' : '回答して確認済みにする' %></button></div>
    </form>
  </section>
</main>
<%- include('partials/foot') %>
