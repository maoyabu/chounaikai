<%- include('partials/head') %><%- include('partials/header') %><% const startMonth=Number(association.financeFiscalStartMonth||4); const endMonth=startMonth===1?12:startMonth-1; const endYear=startMonth===1?year:year+1; %><main class="page-shell finance-shell"><a class="back-link" href="/associations/<%= association._id %>/manage">← 町内会管理へ戻る</a><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>町内会会計管理</h1><p><%= year %>年度の収支と予算進捗を確認できます。</p></div><a class="button button-primary" href="/associations/<%= association._id %>/finance/entries/new">新規登録</a></div><div class="finance-summary-grid"><section class="content-card"><div class="finance-card-heading"><div><h2>年度集計</h2><p class="finance-period">期間：<%= year %>年<%= startMonth %>月　〜　<%= endYear %>年<%= endMonth %>月</p></div><form class="finance-dashboard-year-selector" method="get"><select name="year" onchange="this.form.submit()"><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { %><option value="<%= fiscal %>" <%= Number(year) === fiscal ? 'selected' : '' %>><%= fiscal %>年度</option><% } %></select></form></div><div class="finance-total-row finance-total-income"><span>収入</span><strong>¥<%= (totals['収入']||0).toLocaleString() %></strong></div><div class="finance-total-row finance-total-expense"><span>支出</span><strong>¥<%= (totals['支出']||0).toLocaleString() %></strong></div><nav class="finance-inline-menu"><a class="settings-entry-card" href="/associations/<%= association._id %>/finance/entries"><strong>入力一覧</strong><span>会計データの検索・確認・編集</span></a><a class="settings-entry-card" href="/associations/<%= association._id %>/finance/annual"><strong>年度集計</strong><span>月別・項目別の予算と実績を確認</span></a><a class="settings-entry-card" href="/associations/<%= association._id %>/finance/expense-chart"><strong>支出項目別グラフ</strong><span>年度別の支出項目を比較</span></a><a class="settings-entry-card" href="/associations/<%= association._id %>/finance/monthly-expense-chart"><strong>月別支出項目別グラフ</strong><span>複数年度の月別支出を比較</span></a></nav></section><section class="content-card"><h2>予算項目別の進捗</h2><% ['収入','支出'].forEach(type=>{ %><h3 class="finance-progress-heading <%= type==='収入'?'finance-income-heading':'finance-expense-heading' %>"><%= type %></h3><% budgetItems.filter(item=>item.cf===type).forEach(item=>{ %><div class="finance-progress <%= type==='収入'?'finance-progress-income':'finance-progress-expense' %>"><div><span><%= item.name %></span><small>¥<%= item.actual.toLocaleString() %> / ¥<%= Number(item.budget).toLocaleString() %></small></div><progress max="100" value="<%= Math.min(item.rate,100) %>"></progress></div><% }) %><% }) %></section></div></main><%- include('partials/foot') %>
