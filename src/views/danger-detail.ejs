<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a href="/dashboard">← ホーム</a><section class="content-card danger-section"><p class="eyebrow">緊急・危険情報 · <%= association.name %></p><h1><%= report.title %></h1><p><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %> · <%= report.author?.displayname || '退会した住人' %></p><img class="danger-photo" src="/associations/<%= association._id %>/dangers/<%= report._id %>/photo" alt="現場の写真"><p class="danger-body"><%= report.body %></p><%- include('partials/danger-place', { report }) %><p><a class="button button-quiet" href="/associations/<%= association._id %>/dangers">緊急・危険情報の地図・履歴を見る</a></p><%- include('partials/danger-delete', { canDelete: typeof canDelete !== 'undefined' && canDelete, association, report }) %></section></main><%- include('partials/foot') %>