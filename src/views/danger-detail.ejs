<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a href="/dashboard">← ホーム</a><section class="content-card danger-section"><p class="eyebrow">緊急・危険情報 · <%= association.name %></p><h1><%= report.title %></h1><p><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %> · <%= report.author?.displayname || '退会した住人' %></p><img class="danger-photo" src="/associations/<%= association._id %>/dangers/<%= report._id %>/photo" alt="現場の写真"><p class="danger-body"><%= report.body %></p><h2><%= report.locationSource === 'photo' ? '写真の撮影場所' : '投稿時の現在地' %></h2><iframe class="danger-map" title="撮影場所のGoogleマップ" src="https://www.google.com/maps?q=<%= report.latitude %>,<%= report.longitude %>&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><p><% if (report.locationSource !== 'photo') { %>位置精度：約<%= Math.round(report.accuracy) %>m · <% } %>取得日時：<%= report.locatedAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></p><a href="https://www.google.com/maps/search/?api=1&amp;query=<%= report.latitude %>,<%= report.longitude %>" target="_blank" rel="noopener noreferrer">Googleマップで開く</a><p><a class="button button-quiet" href="/associations/<%= association._id %>/dangers">緊急・危険情報の地図・履歴を見る</a></p></section></main><%- include('partials/foot') %>