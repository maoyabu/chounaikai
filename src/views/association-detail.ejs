<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell association-detail-shell association-public-page">
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <a class="back-link" href="<%= currentUser.isAdmin ? '/admin' : '/dashboard' %>">← <%= currentUser.isAdmin ? '管理者メニュー' : 'ホーム' %>へ戻る</a>
  <% if (canManage) { %><div class="association-manage-link"><a class="button button-primary" href="/associations/<%= association._id %>/manage">町内会を管理する</a></div><% } %>
  <% if (typeof pageData !== 'undefined' && pageData) { %><%- include('partials/association-page-content', { ...pageData, isResidentPage: true, calendarPath: `/associations/${association._id}` }) %><% } else { %><section class="content-card association-public-introduction"><h1><%= association.name %></h1><p class="body-copy"><%= association.introduction || 'ご案内は準備中です。' %></p></section><% } %>
  <% if (currentUser.isAdmin) { %><section class="content-card admin-operation-card"><p class="eyebrow">システム管理操作</p><h2>承認・表示・削除</h2><div class="admin-operation-actions"><% if (association.status === 'pending' && !association.deletedAt) { %><form action="/admin/associations/<%= association._id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" type="submit">申請を承認する</button></form><% } %><% if (association.deletedAt) { %><form action="/admin/associations/<%= association._id %>/restore" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" type="submit">再表示する</button></form><% } else { %><form action="/admin/associations/<%= association._id %>/delete" method="post" onsubmit="return confirm('町内会を一覧や利用者画面から非表示にしますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="deleteMode" value="hidden"><button class="button button-danger" type="submit">非表示にする</button></form><% } %><form action="/admin/associations/<%= association._id %>/delete" method="post" onsubmit="return confirm('関連する所属・役職・世帯等も完全に削除され、元に戻せません。本当に削除しますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="deleteMode" value="permanent"><button class="button button-danger-outline" type="submit">完全に削除する</button></form></div><p class="help-text">「非表示」はデータと監査履歴を保持し、後から再表示できます。「完全に削除」は関連データを含めて元に戻せません。</p></section><% } %>
</main>
<%- include('partials/foot') %>
