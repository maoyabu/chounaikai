<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell">
  <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
  <a class="back-link" href="/dashboard">← ホームへ戻る</a>
  <section class="page-heading"><div><p class="eyebrow">世帯代表者</p><h1><%= household.association?.name %> 世帯情報</h1><p><%= household.districtGroup?.name %>・<%= application?.status === 'pending' ? '班長の承認待ち' : membership ? '参加中' : '申請状況を確認してください' %></p></div></section>
  <% if (application?.status === 'rejected') { %><div class="alert alert-error">申請は拒否されました。<%= application.rejectionReason ? `理由：${application.rejectionReason}` : '' %></div><% } %>
  <section class="content-card management-card"><h2>世帯情報</h2><form class="form-stack" action="/associations/<%= household.association._id %>/household/<%= household._id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-columns"><label>郵便番号<input name="postalCode" value="<%= household.address.postalCode %>" required></label><label>電話番号（任意）<input name="phone" value="<%= household.phone || '' %>"></label></div><label>住所<input name="street" value="<%= household.address.street %>" required></label><label>建物名など<input name="building" value="<%= household.address.building || '' %>"></label><div class="form-actions"><button class="button button-primary">世帯情報を更新</button></div></form></section>
  <section class="content-card management-card"><h2>同一世帯のメンバー</h2><div class="household-member-list"><% members.forEach((member) => { %><article><form class="form-stack" action="/associations/<%= household.association._id %>/household/<%= household._id %>/members/<%= member._id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="member-heading"><strong><%= member.isRepresentative ? '世帯代表者' : '世帯メンバー' %></strong><% if (!member.isRepresentative) { %><span><%= member.relationship || '' %></span><% } %></div><div class="form-columns"><label>氏名<input name="name" value="<%= member.name %>" required></label><label>氏名（よみ）<input name="nameKana" value="<%= member.nameKana %>" required></label></div><div class="form-columns"><label>生年月日<input type="date" name="birthDate" value="<%= member.birthDate ? new Date(member.birthDate).toISOString().slice(0,10) : '' %>" required></label><label>性別<select name="gender"><option value="unspecified" <%= member.gender === 'unspecified' ? 'selected' : '' %>>回答しない</option><option value="male" <%= member.gender === 'male' ? 'selected' : '' %>>男性</option><option value="female" <%= member.gender === 'female' ? 'selected' : '' %>>女性</option><option value="other" <%= member.gender === 'other' ? 'selected' : '' %>>その他</option></select></label></div><div class="form-columns"><label>メール（任意）<input type="email" name="email" value="<%= member.email || '' %>"></label><label>LINE（任意）<input name="lineAccount" value="<%= member.lineAccount || '' %>"></label></div><% if (!member.isRepresentative) { %><label>続柄<input name="relationship" value="<%= member.relationship || '' %>"></label><% } %><div class="form-actions"><button class="button button-quiet">更新</button></div></form><% if (!member.isRepresentative) { %><form action="/associations/<%= household.association._id %>/household/<%= household._id %>/members/<%= member._id %>/delete" method="post" onsubmit="return confirm('この世帯メンバーを削除しますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger">削除</button></form><% } %></article><% }) %></div></section>
  <section class="content-card management-card"><h2>世帯メンバーを追加</h2><form class="form-stack" action="/associations/<%= household.association._id %>/household/<%= household._id %>/members" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-columns"><label>氏名<input name="name" required></label><label>氏名（よみ）<input name="nameKana" required></label></div><div class="form-columns"><label>生年月日<input type="date" name="birthDate" required></label><label>性別<select name="gender"><option value="unspecified">回答しない</option><option value="male">男性</option><option value="female">女性</option><option value="other">その他</option></select></label></div><div class="form-columns"><label>メール（任意）<input type="email" name="email"></label><label>LINE（任意）<input name="lineAccount"></label></div><label>続柄<input name="relationship"></label><div class="form-actions"><button class="button button-primary">追加する</button></div></form></section>
</main>
<%- include('partials/foot') %>
