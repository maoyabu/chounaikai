<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell communication-theme group-communication-theme"><a class="back-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/messages">← グループ内の連絡へ戻る</a><section class="page-heading"><p class="eyebrow"><%= group.name %></p><h1>届いたグループの連絡</h1></section><section class="content-card"><div class="question-home-list"><% if (!receipts.length) { %><p class="help-text">届いた連絡はありません。</p><% } %><% receipts.forEach(item => { %><article class="question-home-link <%= item.readAt ? '' : 'notification-item-unread' %>"><span><strong><%= item.announcement.title %></strong><small><%= new Date(item.announcement.createdAt).toLocaleString('ja-JP') %></small><small><%= item.announcement.body %></small></span></article><% }) %></div></section></main><%- include('partials/foot') %>
