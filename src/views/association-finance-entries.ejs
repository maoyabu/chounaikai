<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell finance-shell">
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %><a class="back-link" href="/associations/<%= association._id %>/finance">← 会計管理トップへ戻る</a><div class="page-heading finance-entries-heading"><div><p class="eyebrow"><%= association.name %></p><h1>会計入力一覧</h1></div><div class="form-actions finance-entries-heading-actions"><a class="button button-primary" data-finance-entry-modal href="/associations/<%= association._id %>/finance/entries/new">新規登録</a><a class="button button-blue" href="/associations/<%= association._id %>/finance/entries/export?<%= exportQuery %>">Excel出力</a></div></div><details class="finance-filter-accordion content-card"><summary>絞り込み</summary><form class="finance-filter" method="get"><select name="cf" id="finance-filter-cf"><option value="">収支区分すべて</option><option value="収入" <%= filters.cf === '収入' ? 'selected' : '' %>>収入</option><option value="支出" <%= filters.cf === '支出' ? 'selected' : '' %>>支出</option></select><select name="item" id="finance-filter-item" data-selected="<%= filters.item || '' %>"><option value="">小区分すべて</option></select><select name="payment_type"><option value="">支払い種別すべて</option><% (filterPaymentTypes || []).forEach(type => { %><option value="<%= type %>" <%= filters.payment_type === type ? 'selected' : '' %>><%= type %></option><% }) %></select><input name="keyword" value="<%= filters.keyword || '' %>" placeholder="フリーワード"><input type="date" name="from" value="<%= filters.from || '' %>"><span>〜</span><input type="date" name="to" value="<%= filters.to || '' %>"><button class="button button-primary">検索</button></form></details><section class="content-card"><p class="help-text" id="finance-entry-operation-help">項目を長押しすると編集・削除を選べます（パソコンでは右クリック、または項目を選択してEnter）。</p><div class="finance-entry-list" aria-describedby="finance-entry-operation-help"><% if (!entries.length) { %><p class="help-text">該当する会計データはありません。</p><% } else { entries.forEach(entry => { %><article data-finance-entry-row tabindex="0" aria-haspopup="dialog" aria-label="会計データの操作：<%= entry.content || (entry.cf === '支出' ? entry.expense_item : entry.income_item) || entry.cf %>" data-edit-url="/associations/<%= association._id %>/finance/entries/<%= entry._id %>/edit" data-delete-url="/associations/<%= association._id %>/finance/entries/<%= entry._id %>/delete"><time class="finance-entry-date"><span><%= new Date(entry.date).getFullYear() %>年</span><span><%= new Date(entry.date).getMonth() + 1 %>/<%= new Date(entry.date).getDate() %></span></time><span class="finance-entry-description"><%- include('partials/finance-entry-title', { entry }) %><small><%= entry.content || '' %><% if (entry.cf === '支出' && entry.payment_type) { %> ・ <%= entry.payment_type %><% } %> ・ 使用者：<%= entry.usedBy || entry.inputterName || '' %></small></span><strong class="<%= entry.cf === '支出' ? 'finance-expense' : 'finance-income' %>">¥<%= Number(entry.amount).toLocaleString() %></strong></article><% }) } %></div></section></main>
<dialog class="finance-entry-operation-dialog" aria-labelledby="finance-entry-operation-title">
  <h2 id="finance-entry-operation-title">会計データの操作</h2>
  <p data-finance-operation-description></p>
  <div class="form-actions">
    <a class="button button-primary" data-finance-operation-edit data-finance-entry-modal>編集</a>
    <button type="button" class="button button-danger-outline" data-finance-operation-delete>削除</button>
    <button type="button" class="button button-quiet" data-finance-operation-close>閉じる</button>
  </div>
</dialog>
<dialog class="finance-entry-delete-dialog" aria-labelledby="finance-entry-delete-title">
  <h2 id="finance-entry-delete-title">この会計データを削除しますか？</h2>
  <p data-finance-delete-description></p><p>削除すると元に戻せません。</p>
  <form method="post" data-finance-delete-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-actions"><button type="button" class="button button-quiet" data-finance-delete-cancel autofocus>キャンセル</button><button class="button button-danger-outline">削除する</button></div>
  </form>
</dialog>
<script src="/assets/finance-entry-list.js?v=<%= assetVersion %>"></script>
<script>(()=>{const cf=document.getElementById('finance-filter-cf'),item=document.getElementById('finance-filter-item'),selected=item.dataset.selected,items=<%- JSON.stringify(filterItemsByCf || {収入:[],支出:[]}) %>;const update=()=>{const values=items[cf.value]||[];item.innerHTML='<option value="">小区分すべて</option>'+values.map(value=>`<option value="${value}">${value}</option>`).join('');if(values.includes(selected))item.value=selected};cf.addEventListener('change',()=>{item.dataset.selected='';update()});update()})();</script><%- include('partials/finance-entry-modal') %><%- include('partials/foot') %>
