<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell finance-shell"><a class="back-link" href="/associations/<%= association._id %>/finance">← 会計管理トップへ戻る</a><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>会計入力一覧</h1></div><div class="form-actions"><a class="button button-primary" href="/associations/<%= association._id %>/finance/entries/new">新規登録</a><a class="button button-blue" href="/associations/<%= association._id %>/finance/entries/export?<%= exportQuery %>">Excel出力</a></div></div><form class="finance-filter content-card" method="get"><select name="cf" id="finance-filter-cf"><option value="">収支区分すべて</option><option value="収入" <%= filters.cf === '収入' ? 'selected' : '' %>>収入</option><option value="支出" <%= filters.cf === '支出' ? 'selected' : '' %>>支出</option></select><select name="item" id="finance-filter-item" data-selected="<%= filters.item || '' %>"><option value="">小区分すべて</option></select><select name="payment_type"><option value="">支払い種別すべて</option><% (filterPaymentTypes || []).forEach(type => { %><option value="<%= type %>" <%= filters.payment_type === type ? 'selected' : '' %>><%= type %></option><% }) %></select><input name="keyword" value="<%= filters.keyword || '' %>" placeholder="フリーワード"><input type="date" name="from" value="<%= filters.from || '' %>"><span>〜</span><input type="date" name="to" value="<%= filters.to || '' %>"><button class="button button-primary">検索</button></form><section class="content-card"><div class="finance-entry-list"><% if (!entries.length) { %><p class="help-text">該当する会計データはありません。</p><% } else { entries.forEach(entry => { %><article><span class="finance-entry-date"><%= new Date(entry.date).toLocaleDateString('ja-JP') %></span><span><strong><%= entry.cf === '支出' ? entry.expense_item : entry.income_item %></strong><small><%= entry.content || '' %> ・ <%= entry.payment_type %> ・ 使用者：<%= entry.usedBy || entry.inputterName || '' %></small></span><strong class="<%= entry.cf === '支出' ? 'finance-expense' : 'finance-income' %>">¥<%= Number(entry.amount).toLocaleString() %></strong><span class="finance-entry-actions"><a class="button button-quiet button-small" href="/associations/<%= association._id %>/finance/entries/<%= entry._id %>/edit">編集</a><form method="post" action="/associations/<%= association._id %>/finance/entries/<%= entry._id %>/delete" onsubmit="return confirm('この会計データを削除しますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline button-small">削除</button></form></span></article><% }) } %></div></section></main><script>(()=>{const cf=document.getElementById('finance-filter-cf'),item=document.getElementById('finance-filter-item'),selected=item.dataset.selected,items=<%- JSON.stringify(filterItemsByCf || {収入:[],支出:[]}) %>;const update=()=>{const values=items[cf.value]||[];item.innerHTML='<option value="">小区分すべて</option>'+values.map(value=>`<option value="${value}">${value}</option>`).join('');if(values.includes(selected))item.value=selected};cf.addEventListener('change',()=>{item.dataset.selected='';update()});update()})();</script><%- include('partials/foot') %>
