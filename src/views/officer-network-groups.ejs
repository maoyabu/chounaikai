<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell communication-theme question-box-shell">
  <a class="back-link" href="/associations/<%= association._id %>/officer-network">← 役員間の連絡網へ戻る</a>
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <section class="page-heading"><h1>役員グループ管理</h1></section>
  <section class="content-card announcement-card"><h2>新しいグループ</h2><form class="form-stack" action="/associations/<%= association._id %>/officer-network/groups" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>グループ名<input name="name" maxlength="80" required></label><fieldset class="officer-group-members"><legend>役員を選択</legend><% officers.forEach((item) => { %><label><input type="checkbox" name="members" value="<%= item.user._id %>"><%= item.user.displayname || item.user.username %><% if (item.department?.name) { %><small>（<%= item.department.name %>）</small><% } %></label><% }) %></fieldset><div class="form-actions"><button class="button button-primary" type="submit">グループを作成</button></div></form></section>
  <section class="admin-section question-home-section"><div class="section-heading"><h2>作成済みのグループ</h2></div>
    <% if (!groups.length) { %><div class="admin-empty"><p>グループはまだありません。</p></div><% } else { %><div class="officer-group-list"><% groups.forEach((group) => { const members = new Set(group.members.map(String)); %><details class="officer-group-item"><summary><strong><%= group.name %></strong><span class="status-badge"><%= group.members.length %>人</span></summary><div class="officer-group-editor"><form class="form-stack" action="/associations/<%= association._id %>/officer-network/groups/<%= group._id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>グループ名<input name="name" value="<%= group.name %>" maxlength="80" required></label><fieldset class="officer-group-members"><legend>役員を選択</legend><% officers.forEach((item) => { %><label><input type="checkbox" name="members" value="<%= item.user._id %>" <%= members.has(String(item.user._id)) ? 'checked' : '' %>><%= item.user.displayname || item.user.username %><% if (item.department?.name) { %><small>（<%= item.department.name %>）</small><% } %></label><% }) %></fieldset><div class="form-actions"><button class="button button-primary" type="submit">変更を保存</button></div></form><form action="/associations/<%= association._id %>/officer-network/groups/<%= group._id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline" type="submit">グループを削除</button></form></div></details><% }) %></div><% } %>
  </section>
</main>
<%- include('partials/foot') %>
