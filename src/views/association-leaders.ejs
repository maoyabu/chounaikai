<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell">
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a>
  <section class="page-heading annual-heading"><div><p class="eyebrow">班長一覧</p><h1><%= fiscalYear %>年度の班長一覧</h1></div><form class="year-selector"><label>表示年度<select name="year" onchange="this.form.submit()"><% for (let y = fiscalYear - 2; y <= fiscalYear + 2; y++) { %><option value="<%= y %>" <%= y === fiscalYear ? 'selected' : '' %>><%= y %>年度</option><% } %></select></label></form></section>
  <section class="content-card management-card"><label class="resident-search">班長を検索<input type="search" id="leader-directory-search" placeholder="氏名・地区・班・メールを入力"></label><div class="resident-selection-list">
    <% leaders.forEach((l) => { const name = l.name || l.representative?.displayname || l.representative?.username || '氏名未登録'; const district = l.districtGroup?.name || '地区・班未設定'; const email = l.representative?.email || ''; const address = l.address || l.household?.address?.street || ''; %>
    <article class="annual-directory-row" data-leader-directory-row data-search="<%= [name, district, email].join(' ') %>"><div class="resident-row-button resident-row-static" data-open-record="leader-<%= l._id %>"><strong><%= name %>さん</strong><span class="resident-tags"><span class="status-badge"><%= district %></span><span class="status-badge member-attribute-tag">班長</span></span><span><%= email || 'メール未登録' %></span><span class="resident-address"><%= address || '住所未登録' %></span><% if (l.phone || l.mobilePhone) { %><small><%= l.phone || '' %>　<%= l.mobilePhone || '' %></small><% } %><% if (l.representative) { %><small>会員：<%= l.representative.displayname || l.representative.username || l.representative.email %></small><% } %></div><dialog class="officer-dialog" id="leader-<%= l._id %>"><div class="dialog-heading"><h3>班長を編集</h3><button type="button" class="dialog-close">×</button></div><form method="post" action="/associations/<%= association._id %>/manage/annual/leaders/<%= l._id %>/update" class="resident-officer-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="leaders"><label>地区・班<input value="<%= district %>" readonly></label><label>氏名<input name="name" value="<%= l.name || '' %>" required></label><label>氏名よみ<input name="nameKana" value="<%= l.nameKana || '' %>" required></label><label>住所<input name="address" value="<%= l.address || '' %>"></label><label>電話番号<input name="phone" value="<%= l.phone || '' %>" type="tel"></label><label>携帯電話番号<input name="mobilePhone" value="<%= l.mobilePhone || '' %>" type="tel"></label><div class="form-actions"><button type="button" class="button button-quiet dialog-cancel">キャンセル</button><button class="button button-primary">保存</button></div></form></dialog></article>
    <% }) %>
  </div><p id="leader-directory-empty" hidden>条件に一致する班長はいません。</p></section>
  <script>(()=>{const q=document.getElementById('leader-directory-search'),rows=[...document.querySelectorAll('[data-leader-directory-row]')],norm=v=>String(v||'').normalize('NFKC').toLowerCase();q?.addEventListener('input',()=>rows.forEach(r=>r.hidden=!norm(r.dataset.search).includes(norm(q.value))));document.querySelectorAll('[data-open-record]').forEach(b=>b.addEventListener('click',()=>document.getElementById(b.dataset.openRecord)?.showModal()));document.querySelectorAll('.dialog-close,.dialog-cancel').forEach(b=>b.addEventListener('click',()=>b.closest('dialog')?.close()))})();</script>
</main><%- include('partials/foot') %>
