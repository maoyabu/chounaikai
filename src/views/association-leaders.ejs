<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><% if(notice){%><div class="alert alert-success"><%=notice%></div><%}%><a class="back-link" href="/associations/<%=association._id%>/manage">← 運営管理へ戻る</a><section class="page-heading annual-heading"><div><p class="eyebrow">班長一覧</p><h1><%=fiscalYear%>年度の班長一覧</h1><p>行を選択すると班長情報を編集できます。</p></div><form class="year-selector"><label>表示年度<select name="year" onchange="this.form.submit()"><%for(let y=fiscalYear-2;y<=fiscalYear+2;y++){%><option value="<%=y%>" <%=y===fiscalYear?'selected':''%>><%=y%>年度</option><%}%></select></label></form></section>
<section class="content-card management-card"><label class="resident-search">班長を検索<input type="search" id="leader-directory-search" placeholder="氏名・班・メール・住所を入力"></label><div class="resident-selection-list"><%leaders.forEach(l=>{const n=l.representative?.displayname||l.representative?.username||'退会済みユーザー',d=l.membership?.districtGroup?.name||'班未設定',e=l.representative?.email||'メール未登録',a=`〒${l.household?.address?.postalCode||'—'} ${l.household?.address?.street||''} ${l.household?.address?.building||''}`;%><article data-leader-directory-row data-search="<%=[n,d,e,a].join(' ')%>"><button type="button" class="resident-row-button" data-open-leader-dialog="ld-<%=l._id%>"><%if(l.representative?.avatar){%><img class="profile-avatar resident-avatar" src="<%=l.representative.avatar%>" alt=""><%}else{%><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%=n.charAt(0)%></span><%}%><strong><%=n%>さん</strong><span class="resident-tags"><span class="status-badge"><%=d%></span><span class="status-badge member-attribute-tag">班長</span></span><span><%=e%></span><span class="resident-address"><%=a%></span></button><dialog class="officer-dialog" id="ld-<%=l._id%>"><div class="dialog-heading"><h3><%=n%>さんの班長設定</h3><button type="button" class="dialog-close" data-close-leader-dialog>×</button></div><form class="resident-officer-form" action="/associations/<%=association._id%>/manage/leaders/configure" method="post"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="fiscalYear" value="<%=fiscalYear%>"><input type="hidden" name="userId" value="<%=l.representative?._id%>"><input type="hidden" name="returnTo" value="leaders"><label class="officer-flag"><input type="checkbox" name="isLeader" value="1" checked>年度班長</label><label>所属班<select name="membershipDistrictGroupId" required><%districtGroups.forEach(g=>{%><option value="<%=g._id%>" <%=String(l.membership?.districtGroup?._id||'')===String(g._id)?'selected':''%>><%=g.name%></option><%})%></select></label><label>班長の担当班<select name="districtGroupId" required><%districtGroups.forEach(g=>{%><option value="<%=g._id%>" <%=String(l.districtGroup?._id||'')===String(g._id)?'selected':''%>><%=g.name%></option><%})%></select></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-leader-dialog>キャンセル</button><button class="button button-primary">設定を保存</button></div></form></dialog></article><%})%></div><p id="leader-directory-empty" hidden>条件に一致する班長はいません。</p></section>
<script>(()=>{const q=document.getElementById('leader-directory-search'),rows=[...document.querySelectorAll('[data-leader-directory-row]')],norm=v=>String(v||'').normalize('NFKC').toLowerCase();q?.addEventListener('input',()=>rows.forEach(r=>r.hidden=!norm(r.dataset.search).includes(norm(q.value))));document.querySelectorAll('[data-open-leader-dialog]').forEach(b=>b.onclick=()=>document.getElementById(b.dataset.openLeaderDialog)?.showModal());document.querySelectorAll('[data-close-leader-dialog]').forEach(b=>b.onclick=()=>b.closest('dialog')?.close())})();</script></main><%- include('partials/foot') %>
