<%- include('partials/head') %><%- include('partials/header') %><% const editing = Boolean(entry); const selectedItem = entry?.expense_item || entry?.income_item || ''; %><main class="page-shell page-narrow finance-shell"><a class="back-link" href="/associations/<%= association._id %>/finance">← 会計管理トップへ戻る</a><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1><%= editing ? '会計を編集' : '会計を入力' %></h1><p><%= year %>年度</p></div></div><form class="form-card form-stack finance-entry-form" action="<%= editing ? `/associations/${association._id}/finance/entries/${entry._id}/update` : `/associations/${association._id}/finance/entries` %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>使用日<input type="date" name="date" value="<%= entry?.date ? new Date(entry.date).toISOString().slice(0,10) : '' %>" required></label><div class="finance-entry-category-inline"><label>収支区分<select name="cf" id="finance-entry-cf"><option value="支出" <%= entry?.cf === '支出' ? 'selected' : '' %>>支出</option><option value="収入" <%= entry?.cf === '収入' ? 'selected' : '' %>>収入</option></select></label><label><span id="finance-entry-item-label"><%= entry?.cf === '収入' ? '収入区分' : '支出区分' %></span><select name="item" id="finance-entry-item" data-selected="<%= selectedItem %>" required></select></label></div><label>内容<textarea name="content" rows="5" required><%= entry?.content || '' %></textarea></label><label class="finance-amount-label">金額<input class="finance-entry-amount" type="text" name="amount" value="<%= entry?.amount ? Number(entry.amount).toLocaleString('ja-JP') : '' %>" inputmode="numeric" required></label><div class="finance-entry-inline"><label>支払い種別<select name="payment_type"><% paymentMethods.forEach((method) => { %><option value="<%= method.name %>" <%= entry?.payment_type === method.name ? 'selected' : '' %>><%= method.name %></option><% }) %></select></label><label>領収書番号<input name="receiptNo" value="<%= entry?.receiptNo || '' %>"></label></div><div class="finance-entry-inline"><label>入力者<input value="<%= entry?.inputterName || currentUser.displayname || currentUser.username %>" readonly></label><label>使用者<input name="usedBy" value="<%= entry?.usedBy || '' %>" placeholder="未入力の場合は入力者"></label></div><label>メモ<textarea name="memo" rows="3"><%= entry?.memo || '' %></textarea></label><div class="form-actions"><% if (!editing) { %><button class="button button-primary" name="continue" value="1">保存して続けて入力</button><% } %><button class="button button-primary"><%= editing ? '更新' : '保存' %></button></div></form></main><script>(()=>{const budgets=<%- JSON.stringify(budgets.map(item=>({cf:item.cf,name:item.expense_item||item.income_item||''})).filter(item=>item.name)) %>,cf=document.getElementById('finance-entry-cf'),item=document.getElementById('finance-entry-item'),label=document.getElementById('finance-entry-item-label'),selected=item.dataset.selected,refresh=()=>{label.textContent=cf.value==='収入'?'収入区分':'支出区分';item.innerHTML=budgets.filter(row=>row.cf===cf.value).map(row=>`<option value="${row.name}" ${row.name===selected?'selected':''}>${row.name}</option>`).join('');selected='';};cf.addEventListener('change',refresh);refresh();const amount=document.querySelector('.finance-entry-amount');amount?.addEventListener('input',()=>{const value=amount.value.replace(/[^0-9]/g,'');amount.value=value?Number(value).toLocaleString('ja-JP'):''});document.querySelector('.finance-entry-form')?.addEventListener('submit',()=>{amount.value=amount.value.replace(/,/g,'')})})();</script><%- include('partials/foot') %>
