<%- include('partials/head') %><%- include('partials/header') %>
<% const editing = Boolean(entry); const selectedItem = entry?.expense_item || entry?.income_item || ''; %>
<main class="page-shell page-narrow finance-shell">
  <a class="back-link" href="/associations/<%= association._id %>/finance<%= editing ? '/entries' : '' %>">← <%= editing ? '入出金一覧へ戻る' : '会計管理トップへ戻る' %></a>
  <div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1><%= editing ? '会計を編集' : '会計を入力' %></h1><p><span id="finance-entry-fiscal-year"><%= year %></span>年度</p></div></div>
  <form class="form-card form-stack finance-entry-form" action="<%= editing ? `/associations/${association._id}/finance/entries/${entry._id}/update` : `/associations/${association._id}/finance/entries` %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>使用日<input type="date" name="date" value="<%= entry?.date ? new Date(entry.date).toISOString().slice(0,10) : '' %>" required></label>
    <div class="finance-entry-category-inline">
      <label>収支区分<select name="cf" id="finance-entry-cf"><option value="支出" <%= entry?.cf === '支出' ? 'selected' : '' %>>支出</option><option value="収入" <%= entry?.cf === '収入' ? 'selected' : '' %>>収入</option></select></label>
      <label id="finance-entry-department-field">部<select name="expense_department" id="finance-entry-department" data-selected="<%= entry?.expense_department_name || entry?.expense_department || '' %>"></select></label>
      <label><span id="finance-entry-item-label"><%= entry?.cf === '収入' ? '収入区分' : '支出区分' %></span><select name="item" id="finance-entry-item" data-selected="<%= selectedItem %>" required></select></label>
    </div>
    <div id="finance-entry-tags-field" class="finance-entry-tag-field" <%= entry?.cf === '収入' ? 'hidden' : '' %>>
      <label for="finance-entry-tag-input">タグ</label>
      <input id="finance-entry-tag-input" name="tagText" list="finance-entry-tag-options" value="<%= entry?.tags?.[0]?.name || '' %>" placeholder="タグを選択または入力" autocomplete="off">
      <datalist id="finance-entry-tag-options"></datalist>
      <div id="finance-entry-tags" class="finance-entry-tags"></div>
    </div>
    <label>内容<textarea name="content" rows="5" required><%= entry?.content || '' %></textarea></label>
    <label class="finance-amount-label">金額<input class="finance-entry-amount" type="text" name="amount" value="<%= entry?.amount ? Number(entry.amount).toLocaleString('ja-JP') : '' %>" inputmode="numeric" required></label>
    <div class="finance-entry-inline">
      <label>支払い種別<select name="payment_type"><option value="">選択してください</option><% paymentMethods.forEach(method => { %><option value="<%= method.name %>" <%= entry?.payment_type === method.name ? 'selected' : '' %>><%= method.name %></option><% }) %></select></label>
      <label>領収書番号<input name="receiptNo" value="<%= entry?.receiptNo || '' %>"></label>
    </div>
    <div class="finance-entry-inline">
      <label>入力者<input value="<%= entry?.inputterName || currentUser.displayname || currentUser.username %>" readonly></label>
      <label>使用者<input name="usedBy" value="<%= entry?.usedBy || '' %>" placeholder="未入力の場合は入力者"></label>
    </div>
    <label>メモ<textarea name="memo" rows="3"><%= entry?.memo || '' %></textarea></label>
    <div class="form-actions"><% if (!editing) { %><button class="button button-primary" name="continue" value="1">保存して続けて入力</button><% } %><button class="button button-primary"><%= editing ? '更新' : '保存' %></button></div>
  </form>
</main>
<script>
(() => {
  const budgets = <%- JSON.stringify(budgets.map(row => ({ year: String(row.year), cf: row.cf, name: row.expense_item || row.income_item || '', department: row.expense_department_name || row.expense_department || '未設定', details: row.details || [] })).filter(row => row.name)) %>;
  const form = document.querySelector('.finance-entry-form');
  const date = form.querySelector('[name="date"]');
  const cf = form.querySelector('[name="cf"]');
  const item = form.querySelector('[name="item"]');
  const department = form.querySelector('[name="expense_department"]');
  const departmentField = document.getElementById('finance-entry-department-field');
  let initialDepartment = department.dataset.selected;
  const itemLabel = document.getElementById('finance-entry-item-label');
  const tagField = document.getElementById('finance-entry-tags-field');
  const tagText = document.getElementById('finance-entry-tag-input');
  const tagOptions = document.getElementById('finance-entry-tag-options');
  const tagButtons = document.getElementById('finance-entry-tags');
  const payment = form.querySelector('[name="payment_type"]');
  const amount = form.querySelector('[name="amount"]');
  let initialItem = item.dataset.selected;
  const fiscalStartMonth = <%= Number(association.financeFiscalStartMonth) || 4 %>;
  const yearLabel = document.getElementById('finance-entry-fiscal-year');
  const selectedYear = () => {
    if (!date.value) return String(<%= year %>);
    const [calendarYear, month] = date.value.split('-').map(Number);
    return String(calendarYear - (month < fiscalStartMonth ? 1 : 0));
  };
  const renderTags = () => {
    const details = JSON.parse(item.selectedOptions[0]?.dataset.details || '[]');
    const names = [...new Set(details.map(detail => [String(detail.name || '').trim(), String(detail.content || '').trim()].filter(Boolean).join('：')).filter(Boolean))];
    tagOptions.replaceChildren(...names.map(name => { const option = document.createElement('option'); option.value = name; return option; }));
    tagButtons.replaceChildren(...names.map(name => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'finance-entry-tag';
      button.textContent = name;
      button.classList.toggle('is-selected', tagText.value === name);
      button.addEventListener('click', () => {
        tagText.value = tagText.value === name ? '' : name;
        tagButtons.querySelectorAll('.finance-entry-tag').forEach(candidate => candidate.classList.toggle('is-selected', candidate.textContent === tagText.value));
      });
      return button;
    }));
  };
  tagText.addEventListener('input', () => tagButtons.querySelectorAll('.finance-entry-tag').forEach(button => button.classList.toggle('is-selected', button.textContent === tagText.value)));
  const renderItems = (selected = '') => {
    const expense = cf.value === '支出';
    const available = budgets.filter(row => row.cf === cf.value && row.year === selectedYear() && (!expense || row.department === department.value));
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = expense && !department.value ? '先に部を選択してください' : available.length ? '項目を選択してください' : 'この年度の予算項目がありません';
    item.replaceChildren(placeholder, ...available.map(row => { const option = document.createElement('option'); option.value = row.name; option.textContent = row.name; option.dataset.details = JSON.stringify(row.details || []); return option; }));
    item.disabled = expense && !department.value;
    if (available.some(row => row.name === selected)) item.value = selected;
    renderTags();
  };
  const refresh = () => {
    yearLabel.textContent = selectedYear();
    const expense = cf.value === '支出';
    itemLabel.textContent = expense ? '支出項目' : '収入区分';
    const available = budgets.filter(row => row.cf === cf.value && row.year === selectedYear());
    const departments = [...new Set(available.map(row => row.department))];
    const previousDepartment = department.value;
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = departments.length ? '部を選択してください' : 'この年度の支出予算がありません';
    department.replaceChildren(placeholder, ...departments.map(name => { const option = document.createElement('option'); option.value = name; option.textContent = name; return option; }));
    // 部が未記録の既存データは、項目から一意に判別できる場合だけ復元する。
    const matchingDepartments = [...new Set(available.filter(row => row.name === initialItem).map(row => row.department))];
    const selectedDepartment = initialDepartment || (initialItem && matchingDepartments.length === 1 ? matchingDepartments[0] : previousDepartment);
    if (departments.includes(selectedDepartment)) department.value = selectedDepartment;
    departmentField.hidden = !expense;
    department.disabled = !expense;
    department.required = expense;
    renderItems(initialItem);
    initialItem = '';
    initialDepartment = '';
    tagField.hidden = !expense;
    tagField.style.display = expense ? 'block' : 'none';
    tagText.disabled = !expense;
    payment.closest('label').style.display = expense ? '' : 'none';
    payment.required = expense;
    payment.disabled = !expense;
    if (!expense) payment.value = '';
    renderTags();
  };
  const clearTags = () => { tagText.value = ''; };
  cf.addEventListener('change', () => { clearTags(); refresh(); });
  date.addEventListener('change', () => { clearTags(); refresh(); });
  department.addEventListener('change', () => { clearTags(); renderItems(); });
  item.addEventListener('change', () => { clearTags(); renderTags(); });
  const normalizeAmount = () => amount.value.normalize('NFKC').replace(/[ ,，]/g, '');
  amount.addEventListener('blur', () => { const value = normalizeAmount(); if (/^\d+$/.test(value)) amount.value = Number(value).toLocaleString('ja-JP'); });
  form.addEventListener('submit', () => { amount.value = normalizeAmount(); });
  refresh();
})();
</script>
<%- include('partials/foot') %>
