<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell equipment-page"><a class="back-link" href="<%= base %>">← 設備・備品管理へ戻る</a><% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %><section class="page-heading"><div><h1><%= period.replace('-','年') %>月の棚卸しリスト</h1><p><%= association.name %> ／ 周期：<%= settings.inventoryIntervalMonths %>ヶ月</p></div><a class="button button-primary" href="<%= base %>/inventory.xlsx">Excelダウンロード</a></section><p class="help-text">棚卸数量を保存すると在庫数量も更新します。今回の周期の確認者と確認日時を記録し、過去の棚卸し記録も保持します。</p><nav class="equipment-toolbar"><% groups.forEach(place=>{ const all=place.groups.flatMap(group=>group.items), done=all.filter(item=>item.check?.checked).length; %><a class="button button-quiet button-small" href="#place-<%= encodeURIComponent(place.name) %>"><%= place.name %> <small>未：<%= all.length-done %>／済：<%= done %></small></a><% }) %></nav>
<% if(!groups.length){ %><div class="content-card"><p>棚卸し対象の備品はありません。</p></div><% } %>
<% groups.forEach(place=>{ const all=place.groups.flatMap(group=>group.items); %><section class="content-card equipment-place" id="place-<%= encodeURIComponent(place.name) %>"><h2><%= place.name %></h2><div class="equipment-inventory-columns"><% [false,true].forEach(checked=>{ const rows=all.filter(item=>Boolean(item.check?.checked)===checked); %><div><h3><%= checked ? 'チェック済み' : '要チェック' %> <small><%= rows.length %>件</small></h3><% rows.forEach(item=>{ %><%- include('partials/equipment-inventory-item',{item,base,period}) %><% }) %></div><% }) %></div></section><% }) %>
</main><script>document.querySelectorAll('.equipment-inventory-item input[name=checked]').forEach(input=>input.addEventListener('change',()=>input.form.requestSubmit()));</script><%- include('partials/foot') %>
