<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell equipment-page"><a class="back-link" href="<%= base %>">← 設備・備品管理へ戻る</a><% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %><section class="page-heading"><div><h1><%= period.replace('-','年') %>月の棚卸しリスト</h1><p><%= association.name %> ／ 周期：<%= settings.inventoryIntervalMonths %>ヶ月</p></div><a class="button button-primary" href="<%= base %>/inventory.xlsx">Excelダウンロード</a></section><p class="help-text">数量・コメント・チェック状態は変更すると自動保存します。チェック済みにすると在庫数量も更新します。今回の周期の確認者と確認日時を記録し、過去の棚卸し記録も保持します。</p><nav class="equipment-toolbar"><% groups.forEach(place=>{ const all=place.groups.flatMap(group=>group.items), done=all.filter(item=>item.check?.checked).length; %><a class="button button-quiet button-small" href="#place-<%= encodeURIComponent(place.name) %>"><%= place.name %> <small data-inventory-place-count="<%= place.name %>">未：<%= all.length-done %>／済：<%= done %></small></a><% }) %></nav>
<% if(!groups.length){ %><div class="content-card"><p>棚卸し対象の備品はありません。</p></div><% } %>
<% groups.forEach(place=>{ const all=place.groups.flatMap(group=>group.items); %><details open class="content-card equipment-place equipment-inventory-place" id="place-<%= encodeURIComponent(place.name) %>"><summary><%= place.name %></summary><div class="equipment-inventory-columns"><% [false,true].forEach(checked=>{ const rows=all.filter(item=>Boolean(item.check?.checked)===checked); %><div data-inventory-group="<%= checked ? 'checked' : 'unchecked' %>"><h3><%= checked ? 'チェック済み' : '要チェック' %> <small data-inventory-count><%= rows.length %>件</small></h3><% rows.forEach(item=>{ %><%- include('partials/equipment-inventory-item',{item,base,period}) %><% }) %></div><% }) %></div></details><% }) %>
</main><script src="/assets/equipment-inventory.js?v=<%= assetVersion %>"></script><%- include('partials/foot') %>
