<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell association-public-page"><a class="back-link" href="/associations/<%= group.association %>/public">← <%= association.name %>へ戻る</a>
<section class="association-public-hero <%= group.publicPhotos?.some(photo => photo?.url) ? 'has-photos' : '' %>"><% (group.publicPhotos || []).forEach((photo, index) => { if (photo?.url) { %><img class="association-public-slide <%= index === (group.publicPhotos || []).findIndex(item => item?.url) ? 'is-active' : '' %>" src="<%= photo.url %>" alt="" aria-hidden="true"><% } }); %><div class="association-public-hero-content"><h1><%= group.name %></h1></div><% if (isResident && !members.some(member => String(member.user._id) === String(currentUser?._id))) { %><form class="group-join-hero-form" method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary">このグループに参加</button></form><% } %></section>
<section class="content-card association-public-introduction"><details class="association-info-details" open><summary><div class="association-info-summary-main"><h2>グループの基本情報</h2><p class="body-copy"><%= group.publicDescription || group.purpose || '紹介文は準備中です。' %></p></div><span aria-hidden="true">⌄</span></summary><div class="association-info-expanded"><p class="body-copy"><%= group.publicDescription || group.purpose || '紹介文は準備中です。' %></p></div></details></section>
<%- include('partials/association-event-calendar', { associationName: group.name, calendarTitle: group.name + 'カレンダー', calendarAnchor: 'group-events', calendarPath: '/associations/' + group.association + '/groups/' + group._id, events, months, calendarWindow }) %>
<section class="content-card association-public-introduction <%= isResident ? 'resident-members-section' : 'open-members-section' %>"><h2>参加メンバー</h2><div class="group-member-list"><% members.forEach(member => { %><article class="group-member-card"><% if (member.user.avatar) { %><img class="profile-avatar resident-avatar" src="<%= member.user.avatar %>" alt=""><% } else if (isResident) { %><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%= (member.user.displayname || member.user.username).charAt(0) %></span><% } %><% if (isResident) { %><span class="group-member-name"><%= member.user.displayname || member.user.username %>さん</span><% } %></article><% }) %></div></section>
</main><script>const publicSlides=[...document.querySelectorAll('.association-public-slide')];if(publicSlides.length>1&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){let i=0;setInterval(()=>{publicSlides[i].classList.remove('is-active');i=(i+1)%publicSlides.length;publicSlides[i].classList.add('is-active')},5000)}</script><%- include('partials/foot') %>
