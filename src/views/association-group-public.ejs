<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell association-public-page">
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %><a class="back-link" href="/associations/<%= group.association %>/public">← <%= association.name %>へ戻る</a>
<section class="association-public-hero <%= group.publicPhotos?.some(photo => photo?.url) ? 'has-photos' : '' %>"><% (group.publicPhotos || []).forEach((photo, index) => { if (photo?.url) { %><img class="association-public-slide <%= index === (group.publicPhotos || []).findIndex(item => item?.url) ? 'is-active' : '' %>" src="<%= photo.url %>" alt="" aria-hidden="true"><% } }); %><div class="association-public-hero-content"><h1><%= group.name %></h1><% if (group.status === 'suspended') { %><p class="group-suspended-banner" role="status">活動停止中</p><% } %></div><% const myMembership = currentUser && members.find(member => String(member.user._id) === String(currentUser._id)); const pendingJoin = typeof joinRequest !== 'undefined' && joinRequest; %>
<% if (myMembership || (isResident && (group.status === 'active' || pendingJoin))) { %><div class="group-join-hero-form group-participation-actions <%= myMembership ? 'group-member-actions' : '' %>">
<% if (myMembership) { %><button type="button" class="button button-primary" disabled>グループに参加中</button><form method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>/withdrawal" onsubmit="return confirm('グループからの退会を申請しますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" <%= myMembership.withdrawalRequestedAt ? 'disabled' : '' %>><%= myMembership.withdrawalRequestedAt ? '退会申請中' : '退会申請' %></button></form>
<% } else if (pendingJoin) { %><button type="button" class="button button-primary" disabled>申請中</button>
<% } else { %><form method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary">グループに参加する</button></form><% } %></div><% } %></section>
<section class="content-card association-public-introduction"><details class="association-info-details" open><summary><div class="association-info-summary-main"><h2>グループの基本情報</h2><p class="body-copy"><%= group.publicDescription || group.purpose || '紹介文は準備中です。' %></p></div><span aria-hidden="true">⌄</span></summary><div class="association-info-expanded"><p class="body-copy"><%= group.publicDescription || group.purpose || '紹介文は準備中です。' %></p></div></details></section>
<% if (myMembership && group.status === 'active') { %>
<section class="content-card communication-theme group-communication-theme question-home-section" aria-labelledby="group-pr-messages-title">
  <div class="section-heading"><h2 id="group-pr-messages-title">グループ内の連絡</h2></div>
  <p class="help-text">このグループの参加メンバー同士で連絡できます。</p>
  <div class="question-home-list">
    <a class="question-home-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/messages/inbox"><span><strong>届いたグループの連絡</strong><small>グループに届いた連絡を確認する</small></span><span aria-hidden="true">›</span></a>
    <a class="question-home-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/messages/new"><span><strong>新しい連絡を送る</strong><small>参加メンバー全員に連絡する</small></span><span aria-hidden="true">›</span></a>
    <a class="question-home-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/messages"><span><strong>連絡メニュー・送信した連絡</strong><small>連絡メニューと送信履歴を確認する</small></span><span aria-hidden="true">›</span></a>
  </div>
</section>
<% } %>
<%- include('partials/association-event-calendar', { associationName: group.name, calendarTitle: group.name + 'カレンダー', calendarAnchor: 'group-events', calendarPath: '/associations/' + group.association + '/groups/' + group._id, events, months, calendarWindow }) %>
<section class="content-card association-public-introduction <%= isResident ? 'resident-members-section' : 'open-members-section' %>"><h2>参加メンバー</h2><div class="group-member-list"><% members.forEach(member => { %><article class="group-member-card"><% if (member.user.avatar) { %><img class="profile-avatar resident-avatar" src="<%= member.user.avatar %>" alt=""><% } else if (isResident) { %><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%= (member.user.displayname || member.user.username).charAt(0) %></span><% } %><% if (isResident) { %><span class="group-member-name"><%= member.user.displayname || member.user.username %>さん</span><% } %></article><% }) %></div></section>
</main><script>const publicSlides=[...document.querySelectorAll('.association-public-slide')];if(publicSlides.length>1&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){let i=0;setInterval(()=>{publicSlides[i].classList.remove('is-active');i=(i+1)%publicSlides.length;publicSlides[i].classList.add('is-active')},5000)}</script><%- include('partials/foot') %>
