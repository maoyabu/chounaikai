<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell page-narrow">
  <a class="back-link" href="/profile">← プロフィールへ戻る</a>
  <div class="page-heading"><h1>町内会の退会申請</h1></div>
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <%- include('partials/profile-withdrawals-content') %>
</main>
<script>document.querySelectorAll('[data-withdrawal-scope]').forEach(select => {const update = () => {const label = select.form.querySelector('[data-successor]'); label.hidden = select.value !== 'representative'; label.querySelector('select').required = !label.hidden;}; select.addEventListener('change', update); update();});</script>
<%- include('partials/foot') %>
