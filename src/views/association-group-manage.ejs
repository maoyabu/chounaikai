<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= group.association %>/groups/<%= group._id %>">← グループページへ戻る</a><section class="page-heading"><div><p class="eyebrow">グループ管理</p><h1><%= group.name %></h1></div></section><div class="form-actions"><a class="button button-quiet" href="/associations/<%= group.association %>/groups/<%= group._id %>/manage/pr">グループPRページを編集</a><a class="button button-primary" href="/associations/<%= group.association %>/groups/<%= group._id %>/manage/events">グループの行事を管理</a></div>
<section class="content-card management-card"><h2>参加申請</h2><% if (!requests.length) { %><p class="help-text">承認待ちの申請はありません。</p><% } %><% requests.forEach(request => { %><div class="management-list"><div><span><strong><%= request.applicant.displayname || request.applicant.username %>さん</strong><small><%= request.applicant.email || 'メール未登録' %></small></span><span><form method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/requests/<%= request._id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary">承認</button></form><form method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/requests/<%= request._id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet">却下</button></form></span></div></div><% }) %></section>
<section class="content-card management-card"><h2>メンバー一覧</h2><label class="resident-search">名前・メールアドレスで絞り込む<input type="search" id="group-member-search" placeholder="部分一致で検索"></label><div class="management-list"><% members.forEach(member => { const name = member.user.displayname || member.user.username; %><div data-group-member data-search="<%= [name, member.user.username, member.user.email].join(' ') %>"><span><strong><%= name %>さん</strong><small><%= member.user.email || 'メール未登録' %></small></span><span><% if (member.role === 'manager') { %><span class="status-badge">グループ責任者</span><% } else { %><form method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/members/<%= member.user._id %>/promote"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary">責任者に指定</button></form><form method="post" action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/members/<%= member.user._id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline">強制退会</button></form><% } %></span></div><% }) %></div></section><script>(()=>{const input=document.getElementById('group-member-search');input?.addEventListener('input',()=>{const q=input.value.normalize('NFKC').toLocaleLowerCase('ja');document.querySelectorAll('[data-group-member]').forEach(row=>row.hidden=!row.dataset.search.normalize('NFKC').toLocaleLowerCase('ja').includes(q))})})();</script></main><%- include('partials/foot') %>
