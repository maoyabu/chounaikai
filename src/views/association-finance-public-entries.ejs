<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell finance-shell"><a class="back-link" href="/associations/<%= association._id %>/finance/annual?public=1&year=<%= filters.year || '' %>">← 年度集計へ戻る</a><div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>会計入力一覧</h1><p>公開されている会計データを閲覧できます。</p></div></div><form class="finance-filter content-card" method="get"><select name="cf"><option value="">収支区分すべて</option><option value="収入" <%= filters.cf === '収入' ? 'selected' : '' %>>収入</option><option value="支出" <%= filters.cf === '支出' ? 'selected' : '' %>>支出</option></select><select name="item"><option value="">小区分すべて</option><% const filterItems = filters.cf ? (filterItemsByCf[filters.cf] || []) : [...new Set([...(filterItemsByCf.収入 || []), ...(filterItemsByCf.支出 || [])])].sort(); filterItems.forEach(item => { %><option value="<%= item %>" <%= filters.item === item ? 'selected' : '' %>><%= item %></option><% }) %></select><select name="payment_type"><option value="">支払い種別すべて</option><% (filterPaymentTypes || []).forEach(type => { %><option value="<%= type %>" <%= filters.payment_type === type ? 'selected' : '' %>><%= type %></option><% }) %></select><input name="keyword" value="<%= filters.keyword || '' %>" placeholder="フリーワード"><input type="date" name="from" value="<%= filters.from || '' %>"><span>〜</span><input type="date" name="to" value="<%= filters.to || '' %>"><button class="button button-primary">検索</button></form><section class="content-card"><div class="finance-filter-summary"><strong>絞り込み：</strong><% if (filters.cf) { %><span><%= filters.cf %></span><% } %><% if (filters.item) { %><span><%= filters.item %></span><% } %><% if (filters.payment_type) { %><span><%= filters.payment_type %></span><% } %><% if (filters.keyword) { %><span><%= filters.keyword %></span><% } %><% if (filters.from || filters.to) { %><span><%= filters.from || '開始日なし' %>〜<%= filters.to || '終了日なし' %></span><% } %></div><div class="finance-public-entry-table"><div class="finance-public-entry-head"><span>年月日</span><span>収支区分</span><span>項目</span><span>内容</span><span>支払い種別</span><span>金額</span></div><% if (!entries.length) { %><p class="help-text">該当する会計データはありません。</p><% } else { entries.forEach(entry => { %><div class="finance-public-entry-row"><span><%= new Date(entry.date).toLocaleDateString('ja-JP') %></span><span><%= entry.cf %></span><span><%= entry.cf === '支出' ? entry.expense_item : entry.income_item %></span><span><%= entry.content || '' %></span><span><%= entry.payment_type || '' %></span><strong class="<%= entry.cf === '支出' ? 'finance-expense' : 'finance-income' %>">¥<%= Number(entry.amount || 0).toLocaleString() %></strong></div><% }) } %></div></section></main><%- include('partials/foot') %>
