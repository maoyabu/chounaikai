<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell">
  <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
  <a class="back-link" href="/dashboard">← ホームへ戻る</a>
  <section class="page-heading association-title-heading"<% if (association.symbolImage?.url) { %> style="--symbol-url: url('<%= association.symbolImage.url %>')"<% } %>><div><p class="eyebrow"><%= fiscalYear %>年度 班長</p><h1><%= association.name %> 班長メニュー</h1><p><%= districtGroups.map((item) => item.name).join('・') %>の参加申請と班員情報を確認できます。</p></div></section>
  <section class="admin-section question-home-section communication-theme communication-home-section"><div class="question-home-list"><a class="question-home-link" href="/associations/<%= association._id %>/district-messages"><span><strong>班内の連絡</strong><small>班の住人全員または個別の班員に連絡する</small></span><span class="list-arrow" aria-hidden="true">›</span></a></div></section>
  <% const withdrawals = typeof withdrawalApplications !== 'undefined' ? withdrawalApplications : []; %>
  <div class="management-tabs leader-tabs" role="tablist"><button type="button" role="tab" data-leader-tab="applications">参加申請<% if (applications.length) { %><span class="tab-count"><%= applications.length %></span><% } %></button><button type="button" role="tab" data-leader-tab="withdrawals">退会申請<% if (withdrawals.length) { %><span class="tab-count"><%= withdrawals.length %></span><% } %></button><button type="button" role="tab" data-leader-tab="members">班のメンバー</button></div>
  <section class="content-card management-card" data-leader-panel="applications"><h2>参加申請</h2><% if (!applications.length) { %><p class="help-text">未承認の申請はありません。</p><% } %><%- include('partials/join-application-list', { decisionPath: 'leader' }) %></section>
  <section class="content-card management-card" data-leader-panel="withdrawals" hidden><h2>退会申請</h2><% if (!withdrawals.length) { %><p class="help-text">班長の承認待ちの退会申請はありません。</p><% } %><%- include('partials/withdrawal-list', { withdrawalApplications: withdrawals, withdrawalDecisionPath: 'leader' }) %></section>
  <section class="content-card management-card" data-leader-panel="members"><h2>班に所属する世帯</h2><div class="household-member-list"><% households.forEach((household) => { const householdMembers = membersByHousehold[String(household._id)] || []; const representative = householdMembers.find((member) => member.isRepresentative); const genderLabels = { male: '男性', female: '女性', other: 'その他', unspecified: '回答なし' }; %><article><div class="member-heading"><div><strong><%= representative?.name || household.displayName %>さん</strong><small>世帯代表者・<%= household.districtGroup?.name %></small></div><span><%= household.address.postalCode %> <%= household.address.street %> <%= household.address.building || '' %><%= household.phone ? `・電話 ${household.phone}` : '' %></span></div><details class="household-members-details"><summary><span class="household-count-tag"><%= householdMembers.length %>人世帯</span><span class="details-hint">世帯メンバーを表示</span></summary><div class="member-table"><% householdMembers.forEach((member) => { %><div><strong><%= member.name %><%= member.isRepresentative ? '（代表者）' : '' %></strong><span>よみ：<%= member.nameKana %></span><span>性別：<%= genderLabels[member.gender] || '—' %></span></div><% }) %></div></details><div class="household-deletion-actions"><a class="button button-danger-outline button-small" href="/associations/<%= association._id %>/leader/households/<%= household._id %>/delete">世帯を削除</a></div></article><% }) %></div></section>
  <script>(()=>{const tabs=[...document.querySelectorAll('[data-leader-tab]')],panels=[...document.querySelectorAll('[data-leader-panel]')];const select=(key)=>{tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.leaderTab===key)));panels.forEach(p=>p.hidden=p.dataset.leaderPanel!==key)};tabs.forEach(t=>t.addEventListener('click',()=>select(t.dataset.leaderTab)));const key=new URLSearchParams(location.search).get('tab');select(['members','withdrawals'].includes(key) ? key : 'applications')})();</script>
</main>
<%- include('partials/foot') %>
