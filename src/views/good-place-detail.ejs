<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell good-place-detail-page">
<% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<a class="back-link" href="/associations/<%= association._id %>/good-places">← わがまちのいいところ</a>
<section class="content-card good-place-section">
<div class="good-place-detail-heading"><div><p class="eyebrow">わがまちのいいところ · <%= association.name %></p><h1><%= report.title %></h1></div><%- include('partials/good-place-delete', { canDelete: typeof canDelete !== 'undefined' && canDelete, association, report }) %></div>
<div class="good-place-detail-photo"><button type="button" class="good-place-detail-photo-open" data-open-detail-photo aria-label="写真を拡大表示" aria-haspopup="dialog"><img src="/associations/<%= association._id %>/good-places/<%= report._id %>/photo" alt="<%= report.title %>"></button>
<% if (typeof reactions !== 'undefined' && reactions) { const base = `/associations/${association._id}/good-places/${report._id}`; %>
<div class="good-place-photo-actions">
<form action="<%= base %>/like" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="liked" value="<%= reactions.liked ? '0' : '1' %>"><button type="submit" aria-label="ライク♡ <%= reactions.likeCount %>" aria-pressed="<%= reactions.liked %>"><span aria-hidden="true"><%= reactions.liked ? '♥' : '♡' %></span><small><%= reactions.likeCount %></small></button></form>
<button type="button" data-open-comments aria-label="コメント <%= reactions.commentCount || 0 %>件" aria-haspopup="dialog"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-3 3 2-7A8.5 8.5 0 1 1 21 11.5Z"/></svg><small><%= reactions.commentCount || 0 %></small></button>
</div><% } %>
<% const query = report.locationSource === 'address' ? report.address : `${report.latitude},${report.longitude}`; %>
<a class="good-place-location-link" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(query) %>" target="_blank" rel="noopener noreferrer" aria-label="撮影場所のGoogleマップを別ウィンドウで開く"><iframe title="投稿場所" src="https://www.google.com/maps?q=<%= encodeURIComponent(query) %>&amp;output=embed" loading="lazy" tabindex="-1"></iframe><span>大きな地図で開く<% if (report.locationSource === 'address') { %>（大まかな場所）<% } %></span></a>
</div>
<p class="good-place-detail-meta"><time datetime="<%= report.createdAt.toISOString() %>"><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></time><% if (typeof showGoodPlaceAuthors !== 'undefined' && showGoodPlaceAuthors) { %> · <%= report.author?.displayname || '退会した住人' %><% } %></p>
<p class="danger-body"><%= report.body %></p>

<%- include('partials/good-place-reactions', { reactions: typeof reactions !== 'undefined' ? reactions : null, report, association }) %>
</section><dialog id="good-place-detail-photo-dialog" class="good-place-photo-dialog" tabindex="-1" aria-label="投稿写真の拡大表示"><img src="/associations/<%= association._id %>/good-places/<%= report._id %>/photo" alt="<%= report.title %>"></dialog></main><script src="/assets/good-place-detail.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>
