<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %><a href="/associations/<%= association._id %>/good-places">← わがまちのいいところ</a><section class="content-card good-place-section"><p class="eyebrow">わがまちのいいところ · <%= association.name %></p><h1><%= report.title %></h1><p><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %><% if (typeof showGoodPlaceAuthors !== 'undefined' && showGoodPlaceAuthors) { %> · <%= report.author?.displayname || '退会した住人' %><% } %></p><img class="danger-photo" src="/associations/<%= association._id %>/good-places/<%= report._id %>/photo" alt="現場の写真"><p class="danger-body"><%= report.body %></p><%- include('partials/danger-place', { report }) %><p><a class="button button-quiet" href="/associations/<%= association._id %>/good-places">わがまちのいいところへ</a></p><%- include('partials/good-place-reactions', { reactions: typeof reactions !== 'undefined' ? reactions : null, report, association }) %><%- include('partials/good-place-delete', { canDelete: typeof canDelete !== 'undefined' && canDelete, association, report }) %></section></main><%- include('partials/foot') %>