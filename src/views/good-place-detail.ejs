<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell good-place-detail-page">
<% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<a class="back-link" href="/associations/<%= association._id %>/good-places">← わがまちのいいところ</a>
<section class="content-card good-place-section">
<div class="good-place-detail-heading"><div><p class="eyebrow">わがまちのいいところ · <%= association.name %></p><h1><%= report.title %></h1></div><%- include('partials/good-place-delete', { canDelete: typeof canDelete !== 'undefined' && canDelete, association, report }) %></div>
<% const photoComments = typeof reactions !== 'undefined' && reactions ? reactions.comments.filter(comment => !comment.hiddenAt) : []; %>
<script src="/assets/good-place-display.js?v=<%= assetVersion %>" defer></script>
<div class="good-place-detail-photo"><button type="button" class="good-place-detail-photo-open" data-open-detail-photo aria-label="写真を拡大表示" aria-haspopup="dialog"><img src="/associations/<%= association._id %>/good-places/<%= report._id %>/photo" alt="<%= report.title %>"></button>
<div class="good-place-photo-bottom">
<% if (photoComments.length) { %>
<aside id="good-place-photo-comments" class="good-place-photo-comments" data-photo-comments aria-label="住人のコメント">
<% photoComments.forEach((comment, index) => { %>
<div data-photo-comment <%= index ? 'hidden' : '' %>><p><%= comment.body %><span class="good-place-photo-comment-position">（<%= index + 1 %>/<%= photoComments.length %>）</span></p></div>
<% }) %>
</aside>
<script src="/assets/good-place-photo-comments.js?v=<%= assetVersion %>" defer></script>
<% } %>
<% const query = report.locationSource === 'address' ? report.address : `${report.latitude},${report.longitude}`; %>
<a id="good-place-photo-map" class="good-place-location-link" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(query) %>" target="_blank" rel="noopener noreferrer" aria-label="撮影場所のGoogleマップを別ウィンドウで開く"><iframe title="投稿場所" src="https://www.google.com/maps?q=<%= encodeURIComponent(query) %>&amp;output=embed" loading="lazy" tabindex="-1"></iframe><span>大きな地図で開く<% if (report.locationSource === 'address') { %>（大まかな場所）<% } %></span></a>
<% if (typeof reactions !== 'undefined' && reactions) { const base = `/associations/${association._id}/good-places/${report._id}`; %>
<div class="good-place-photo-actions">
<form action="<%= base %>/like" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="liked" value="<%= reactions.liked ? '0' : '1' %>"><button type="submit" aria-label="ライク♡ <%= reactions.likeCount %>" aria-pressed="<%= reactions.liked %>"><span aria-hidden="true"><%= reactions.liked ? '♥' : '♡' %></span><small><%= reactions.likeCount %></small></button></form>
<button type="button" data-open-comments aria-label="コメント <%= reactions.commentCount || 0 %>件" aria-haspopup="dialog"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-3 3 2-7A8.5 8.5 0 1 1 21 11.5Z"/></svg><small><%= reactions.commentCount || 0 %></small></button>
</div><% } %>
</div>
</div>
<div class="good-place-detail-meta-row"><p class="good-place-detail-meta"><time datetime="<%= report.createdAt.toISOString() %>"><%= report.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></time><% if (typeof showGoodPlaceAuthors !== 'undefined' && showGoodPlaceAuthors) { %> · <%= report.author?.displayname || '退会した住人' %><% } %></p><div class="good-place-display-options" role="group" aria-label="写真上の表示設定">
<% if (photoComments.length) { %><label><input type="checkbox" data-good-place-display="comments" aria-controls="good-place-photo-comments" checked>コメントを表示</label><% } %>
<label><input type="checkbox" data-good-place-display="map" aria-controls="good-place-photo-map" checked>地図を表示</label>
</div>
</div>
<p class="danger-body"><%= report.body %></p>
<% if (typeof canEdit !== 'undefined' && canEdit) { %>
<details class="content-card"><summary>投稿を修正する</summary>
<form class="form-stack" action="/associations/<%= association._id %>/good-places/<%= report._id %>/edit" method="post" enctype="multipart/form-data">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>タイトル<input name="title" maxlength="120" value="<%= report.title %>" required></label>
<label>内容<textarea name="body" maxlength="3000" rows="5" required><%= report.body %></textarea></label>
<label>写真の差し替え（JPEG・PNG・WebP／10MB以下）<input type="file" name="photo" accept="image/jpeg,image/png,image/webp"></label>
<p class="help-text">写真を選択しない場合は現在の写真を使用します。撮影場所は変更されません。</p>
<button class="button button-primary" type="submit">修正を保存する</button>
</form></details>
<% } %>

<%- include('partials/good-place-reactions', { reactions: typeof reactions !== 'undefined' ? reactions : null, report, association }) %>
</section><dialog id="good-place-detail-photo-dialog" class="good-place-photo-dialog" tabindex="-1" aria-label="投稿写真の拡大表示"><img src="/associations/<%= association._id %>/good-places/<%= report._id %>/photo" alt="<%= report.title %>"></dialog></main><script src="/assets/good-place-detail.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot', { hideDangerCompose: true }) %>
