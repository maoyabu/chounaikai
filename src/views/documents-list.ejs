<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell drive-page"><a class="back-link" href="/associations/<%= association._id %>/officer">← 役員メニューへ戻る</a><section class="page-heading"><h1>町内会ドキュメント管理</h1><p><%= association.name %>の共有資料</p></section><% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<% if (!connected) { %><section class="content-card"><h2>Google Driveの接続準備中です</h2><p>町内会管理者に「Google Drive連携設定」の登録・接続を依頼してください。</p><a href="/assets/documents/google-drive-setup.pptx" download>管理者向けの準備手順（PowerPoint）</a></section><% } else { %>
<nav class="drive-breadcrumbs" aria-label="現在のフォルダ"><% breadcrumbs.forEach((crumb, index) => { %><% if (index) { %><span aria-hidden="true"> / </span><% } %><a href="<%= base %>?folder=<%= crumb.id %>" <%- crumb.id === folder.id ? 'aria-current="page"' : '' %>><%= crumb.name %></a><% }); %></nav>
<section class="content-card"><h2><%= folder.name %></h2><label>このページの資料を探す<input id="drive-search" type="search" placeholder="資料名を入力" autocomplete="off"></label>
<div class="drive-items"><% items.forEach(item => { const isFolder = item.mimeType === 'application/vnd.google-apps.folder'; %><article class="drive-item" data-drive-name="<%= item.name %>"><div class="drive-item-name"><a class="drive-item-title" href="<%= isFolder ? base + '?folder=' + item.id : base + '/files/' + item.id + '/view' %>"><%- include('partials/document-icon', { mimeType: item.mimeType }) %><strong title="<%= item.name %>"><%= item.name %></strong></a><% if (!isFolder) { %><small>更新：<%= new Date(item.modifiedTime).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' }) %><%= item.size ? ' ／ ' + (Number(item.size)/1024/1024).toFixed(2) + ' MB' : '' %></small><% } %></div><div class="drive-item-actions"><% if (isFolder) { %><a class="button button-secondary" href="<%= base %>?folder=<%= item.id %>">フォルダを開く</a><% } else { %><a class="button button-secondary" href="<%= base %>/files/<%= item.id %>/view">閲覧</a><% if (item.capabilities?.canDownload !== false) { %><a class="button button-secondary" href="<%= base %>/files/<%= item.id %>/download">ダウンロード</a><% } %><% if (item.capabilities?.canTrash) { %><a class="button button-secondary" href="<%= base %>/files/<%= item.id %>/delete">削除</a><% } %><% } %></div></article><% }); %></div><p id="drive-empty" <%= items.length ? 'hidden' : '' %>><%= items.length ? '該当する資料がありません。' : 'このフォルダに資料はありません。下からアップロードできます。' %></p><% if (nextPage) { %><a class="button button-secondary" href="<%= base %>?folder=<%= folder.id %>&page=<%= encodeURIComponent(nextPage) %>">次の100件を表示</a><% } %><p><a href="<%= base %>?folder=<%= folder.id %>">一覧を更新する</a></p></section>
<% if (folder.capabilities?.canAddChildren) { %><section class="content-card"><h2>このフォルダに資料を追加</h2><p>保存先：<strong><%= folder.name %></strong></p><form class="form-stack" id="drive-upload" method="post" enctype="multipart/form-data" action="<%= base %>/upload"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="folder" value="<%= folder.id %>"><label>アップロードする資料<input name="file" type="file" accept=".pdf,.xlsx,.xls" required></label><p class="help-text">Excel（.xlsx・.xls）またはPDF。1件20MBまで。同じ名前の資料があっても別のファイルとして追加します。</p><button class="button button-primary">アップロード</button><p id="drive-upload-status" role="status"></p></form></section><% } %><script src="/assets/js/documents.js" defer></script><% } %></main><%- include('partials/foot') %>
