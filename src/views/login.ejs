<%- include('partials/head') %>
<main class="login-shell">
  <section class="login-intro" aria-labelledby="welcome-title">
    <div class="brand brand-large"><span class="brand-mark" aria-hidden="true">町</span><span>町内会管理</span></div>
    <h1 id="welcome-title">自分が住んでいる町を<br>安心して助け合える場所に</h1>
    <p>既存の共通アカウントでログインできます。</p>
    <div class="neighborhood-lines" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>
  <section class="login-panel" aria-labelledby="login-title">
    <div class="panel-card">
      <p class="eyebrow">アカウント</p>
      <h2 id="login-title" class="title-with-icon"><span class="title-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></span><span>ログイン</span></h2>
      <% if (errorMessage) { %><div class="alert alert-error" role="alert"><%= errorMessage %></div><% } %>
      <form action="/login" method="post" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>メールアドレスまたはユーザー名
          <input name="identifier" autocomplete="username" required autofocus>
        </label>
        <label>パスワード
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button class="button button-primary button-wide" type="submit">ログイン</button>
      </form>
      <p><a href="/forgot-password">パスワードを忘れた方</a></p>
      <p class="help-text">会計システムまたはメニューシステムと同じアカウントをご利用ください。</p>
      <div class="login-divider"><span>または</span></div>
      <a class="button button-quiet button-wide" href="/associations">町内会一覧から新規会員登録</a>
      <details class="resend-details">
        <summary>確認メールを再送する</summary>
        <form action="/verification-email/resend" method="post" class="form-stack compact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>登録したメールアドレス<input type="email" name="email" autocomplete="email" required></label>
          <button class="button button-quiet button-wide" type="submit">再送する</button>
        </form>
      </details>
    </div>
  </section>
</main>
<%- include('partials/foot') %>
