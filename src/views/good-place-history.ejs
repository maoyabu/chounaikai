<%- include('partials/head') %><%- include('partials/header') %>
<% const postingMemberships = currentUser ? (typeof dangerMemberships !== 'undefined' ? dangerMemberships : []).filter(item => String(item.association._id) === String(association._id) && item.association.optionalFeatures?.goodPlaces === true) : []; %>
<main class="page-shell"><a class="back-link" href="/associations/<%= association._id %>/public">← 町内会PRページ</a>
<section class="content-card good-place-section good-place-history-page"><div class="good-place-history-heading"><h1>わがまちのいいところ</h1><% if (postingMemberships.length) { %><button class="button button-primary" id="good-place-open" type="button">いいところを投稿する</button><% } %></div><div class="good-place-history-body">
<%- include('partials/good-place-history-content', { reports, association, showGoodPlaceAuthors: typeof showGoodPlaceAuthors !== 'undefined' && showGoodPlaceAuthors }) %>
<nav aria-label="履歴のページ"><% if (page > 1) { %><a href="?page=<%= page - 1 %>&amp;sort=<%= typeof sort !== 'undefined' ? sort : 'newest' %>">← 前の50件</a><% } %> <% if (hasNext) { %><a href="?page=<%= page + 1 %>&amp;sort=<%= typeof sort !== 'undefined' ? sort : 'newest' %>">次の50件 →</a><% } %></nav>
</div></section>
<dialog id="good-place-detail-modal" class="good-place-detail-modal" aria-label="投稿の詳細">
<div class="good-place-modal-heading"><strong>投稿の詳細</strong><button type="button" data-close-good-place-detail aria-label="詳細を閉じる">×</button></div>
<iframe title="投稿の詳細" data-good-place-detail-frame></iframe>
</dialog><%- include('partials/good-place-compose', { memberships: postingMemberships }) %></main><script src="/assets/good-place-history.js?v=<%= assetVersion %>" defer></script><script src="/assets/danger-history.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>
