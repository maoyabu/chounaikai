<%- include('partials/head') %><%- include('partials/header') %>
<link rel="stylesheet" href="/assets/faqs.css?v=<%= assetVersion %>">
<main class="page-shell" id="faq-manager" data-base="<%= baseUrl %>" data-csrf="<%= csrfToken %>">
<a class="back-link" href="<%= system ? '/admin' : '/associations/' + association._id + '/manage' %>">← 管理者メニューへ戻る</a>
<% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
<section class="page-heading"><div><p class="eyebrow"><%= system ? 'システム共通' : association.name %></p><h1>Q&Aの管理</h1><p><%= system ? '公開したQ&Aはすべての町内会のFAQに表示されます。' : 'FAQには、この町内会とシステム管理者が公開したQ&Aが表示されます。' %></p></div><a class="button button-primary" href="<%= baseUrl %>/new">新規のQ&Aを作成</a></section>
<% if (!system) { %><p><a href="/associations/<%= association._id %>/faq">公開中のFAQを見る →</a></p><% } %>
<label class="faq-category-filter">カテゴリーで絞り込み<select id="faq-category"><option value="">すべてのカテゴリー</option><% [...new Set(items.map(item => item.category))].sort().forEach(category => { %><option value="<%= category %>"><%= category %></option><% }) %></select></label>
<p class="help-text">左端のハンドルをドラッグして並び替えます。右クリック・長押しで編集や削除ができます。</p>
<p id="faq-status" role="status" aria-live="polite"></p>
<div class="faq-table-wrap"><table class="faq-table"><thead><tr><th>順番</th><th>カテゴリー</th><th>質問</th><th>回答</th><th>公開</th></tr></thead><tbody id="faq-rows">
<% items.forEach(item => { %><tr data-id="<%= item._id %>" data-category="<%= item.category %>"><td><button type="button" draggable="true" data-drag aria-label="ドラッグして並び替え" title="ドラッグして並び替え"><svg width="16" height="22" viewBox="0 0 16 22" fill="currentColor" aria-hidden="true"><circle cx="5" cy="5" r="1.5"/><circle cx="11" cy="5" r="1.5"/><circle cx="5" cy="11" r="1.5"/><circle cx="11" cy="11" r="1.5"/><circle cx="5" cy="17" r="1.5"/><circle cx="11" cy="17" r="1.5"/></svg></button></td><td><%= item.category %></td><td class="faq-copy"><div class="faq-preview"><%= item.question %></div></td><td class="faq-copy"><div class="faq-preview"><%= item.answer %></div></td><td><%= item.published ? '公開' : '非公開' %></td></tr><% }) %>
</tbody></table></div><p id="faq-empty" <%= items.length ? 'hidden' : '' %>>Q&Aはありません。</p>
<div id="faq-actions" class="faq-context-menu" role="menu" aria-label="Q&Aの操作" hidden>
  <a id="faq-edit" role="menuitem" tabindex="-1">編集</a>
  <form method="post" id="faq-delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" role="menuitem" tabindex="-1">削除</button></form>
</div>
</main><script src="/assets/faqs.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>
