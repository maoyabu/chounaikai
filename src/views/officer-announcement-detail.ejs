<%- include('partials/head') %>
<%- include('partials/header') %>
<% const isNetwork = typeof networkMode !== 'undefined' && networkMode; const isDistrict = typeof districtMode !== 'undefined' && districtMode; const messageBase = isDistrict ? `/associations/${association._id}/district-messages` : isNetwork ? `/associations/${association._id}/officer-network` : `/associations/${association._id}/announcements/officer`; const audienceLabel = isDistrict ? announcement.audience === 'district_all' ? '班の住人全員宛て' : `班員 ${announcement.targetOfficers?.length || 1}人宛て` : !isNetwork ? (announcement.audience === 'leaders' ? '班長宛て' : '全住人宛て') : announcement.audience === 'officers_all' ? '全役員宛て' : announcement.audience === 'department' ? `${announcement.targetDepartment?.name || '部'}宛て` : announcement.audience === 'officer_group' ? `${announcement.targetGroup?.name || '役員グループ'}宛て` : announcement.targetOfficers?.length ? `個別役員 ${announcement.targetOfficers.length}人宛て` : `${announcement.targetOfficer?.displayname || announcement.targetOfficer?.username || '役員'}宛て`; %>
<main class="page-shell communication-theme question-box-shell">
  <a class="back-link" href="<%= messageBase %>">← 送信した連絡へ戻る</a>
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <section class="content-card announcement-card"><p class="eyebrow"><%= association.name %> ・ <%= audienceLabel %></p><h1><%= announcement.title %></h1><p class="announcement-stars" aria-label="緊急度 <%= announcement.urgency %> / 5<%= announcement.urgency === 5 ? ' 緊急' : '' %>"><%= '★'.repeat(announcement.urgency) %><span><%= '☆'.repeat(5 - announcement.urgency) %></span><% if (announcement.urgency === 5) { %> 緊急<% } %></p><p class="body-copy"><%= announcement.body %></p><small><%= new Date(announcement.createdAt).toLocaleString('ja-JP') %></small>
  </section>
  <% if (announcement.responseMode !== 'none') { %><section class="admin-section question-home-section announcement-tally"><div class="section-heading"><h2>回答集計</h2><small><%= announcement.responseMode === 'single' ? '1つ選択' : '複数選択可' %> ・ 回答済み <%= responseSummary.answeredCount %> / <%= responseSummary.recipientCount %>人</small></div><p class="announcement-tally-note">割合は送信先 <%= responseSummary.recipientCount %>人を基準に計算しています。<% if (announcement.responseMode === 'multiple') { %>複数選択のため、割合の合計が100％を超える場合があります。<% } %></p>
    <% responseSummary.choices.forEach((choice) => { %><details class="announcement-tally-item"><summary><span><%= choice.label %></span><strong class="announcement-tally-count">合計 <%= choice.respondents.length %>人</strong><strong class="announcement-tally-percent"><%= choice.percentage %>％</strong></summary><div class="announcement-tally-names"><%= choice.respondents.length ? choice.respondents.join('、') : '回答者はいません。' %></div></details><% }) %>
    <details class="announcement-tally-item announcement-tally-unanswered"><summary><span>未回答</span><strong class="announcement-tally-count">合計 <%= responseSummary.unanswered.length %>人</strong><strong class="announcement-tally-percent"><%= responseSummary.unansweredPercentage %>％</strong></summary><div class="announcement-tally-names"><%= responseSummary.unanswered.length ? responseSummary.unanswered.join('、') : '未回答者はいません。' %></div></details>
  </section><% } %>
  <% const unread = receipts.filter(item => !item.readAt); %>
  <section class="admin-section question-home-section announcement-receipts"><div class="section-heading"><h2>送信先の確認状況</h2><span class="status-badge <%= unread.length ? 'status-pending' : '' %>">未確認 <%= unread.length %> / <%= receipts.length %>人</span></div>
    <% if (unread.length) { %><form class="announcement-remind-all" action="<%= messageBase %>/<%= announcement._id %>/remind" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit">未確認者全員に再通知</button></form><% } %>
    <div class="notification-list"><% receipts.forEach((receipt) => { %><article class="announcement-recipient-row"><span><strong><%= receipt.recipient?.displayname || receipt.recipient?.username || '退会済みの利用者' %></strong><small><%= receipt.readAt ? `確認済み ${new Date(receipt.readAt).toLocaleString('ja-JP')}` : '未確認' %></small><% if (receipt.respondedAt && announcement.responseMode !== 'none') { %><small>回答：<%= (receipt.selectedOptions || []).map(index => announcement.options[index]).filter(Boolean).join('、') %></small><% } %><% if (receipt.lastRemindedAt) { %><small>再通知：<%= new Date(receipt.lastRemindedAt).toLocaleString('ja-JP') %></small><% } %></span><% if (!receipt.readAt && receipt.recipient?._id) { %><form action="<%= messageBase %>/<%= announcement._id %>/remind" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="recipientId" value="<%= receipt.recipient._id %>"><button class="button button-quiet button-small" type="submit">個別に再通知</button></form><% } %></article><% }) %></div>
  </section>
</main>
<%- include('partials/foot') %>
