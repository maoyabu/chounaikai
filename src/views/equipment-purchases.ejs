<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell equipment-page"><a class="back-link" href="<%= base %>">← 設備・備品管理へ戻る</a><% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %><section class="page-heading"><div><h1>そろそろ購入リスト</h1><p>期限が<%= settings.expiryAlertMonths %>ヶ月以内の備品・不足分・購入希望を確認します。</p></div></section><div class="equipment-card-grid"><% items.forEach(item=>{ %><article class="content-card equipment-purchase-card"><div class="equipment-card-main"><% if(item.productImageUrl){ %><img src="<%= item.productImageUrl %>" alt="" loading="lazy"><% } %><div><h2><%= item.name %></h2><small><%= item.place %></small><p>在庫 <%= item.quantity %><%= item.unit %></p><% if(item.expiryDate){ %><span class="equipment-warning"><%= item.expiryDate < today ? '期限切れ' : '期限' %>：<%= item.expiryDate %></span><% } %><% if(item.shortage){ %><p class="equipment-warning">不足 <%= item.shortage %><%= item.unit %></p><% } %><% if(item.wishlist){ %><span class="status-badge">購入希望</span><% } %></div></div><div class="equipment-card-actions"><a href="<%= base %>/<%= item._id %>/edit">編集</a><% if(item.productUrl){ %><a href="<%= base %>/<%= item._id %>/purchase" target="_blank" rel="noopener">オンラインで購入 ↗</a><% } %></div><details><summary>購入済み・入庫を記録</summary><form class="form-stack" action="<%= base %>/<%= item._id %>/receive" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>入庫数量<input type="number" name="quantity" value="<%= item.shortage || 1 %>" min="0.001" max="1000000" step="any" required></label><label>新しい賞味・消費期限（任意）<input type="date" name="expiryDate"></label><p class="help-text">期限の異なる在庫は別の備品として登録します。古い在庫を使い切った場合は数量を0にしてから入庫してください。</p><button class="button button-primary button-small">入庫を記録</button></form></details></article><% }) %></div><% if(!items.length){ %><div class="content-card"><p>期限が近い備品・不足した備品はありません。</p></div><% } %><section class="content-card equipment-place"><h2>購入済み履歴</h2><% if(!purchases.length){ %><p>購入履歴はまだありません。</p><% } %><% purchases.forEach(purchase=>{ %><p><strong><%= purchase.name %></strong>　入庫 <%= purchase.quantity %> ／ <%= new Date(purchase.createdAt).toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}) %> ／ <%= purchase.receivedBy?.displayname || purchase.receivedBy?.username || '退会済みの会員' %></p><% }) %></section></main><%- include('partials/foot') %>
