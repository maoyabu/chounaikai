<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a><section class="page-heading"><div><p class="eyebrow">町内会内グループ</p><h1>グループ管理</h1><p>グループ作成申請を承認し、責任者を設定します。</p></div></section>
<section class="content-card management-card"><h2>作成申請</h2><% if (!requests.length) { %><p class="help-text">承認待ちの申請はありません。</p><% } %><% requests.forEach(request => { %><article class="admin-operation-card"><h3>申請内容</h3><dl><dt>グループ名</dt><dd><%= request.name %></dd><dt>活動内容・目的</dt><dd><%= request.purpose || '目的の記載なし' %></dd><dt>申請者</dt><dd><%= request.requestedBy?.displayname || request.requestedBy?.username || '不明' %></dd></dl><p class="help-text">承認すると申請者がグループの責任者として登録されます。</p><div class="admin-operation-actions"><form method="post" action="/associations/<%= association._id %>/manage/groups/<%= request._id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary">承認</button></form><form method="post" action="/associations/<%= association._id %>/manage/groups/<%= request._id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline">却下</button></form></div></article><% }) %></section>
<section class="content-card management-card"><h2>作成済みグループ</h2><% if (!groups.length) { %><p class="help-text">作成済みのグループはありません。</p><% } %><div class="management-list"><% groups.forEach(group => { %><div><span><strong><%= group.name %></strong><small><%= group.purpose || '活動内容未設定' %></small><% group.managers.forEach(manager => { %><small>責任者：<%= manager.displayname || manager.username %>（<%= manager.email || 'メール未登録' %>）</small><% }) %></span><span>責任者 <%= group.managers.length %>人</span></div><% }) %></div></section></main><%- include('partials/foot') %>
