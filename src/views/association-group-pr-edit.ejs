<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/manage">← グループ管理へ戻る</a><section class="page-heading public-edit-heading"><div><h1><%= group.name %> 編集</h1><p>写真とグループの基本情報を編集します。</p></div><a class="button button-quiet" href="/associations/<%= group.association %>/groups/<%= group._id %>">PRページを見る →</a></section>
<form class="form-stack" action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/pr" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><section class="content-card"><h2>メインフォト</h2><p class="help-text">最大3枚。各枠から差し替えや削除ができます。</p><div class="public-photo-editor"><% for (let slot = 0; slot < 3; slot++) { const photo = group.publicPhotos?.[slot]; %><div class="public-photo-slot"><strong>写真 <%= slot + 1 %></strong><% if (photo?.url) { %><img src="<%= photo.url %>" alt="現在の写真 <%= slot + 1 %>"><% } else { %><div class="public-photo-empty">未登録</div><% } %><label>写真を選択<input type="file" name="photo<%= slot %>" accept="image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif"></label><% if (photo?.url) { %><label class="public-photo-remove"><input type="checkbox" name="remove<%= slot %>"> この写真を削除</label><% } %></div><% } %></div></section><section class="content-card"><h2>グループの基本情報</h2><label>グループ名<input name="name" value="<%= group.name %>" maxlength="100" required></label><label>紹介文<textarea name="publicDescription" rows="8" maxlength="5000"><%= group.publicDescription || group.purpose || '' %></textarea></label><label>公開範囲<select name="publicVisibility"><option value="members" <%= group.publicVisibility !== 'open' ? 'selected' : '' %>>町内会住人のみ</option><option value="open" <%= group.publicVisibility === 'open' ? 'selected' : '' %>>一般公開</option></select></label></section><div class="form-actions"><button class="button button-primary">PRページを保存</button></div></form></main><%- include('partials/foot') %>
