<%- include('partials/head') %><%- include('partials/header') %><% const feeMembers = typeof members !== 'undefined' ? members : []; var members = feeMembers; %>
<main class="page-shell leader-fees-page"><% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %><a class="back-link" href="/associations/<%= association._id %>/leader">← 班長メニューへ戻る</a>
<script>document.addEventListener('DOMContentLoaded',()=>{const heading=document.querySelector('.leader-fees-page .management-card h2');if(heading)heading.textContent='<%= districtGroups.map(group => group.name).join('・') %>　'+heading.textContent});</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const ids=new Set(<%- JSON.stringify(leaderHouseholdIds || []) %>);document.querySelectorAll('[data-edit-household]').forEach(button=>{if(!ids.has(button.dataset.editHousehold))return;const tag=document.createElement('b');tag.className='leader-badge';tag.textContent='班長';button.closest('.member-table > div')?.querySelector(':scope > span:first-child')?.append(' ',tag)})});</script>
<section class="page-heading leader-fees-heading"><div><h1>班の世帯管理</h1><p>会員・未加入にかかわらず、担当班の現在の世帯情報を台帳で管理します。会員登録済みの世帯は代表者名が表示されます。</p></div></section>
<section class="content-card management-card"><div class="card-top"><h2>世帯一覧（<%= households.length %>世帯）</h2><div><button type="button" class="button button-primary" data-open-household-modal>＋ 世帯を追加</button><button type="button" class="button button-quiet" data-open-link-modal>会員との紐付け</button></div></div><div class="member-table"><% households.forEach(household => { %><div><span><%= household.districtLabel || household.districtGroup?.name || '' %></span><strong><%= household.displayName %> <span class="member-link-tags"><% (household.roleTags || []).forEach(tag => { %><span class="link-tag link-tag-admin"><%= tag %></span><% }) %></span><% if (household.representative) { %>（<%= household.representative.displayname || household.representative.username || '' %>）<% } %></strong><span class="household-member-tag <%= household.isLedgerLinked ? '' : 'is-non-member' %>"><%= household.isLedgerLinked ? '会員' : '非会員' %></span><span class="household-row-actions"><% if (household.feeRepresentative) { %><form method="post" action="/associations/<%= association._id %>/leader/fees/<%= household._id %>/unlink" onsubmit="return confirm('会員との紐付けを解除しますか？解除後に正しい会員を選び直せます。')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small">紐付け解除・変更</button></form><% } %><button type="button" class="button button-quiet button-small" data-edit-household="<%= household._id %>">修正</button><form method="post" action="/associations/<%= association._id %>/leader/fees/<%= household._id %>/delete" onsubmit="return confirm('この世帯を一覧から削除しますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline button-small">削除</button></form></span></div><dialog class="household-edit-modal" data-edit-modal="<%= household._id %>"><form method="post" action="/associations/<%= association._id %>/leader/fees/<%= household._id %>/update" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>世帯情報を修正</h2><label>班区分<input name="districtLabel" value="<%= household.districtLabel || household.districtGroup?.name || '' %>" required></label><label>世帯名<input name="displayName" value="<%= household.displayName %>" required></label><label>電話番号<input name="phone" type="tel" value="<%= household.phone || '' %>"></label><label>メールアドレス<input name="email" type="email" value="<%= household.email || '' %>"></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-modal>キャンセル</button><button class="button button-primary">更新する</button></div></form></dialog><% }) %></div></section>
<dialog class="household-add-modal" data-household-modal><form method="post" action="/associations/<%= association._id %>/leader/fees/households" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>世帯を追加</h2><label>班区分（テキスト）<input name="districtLabel" required></label><label>世帯名<input name="displayName" required></label><label>電話番号<input name="phone" type="tel"></label><label>メールアドレス<input name="email" type="email"></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-household-modal>キャンセル</button><button class="button button-primary">登録する</button></div></form></dialog>
<dialog class="household-add-modal" data-link-modal><form method="post" action="/associations/<%= association._id %>/leader/fees/link" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>会員との紐付け</h2><label>世帯<select name="householdId" required><% linkableHouseholds.forEach(household => { %><option value="<%= household._id %>"><%= household.districtLabel || household.districtGroup?.name %> ・ <%= household.displayName %></option><% }) %></select></label><label>会員<select name="userId" required><% members.forEach(member => { %><option value="<%= member.user._id %>"><%= member.user.displayname || member.user.username %></option><% }) %></select></label><% if (!members.length) { %><p class="help-text">紐付けされていない会員はいません。</p><% } %><% if (!linkableHouseholds.length) { %><p class="help-text">紐付けされていない世帯はありません。</p><% } %><div class="form-actions"><button type="button" class="button button-quiet" data-close-link-modal>キャンセル</button><button class="button button-primary" <%= !members.length || !linkableHouseholds.length ? 'disabled' : '' %>>紐付ける</button></div></form></dialog>
</main><script>(()=>{const add=document.querySelector('[data-household-modal]'),link=document.querySelector('[data-link-modal]');document.querySelector('[data-open-household-modal]')?.addEventListener('click',()=>add.showModal());document.querySelector('[data-open-link-modal]')?.addEventListener('click',()=>link.showModal());document.querySelectorAll('[data-edit-household]').forEach(b=>b.addEventListener('click',()=>document.querySelector(`[data-edit-modal="${b.dataset.editHousehold}"]`).showModal()));document.querySelectorAll('[data-close-modal]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog').close()));document.querySelector('[data-close-household-modal]')?.addEventListener('click',()=>add.close());document.querySelector('[data-close-link-modal]')?.addEventListener('click',()=>link.close())})();</script><%- include('partials/foot') %>
