<%- include('partials/head') %><%- include('partials/header') %><% const feeMembers = typeof members !== 'undefined' ? members : []; var members = feeMembers; %>
<main class="page-shell leader-fees-page"><a class="back-link" href="/associations/<%= association._id %>/leader">← 班長メニューへ戻る</a>
<script>document.addEventListener('DOMContentLoaded',()=>setTimeout(()=>document.querySelectorAll('.leader-fees-page .member-table > div > span:nth-of-type(2)').forEach(tag=>{const isMember=tag.textContent.trim()==='加入';tag.textContent=isMember?'会員':'非会員';tag.classList.toggle('is-non-member',!isMember)}),0));</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const heading=document.querySelector('.leader-fees-page .management-card h2');if(heading)heading.textContent='<%= districtGroups.map(group => group.name).join('・') %>　'+heading.textContent});</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const heading=document.querySelector('.leader-fees-heading h1');if(heading)heading.textContent=heading.textContent.replace('町内会費管理','町内会会費管理')});</script>
<script>document.addEventListener('DOMContentLoaded',()=>{const ids=new Set(<%- JSON.stringify(leaderHouseholdIds || []) %>);document.querySelectorAll('[data-edit-household]').forEach(button=>{if(!ids.has(button.dataset.editHousehold))return;const tag=document.createElement('b');tag.className='leader-badge';tag.textContent='班長';button.closest('.member-table > div')?.querySelector(':scope > span:first-child')?.append(' ',tag)})});</script>
<script>document.addEventListener('DOMContentLoaded',()=>document.querySelectorAll('.leader-fees-page .member-table > div').forEach(row=>{const payment=row.querySelector(':scope > span:nth-of-type(2)'),deleteForm=row.querySelector('.household-row-actions form');if(!payment||!deleteForm)return;const form=document.createElement('form');form.method='post';form.action=deleteForm.action.replace('/delete','/toggle');form.innerHTML=`<input type="hidden" name="_csrf" value="${deleteForm.querySelector('[name=_csrf]').value}"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><label><input type="checkbox" name="paid" ${payment.textContent.trim()==='納入済み'?'checked':''} onchange="this.form.submit()"><span>${payment.textContent}</span></label>`;payment.replaceWith(form)}));</script>
<section class="page-heading leader-fees-heading"><div><p class="eyebrow">班長の仕事</p><h1><%= fiscalYear %>年度 町内会費管理</h1><p>会員・未加入にかかわらず、担当班の全世帯を台帳で管理します。会員登録済みの世帯は代表者名が表示されます。</p></div><form method="get" class="leader-fees-year-selector"><select name="year" onchange="this.form.submit()"><% for (let year = fiscalYear - 2; year <= fiscalYear + 3; year++) { %><option value="<%= year %>" <%= year === fiscalYear ? 'selected' : '' %>><%= year %>年度</option><% } %></select></form></section>
<section class="content-card management-card"><div class="card-top"><h2>世帯一覧（<%= households.length %>世帯）</h2><div><button type="button" class="button button-primary" data-open-household-modal>＋ 世帯を追加</button><button type="button" class="button button-quiet" data-open-link-modal>会員との紐付け</button></div></div><div class="member-table"><% households.forEach(household => { %><div><span><%= household.districtLabel || household.districtGroup?.name || '' %></span><strong><%= household.displayName %></strong><span><%= household.payment?.paid ? '納入済み' : '未納' %></span><span><%= household.representative?.displayname ? '加入' : '未加入' %></span><span class="household-row-actions"><button type="button" class="button button-quiet button-small" data-edit-household="<%= household._id %>">修正</button><form method="post" action="/associations/<%= association._id %>/leader/fees/<%= household._id %>/delete" onsubmit="return confirm('この世帯を一覧から削除しますか？')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><button class="button button-danger-outline button-small">削除</button></form></span></div><dialog class="household-edit-modal" data-edit-modal="<%= household._id %>"><form method="post" action="/associations/<%= association._id %>/leader/fees/<%= household._id %>/update" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><h2>世帯情報を修正</h2><label>班区分<input name="districtLabel" value="<%= household.districtLabel || household.districtGroup?.name || '' %>" required></label><label>世帯名<input name="displayName" value="<%= household.displayName %>" required></label><label>電話番号<input name="phone" type="tel" value="<%= household.phone || '' %>"></label><label>メールアドレス<input name="email" type="email" value="<%= household.email || '' %>"></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-modal>キャンセル</button><button class="button button-primary">更新する</button></div></form></dialog><% }) %></div></section>
<dialog class="household-add-modal" data-household-modal><form method="post" action="/associations/<%= association._id %>/leader/fees/households" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><h2>世帯を追加</h2><label>班区分（テキスト）<input name="districtLabel" required></label><label>世帯名<input name="displayName" required></label><label>電話番号<input name="phone" type="tel"></label><label>メールアドレス<input name="email" type="email"></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-household-modal>キャンセル</button><button class="button button-primary">登録する</button></div></form></dialog>
<dialog class="household-add-modal" data-link-modal><form method="post" action="/associations/<%= association._id %>/leader/fees/link" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><h2>会員との紐付け</h2><label>会員<select name="userId" required><% members.forEach(member => { %><option value="<%= member.user._id %>"><%= member.user.displayname || member.user.username %><%= member.household ? `（現在：${member.household.displayName}）` : '' %></option><% }) %></select></label><label>世帯<select name="householdId" required><% households.forEach(household => { %><option value="<%= household._id %>"><%= household.districtLabel || household.districtGroup?.name %> ・ <%= household.displayName %></option><% }) %></select></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-link-modal>キャンセル</button><button class="button button-primary">紐付ける</button></div></form></dialog>
</main><script>(()=>{const add=document.querySelector('[data-household-modal]'),link=document.querySelector('[data-link-modal]');document.querySelector('[data-open-household-modal]')?.addEventListener('click',()=>add.showModal());document.querySelector('[data-open-link-modal]')?.addEventListener('click',()=>link.showModal());document.querySelectorAll('[data-edit-household]').forEach(b=>b.addEventListener('click',()=>document.querySelector(`[data-edit-modal="${b.dataset.editHousehold}"]`).showModal()));document.querySelectorAll('[data-close-modal]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog').close()));document.querySelector('[data-close-household-modal]')?.addEventListener('click',()=>add.close());document.querySelector('[data-close-link-modal]')?.addEventListener('click',()=>link.close())})();</script><%- include('partials/foot') %>
