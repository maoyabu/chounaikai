<%- include('partials/head') %>
<% if (currentUser) { %><%- include('partials/header') %><% } %>
<main class="page-shell association-list-shell">
  <section class="page-heading"><div><p class="eyebrow">町内会を探す</p><h1>町内会一覧</h1><p>参加したい町内会があるか確認してください。</p></div></section>
  <div class="association-list-layout">
  <section class="content-card management-card association-list-directory">
    <% if (associations.length) { %>
      <div class="management-list"><% associations.forEach((association) => { %>
        <div><span><strong><%= association.name %></strong><small><%= association.serviceArea || '対象地域未設定' %></small><a href="/associations/<%= association._id %>/public">町内会のことを詳しく知る →</a></span><span class="association-list-actions"><% if (!currentUser) { %><a class="button button-quiet button-small" href="/associations/<%= association._id %>/register/start?login=1">すでに会員の方はログイン</a><a class="button button-primary button-small" href="/associations/<%= association._id %>/register/start">この町内会で会員登録</a><% } else { %><a class="button button-primary button-small" href="/associations/<%= association._id %>/register/start">この町内会に参加</a><% } %></span></div>
      <% }) %></div>
    <% } else { %><p>公開中の町内会はまだありません。</p><% } %>
  </section>
  <section class="content-card association-list-request"><h2>町内会が見つからない場合</h2><p>一覧を確認しても該当する町内会がない場合は、新規で町内会を申請できます。</p><p>※申請者が町内会の管理者となりますが、後で別の人に変更も可能です</p>
    <div class="form-actions">
      <% if (currentUser) { %>
        <a class="button button-primary" href="/associations/create/start">新規町内会を申請する</a>
      <% } else { %>
        <a class="button button-quiet" href="/associations/create/start">ログインして申請</a>
        <a class="button button-primary" href="/associations/create/register">会員登録して申請</a>
      <% } %>
    </div>
  </section>
  </div>
</main>
<%- include('partials/foot') %>
