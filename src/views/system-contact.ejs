<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell communication-theme">
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <a class="back-link" href="<%= baseUrl %>">← システム管理者への連絡へ戻る</a>
  <section class="page-heading"><div><p class="eyebrow"><%= thread.association?.name || '町内会' %></p><h1><%= thread.title %></h1><p>緊急度 <%= '★'.repeat(thread.urgency) %> ・ <%= thread.status === 'resolved' ? '対応済み' : '対応中' %> ・ <%= thread.systemReadAt ? 'システム管理者が確認済み' : 'システム管理者は未確認' %></p></div></section>
  <% thread.messages.forEach(message => { %><article class="content-card"><h2><%= message.kind === 'system' ? 'システム管理者' : '町内会' %>：<%= message.sender?.displayname || message.sender?.username || '利用者' %></h2><small><%= new Date(message.createdAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></small><p style="white-space: pre-wrap; overflow-wrap: anywhere"><%= message.body %></p><% (message.attachments || []).forEach(attachment => { %><p><a href="<%= baseUrl %>/<%= thread._id %>/attachments/<%= attachment.fileId %>"><%= attachment.originalName %></a>（<%= Math.ceil(attachment.bytes / 1024) %> KB）</p><% }) %></article><% }) %>
  <div class="form-actions"><button type="button" class="button button-primary" data-system-contact-open="reply-system-contact-dialog">返信する</button></div>
  <dialog class="officer-dialog system-contact-dialog" id="reply-system-contact-dialog" aria-labelledby="reply-system-contact-heading">
    <div class="dialog-heading"><h2 id="reply-system-contact-heading">返信する</h2><button type="button" class="dialog-close" data-system-contact-close aria-label="閉じる">×</button></div>
    <form action="<%= baseUrl %>/<%= thread._id %>/replies" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>内容<textarea name="body" rows="8" required maxlength="5000"></textarea></label><div class="form-actions"><button class="button button-primary" type="submit">返信を送信</button></div></form>
  </dialog>
  <script src="/assets/system-contacts.js?v=<%= assetVersion %>" defer></script>

  <form action="<%= baseUrl %>/<%= thread._id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= thread.status === 'resolved' ? 'open' : 'resolved' %>"><button class="button button-quiet" type="submit"><%= thread.status === 'resolved' ? '対応中に戻す' : '対応済みにする' %></button></form>
</main><%- include('partials/foot') %>
