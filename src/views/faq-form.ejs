<%- include('partials/head') %><%- include('partials/header') %>
<link rel="stylesheet" href="/assets/faqs.css?v=<%= assetVersion %>">
<main class="page-shell"><a class="back-link" href="<%= baseUrl %>">← Q&A一覧を見る</a><section class="page-heading"><h1><%= title %></h1></section>
<% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
<form class="content-card form-stack" method="post" enctype="multipart/form-data" action="<%= baseUrl %><%= item._id ? '/' + item._id + '/edit' : '' %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>カテゴリー<input name="category" list="faq-categories" required maxlength="100" value="<%= item.category || '' %>" placeholder="入力または登録済みカテゴリーを選択"><datalist id="faq-categories"><% categories.forEach(category => { %><option value="<%= category %>"><% }) %></datalist></label>
<label>質問<textarea name="question" rows="3" required maxlength="1000"><%= item.question || '' %></textarea></label>
<div class="faq-answer-field">
<label for="faq-answer">回答</label>
<div class="faq-editor-tools" role="toolbar" aria-label="回答の書式" hidden>
<% for (const [command, label] of [['bold', '太字'], ['italic', '斜体'], ['underline', '下線'], ['strikeThrough', '取り消し線'], ['insertUnorderedList', '箇条書き'], ['insertOrderedList', '番号付きリスト'], ['createLink', 'リンク'], ['unlink', 'リンク解除'], ['insertHorizontalRule', '水平線'], ['justifyLeft', '左揃え'], ['justifyCenter', '中央揃え'], ['justifyRight', '右揃え'], ['removeFormat', '書式解除']]) { %><button type="button" data-command="<%= command %>"><%= label %></button><% } %>
<label class="faq-tool-label">文字色<input type="color" value="#17231f" data-color aria-label="文字色"></label>
<label class="faq-tool-label">見出し・段落<select aria-label="見出し・段落の種類" data-block><option value="p">標準の段落</option><% for (let level = 1; level <= 6; level++) { %><option value="h<%= level %>">見出し<%= level %></option><% } %><option value="blockquote">引用</option></select></label>
</div>
<div id="faq-answer-editor" class="faq-answer-editor" contenteditable="true" role="textbox" aria-label="回答" aria-multiline="true" aria-required="true" hidden><% if (typeof item.answerHtml === 'string') { %><%- item.answerHtml %><% } else { %><%= item.answer || '' %><% } %></div>
<textarea id="faq-answer" name="answer" rows="8" required maxlength="10000"><%= item.answer || '' %></textarea>
<input type="hidden" name="answerFormat" value="<%= item.answerFormat === 'html' ? 'html' : 'text' %>">
<p class="help-text">文字を選択して書式を指定できます。回答はHTMLを含め10,000文字までです。</p>
</div>
<fieldset><legend>画像（最大3枚）</legend>
<p class="help-text">画像1は回答の一番上、画像2・3は回答文の下に表示されます。1枚15MB以下。JPEG、PNG、WebP、GIF、HEIC形式。<%= system ? 'Cloudinary' : '町内会のGoogle Drive' %>に保存します。エラー時は画像を選び直してください。</p>
<div class="faq-images"><% for (let slot = 0; slot < 3; slot++) { const image = (item.images || [])[slot]; %>
<div><% if (image && image.url) { %><img src="<%= image.url %>" alt="登録済み画像<%= slot + 1 %>"><label><input type="checkbox" name="removePhoto<%= slot %>">この画像を削除</label><% } %>
<label>画像<%= slot + 1 %><input type="file" name="photo<%= slot %>" accept="image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif"></label></div>
<% } %></div></fieldset>
<label>関連URL（任意）<input type="url" name="relatedUrl" maxlength="2000" value="<%= item.relatedUrl || '' %>" placeholder="https://"></label>
<label class="faq-publish-toggle"><span>FAQとして公開する</span><input class="faq-publish-switch" type="checkbox" role="switch" name="published" <%= item.published ? 'checked' : '' %>></label>
<label class="faq-publish-toggle"><span>サポートページの「よくあるご質問」に掲載する</span><input class="faq-publish-switch" type="checkbox" role="switch" name="showOnSupport" <%= item.showOnSupport !== false ? 'checked' : '' %>></label>
<p class="help-text">「FAQとして公開する」がオンの場合、選択したQ&Aをサポートページにも表示します。</p>
<% if (system) { %>
<label class="faq-publish-toggle"><span>ログイン後のQ&A一覧に表示しない</span><input class="faq-publish-switch" type="checkbox" role="switch" name="hideAfterLogin" <%= item.hideAfterLogin ? 'checked' : '' %>></label>
<p class="help-text">オンの場合、ログイン後のQ&A一覧とサポートページには表示しません。</p>
<label class="faq-publish-toggle"><span>ログイン前にも表示する</span><input class="faq-publish-switch" type="checkbox" role="switch" name="openToPublic" <%= item.openToPublic ? 'checked' : '' %>></label>
<p class="help-text">オン：町内会一覧から開くQ&Aにも表示します。オフ：ログインユーザーにのみ表示します。「FAQとして公開する」がオンの場合に表示されます。</p>
<% } %>
<div class="form-actions"><button class="button button-primary"><%= item._id ? '保存' : '登録' %></button><a class="button button-quiet" href="<%= baseUrl %>">キャンセル</a></div>
</form></main><script src="/assets/faq-editor.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>
