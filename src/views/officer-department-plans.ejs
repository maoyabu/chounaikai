<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= association._id %>/officer">← 役員メニューへ戻る</a><section class="page-heading"><div><p class="eyebrow">役員機能</p><h1><%= fiscalYear %>年度 部会の年度目標</h1><p>各部会の目標と年度末の実施報告を確認できます。</p></div><form class="year-selector" method="get"><label>表示年度<select name="year" onchange="this.form.submit()"><% for (let year = fiscalYear - 2; year <= fiscalYear + 2; year++) { %><option value="<%= year %>" <%= year === fiscalYear ? 'selected' : '' %>><%= year %>年度</option><% } %></select></label></form></section>
<section class="content-card annual-plan-admin-panel"><h2>各部会の目標</h2><div class="annual-plan-list"><% if (plans.length) { plans.forEach((plan) => { %><article class="annual-plan-record"><strong><%= plan.department?.name || '部会未設定' %></strong><p><%= plan.goal %></p><button type="button" class="button button-quiet" data-open-report="report-<%= plan._id %>">実施報告を入力・編集</button><dialog class="officer-dialog" id="report-<%= plan._id %>"><div class="dialog-heading"><h3><%= plan.department?.name || '部会' %>の実施報告</h3><button type="button" class="dialog-close" data-close-report>×</button></div><form method="post" action="/associations/<%= association._id %>/department-plans/<%= plan._id %>/report" class="resident-officer-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fiscalYear" value="<%= fiscalYear %>"><label>年度の実施報告<textarea name="report" rows="7" placeholder="年度末に実施報告を入力してください"><%= plan.report || '' %></textarea></label><div class="form-actions"><button type="button" class="button button-quiet" data-close-report>キャンセル</button><button class="button button-primary">保存</button></div></form></dialog></article><% }); } else { %><p class="help-text">この年度の部会目標はまだ登録されていません。</p><% } %></div></section><script>document.querySelectorAll('[data-open-report]').forEach((button)=>button.addEventListener('click',()=>document.getElementById(button.dataset.openReport)?.showModal()));document.querySelectorAll('[data-close-report]').forEach((button)=>button.addEventListener('click',()=>button.closest('dialog')?.close()));document.querySelectorAll('.officer-dialog').forEach((dialog)=>dialog.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close()}));</script></main><%- include('partials/foot') %>
