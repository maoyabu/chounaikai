<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell page-narrow">
  <a class="back-link" href="/associations">← 町内会一覧へ戻る</a>
  <section class="page-heading"><div><p class="eyebrow">新規作成申請</p><h1 class="title-with-icon"><span class="title-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V9l7-6 7 6v12M9 21v-6h6v6M19 4v4M21 6h-4"/></svg></span><span>町内会を申請</span></h1><p>承認されると町内会が公開され、あなたが町内会管理者になります。</p></div></section>
  <% if (typeof formError !== 'undefined' && formError) { %><div class="alert alert-error" role="alert"><%= formError %></div><% } %>
  <form action="/associations" method="post" class="form-card form-stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>町内会名 <span class="required">必須</span><input name="name" value="<%= values.name || '' %>" required></label>
    <label>共通グループ名 <span class="required">必須</span><input name="groupName" value="<%= values.groupName || '' %>" required><small>既存システムにも表示される名称です。他のグループと重複できません。</small></label>
    <label>公開URL名 <span class="required">必須</span><div class="input-prefix"><span>/n/</span><input name="publicSlug" value="<%= values.publicSlug || '' %>" pattern="[a-z0-9][a-z0-9-]{2,62}" required></div><small>半角英小文字・数字・ハイフンで入力してください。</small></label>
    <div class="form-columns"><label>郵便番号<input id="association-postal-code" name="postalCode" value="<%= values.address?.postalCode || '' %>" inputmode="numeric" autocomplete="postal-code" placeholder="例：2440817"></label><button class="button button-quiet address-lookup-button" type="button" id="association-address-lookup">住所を検索</button></div>
    <div class="form-columns"><label>都道府県<input id="association-prefecture" name="prefecture" value="<%= values.address?.prefecture || '' %>" autocomplete="address-level1"></label><label>市区町村<input id="association-city" name="city" value="<%= values.address?.city || '' %>" autocomplete="address-level2"></label></div>
    <label>町名・番地など<input id="association-street" name="street" value="<%= values.address?.street || '' %>" autocomplete="address-line1"></label>
    <label>対象地域<input name="serviceArea" value="<%= values.serviceArea || '' %>" placeholder="例：横浜市戸塚区吉田町"></label>
    <label>連絡担当者<input name="contactName" value="<%= values.contact?.name || '' %>"></label>
    <label>連絡先メール<input type="email" name="contactEmail" value="<%= values.contact?.email || currentUser.email || '' %>"></label>
    <label>連絡先電話番号<input type="tel" name="contactPhone" value="<%= values.contact?.phone || '' %>"></label>
    <label>紹介文<textarea name="introduction" rows="5"><%= values.introduction || '' %></textarea></label>
    <div class="form-actions"><a class="button button-quiet" href="/associations">キャンセル</a><button class="button button-primary" type="submit">申請する</button></div>
  </form>
<script>(() => { const postal = document.getElementById('association-postal-code'), button = document.getElementById('association-address-lookup'), prefecture = document.getElementById('association-prefecture'), city = document.getElementById('association-city'), street = document.getElementById('association-street'); const lookup = async () => { const code = postal.value.replace(/[^0-9]/g, ''); if (code.length !== 7) return; button.disabled = true; try { const response = await fetch('https://zipcloud.ibsnet.co.jp/api/search?zipcode=' + code); const result = (await response.json()).results?.[0]; if (result) { prefecture.value = result.address1 || ''; city.value = (result.address2 || '') + (result.address3 || ''); street.focus(); } } finally { button.disabled = false; } }; button.addEventListener('click', lookup); postal.addEventListener('blur', lookup); })();</script>
</main>
<%- include('partials/foot') %>
