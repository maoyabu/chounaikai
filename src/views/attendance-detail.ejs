<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell attendance-page"><link rel="stylesheet" href="/assets/attendance.css?v=<%= assetVersion %>">
<a class="back-link" href="<%= creator ? `${base}?${scopeQuery}` : '/dashboard' %>">← <%= creator ? 'イベント出欠管理' : 'ホーム' %>へ戻る</a>
<section class="page-heading attendance-event-heading"><h1><%= poll.title %></h1><p>回答締め切り：<%= new Date(poll.deadline).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %>（日本時間）</p></section>
<% if (poll.memo) { %><p class="attendance-memo"><%= poll.memo %></p><% } %>
<% if (typeof notice !== 'undefined' && notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<section class="content-card"><div class="attendance-section-heading"><h2>出欠の回答</h2><% if (!closed && canRespond) { %><p>各候補に○（参加できる）、△（未定）、×（参加できない）を選択してください。</p><% } %></div>
<% if (closed) { %><p>回答の締め切りを過ぎています。</p><% } else if (canRespond) { %>
<form id="attendance-response-form" class="form-stack" method="post" action="<%= base %>/<%= poll._id %>/respond"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<p id="attendance-response-error" class="alert alert-error" role="alert" hidden>すべての日程候補で○・△・×を選択してください。</p>
<div class="attendance-answer-list">
<% poll.candidates.forEach((c,i) => { const dateLabel = `${c.date}（${['日','月','火','水','木','金','土'][new Date(`${c.date}T00:00:00Z`).getUTCDay()]}）`; %><div class="attendance-answer-row" data-attendance-answer><span class="attendance-answer-datetime" id="attendance-answer-date-<%= i %>"><span><%= dateLabel %></span> <span><%= c.time %></span></span><input type="hidden" name="answer<%= i %>" value="<%= ownResponse?.answers[i] || '' %>"><div class="attendance-options" role="group" aria-labelledby="attendance-answer-date-<%= i %>"><% ['○','△','×'].forEach((mark, markIndex) => { %><button type="button" class="button attendance-answer-button" data-answer="<%= mark %>" data-mark="<%= ['yes','maybe','no'][markIndex] %>" aria-label="<%= mark %> <%= ['参加できる','未定','参加できない'][markIndex] %>" aria-pressed="<%= ownResponse?.answers[i] === mark ? 'true' : 'false' %>"><%= mark %></button><% }) %></div></div><% }) %>
</div>
<label>コメント<textarea name="comment" maxlength="1000" rows="3"><%= ownResponse?.comment || '' %></textarea></label><button type="submit" class="button button-primary">出欠を送る</button></form>
<% } else { %><p>あなたは回答対象に含まれていません。</p><% } %>
<% if (closed && ownResponse) { %><ul><% poll.candidates.forEach((c,i) => { %><li><%= c.date %> <%= c.time %>：<%= ownResponse.answers[i] %></li><% }) %></ul><p class="attendance-memo"><%= ownResponse.comment %></p><% } %>
</section>
<section class="content-card"><div class="attendance-section-heading"><h2>結果の集計</h2><p>回答済み <%= responseCount %>人 / 対象 <%= poll.recipients.length %>人（未回答 <%= poll.recipients.length - responseCount %>人）</p></div><div class="attendance-table-scroll"><table><thead><tr><th>日程候補</th><th>○</th><th>△</th><th>×</th></tr></thead><tbody><% summary.forEach(row => { %><tr><th><%= row.date %> <%= row.time %></th><% ['○','△','×'].forEach(mark => { %><td><%= row.counts[mark] %>人</td><% }) %></tr><% }) %></tbody></table></div></section>
<% if (creator) { %><section class="content-card"><div class="attendance-export-heading"><h2>出欠表</h2><div class="attendance-export-actions"><a class="button button-primary" href="<%= base %>/<%= poll._id %>/responses.xlsx">出欠表をダウンロード（Excel）</a><p>開封パスワード：<code><%= exportPassword %></code></p></div></div><div class="attendance-table-scroll"><table><thead><tr><th>氏名</th><% poll.candidates.forEach(c => { %><th><%= c.date %> <%= c.time %></th><% }) %><th>コメント</th></tr></thead><tbody><% poll.recipients.forEach(id => { const m = members.find(m => String(m.user?._id) === String(id)); const r = responses.find(r => String(r.user) === String(id)); %><tr><th><%= m?.user?.displayname || m?.user?.username || '退会済み会員' %></th><% poll.candidates.forEach((c,i) => { %><td><%= r?.answers[i] || '未回答' %></td><% }) %><td class="attendance-memo"><%= r?.comment || '' %></td></tr><% }) %></tbody></table></div></section><% } %>
</main><script src="/assets/attendance-response.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>
