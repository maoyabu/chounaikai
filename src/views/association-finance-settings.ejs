<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell finance-shell">
  <a class="back-link" href="/associations/<%= association._id %>/finance">← 会計管理トップへ戻る</a>
  <div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>町内会会計の設定</h1></div></div>
  <form class="form-card form-stack" action="/associations/<%= association._id %>/finance/settings" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="finance-public-toggle"><span>会計を住人に公開する</span><label class="finance-toggle"><input type="checkbox" name="financePublic" <%= association.financePublic ? 'checked' : '' %>><span aria-hidden="true"></span></label></div>
    <label>年度の開始月<select name="fiscalStartMonth"><% for (let month = 1; month <= 12; month++) { %><option value="<%= month %>" <%= Number(association.financeFiscalStartMonth || 4) === month ? 'selected' : '' %>><%= month %>月</option><% } %></select></label>
    <div class="form-actions"><button class="button button-primary">基本設定を保存</button></div>
  </form>
  <%- include('partials/finance-payment-methods', { paymentMethods: paymentMethods || [] }) %>
  <form class="finance-year-selector" method="get"><label>予算年度<select name="year" onchange="this.form.submit()"><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { %><option value="<%= fiscal %>" <%= Number(year) === fiscal ? 'selected' : '' %>><%= fiscal %>年度</option><% } %></select></label></form>
  <div class="content-card finance-budget-copy"><label>予算項目のコピー元<select id="finance-budget-copy-source"><option value="">年度を選択</option><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { if (fiscal !== Number(year)) { %><option value="<%= fiscal %>"><%= fiscal %>年度</option><% } } %></select></label><button type="button" class="button button-primary" id="finance-budget-copy-button">収入・支出をコピー</button></div>
  <%- include('partials/finance-budget-settings', { budgets, year, association, csrfToken }) %>
</main><%- include('partials/foot') %>
<script>(()=>{const button=document.getElementById('finance-budget-copy-button'),source=document.getElementById('finance-budget-copy-source');button?.addEventListener('click',async()=>{if(!source.value){alert('コピー元年度を選択してください。');return}const send=async(overwrite='0')=>fetch('<%= `/associations/${association._id}/finance/settings/budgets/copy` %>',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({sourceYear:source.value,targetYear:'<%= year %>',overwrite,_csrf:'<%= csrfToken %>'})});let response=await send(),result=await response.json();if(response.status===409&&confirm(result.message)){response=await send('1');result=await response.json()}if(!response.ok){alert(result.message||'予算項目のコピーに失敗しました。');return}location.href=result.redirect});document.querySelectorAll('.finance-budget-section').forEach(section=>{const rows=section.querySelector('.finance-budget-rows'),total=document.createElement('div');total.className='finance-budget-total';total.innerHTML='予算合計：<strong>¥0</strong>';rows.after(total);const update=()=>{const sum=[...rows.querySelectorAll('.finance-amount-input')].reduce((n,input)=>n+(Number(input.value.replace(/,/g,''))||0),0);total.querySelector('strong').textContent='¥'+sum.toLocaleString('ja-JP')};section.addEventListener('input',update);section.addEventListener('click',()=>setTimeout(update,0));update()})})();</script>
<script>(()=>{const form=document.querySelector('.finance-budget-form'),tabInput=document.createElement('input');tabInput.type='hidden';tabInput.name='budgetTab';tabInput.value='<%= budgetTab || "収入" %>';form?.append(tabInput);const active='<%= budgetTab || "収入" %>';document.querySelectorAll('[data-budget-tab]').forEach(tab=>{tab.classList.toggle('is-active',tab.dataset.budgetTab===active);tab.addEventListener('click',()=>{tabInput.value=tab.dataset.budgetTab})});document.querySelectorAll('[data-budget-panel]').forEach(panel=>{panel.hidden=panel.dataset.budgetPanel!==active});})();</script>
