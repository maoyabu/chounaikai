<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell finance-shell">
  <a class="back-link" href="/associations/<%= association._id %>/finance">← 会計管理トップへ戻る</a>
  <div class="page-heading"><div><p class="eyebrow"><%= association.name %></p><h1>町内会会計の設定</h1></div></div>
  <form class="form-card form-stack" action="/associations/<%= association._id %>/finance/settings" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="finance-public-toggle"><span>会計を住人に公開する</span><label class="finance-toggle"><input type="checkbox" name="financePublic" <%= association.financePublic ? 'checked' : '' %>><span aria-hidden="true"></span></label></div>
    <label>年度の開始月<select name="fiscalStartMonth"><% for (let month = 1; month <= 12; month++) { %><option value="<%= month %>" <%= Number(association.financeFiscalStartMonth || 4) === month ? 'selected' : '' %>><%= month %>月</option><% } %></select></label>
    <div class="form-actions"><button class="button button-primary">基本設定を保存</button></div>
  </form>
  <%- include('partials/finance-payment-methods', { paymentMethods: paymentMethods || [] }) %>
  <form class="finance-year-selector" method="get"><label>予算年度<select name="year" onchange="this.form.submit()"><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { %><option value="<%= fiscal %>" <%= Number(year) === fiscal ? 'selected' : '' %>><%= fiscal %>年度</option><% } %></select></label></form>
  <div class="content-card finance-budget-copy"><label>予算項目のコピー元<select id="finance-budget-copy-source"><option value="">年度を選択</option><% for (let fiscal = new Date().getFullYear() - 2; fiscal <= new Date().getFullYear() + 3; fiscal++) { if (fiscal !== Number(year)) { %><option value="<%= fiscal %>"><%= fiscal %>年度</option><% } } %></select></label><button type="button" class="button button-primary" id="finance-budget-copy-button">収入・支出をコピー</button></div>
  <%- include('partials/finance-budget-settings', { budgets, year, association, csrfToken }) %>
</main><%- include('partials/foot') %>
<script>(()=>{const button=document.getElementById('finance-budget-copy-button'),source=document.getElementById('finance-budget-copy-source');button?.addEventListener('click',async()=>{if(!source.value){alert('コピー元年度を選択してください。');return}const send=async(overwrite='0')=>fetch('<%= `/associations/${association._id}/finance/settings/budgets/copy` %>',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({sourceYear:source.value,targetYear:'<%= year %>',overwrite,_csrf:'<%= csrfToken %>'})});try{let response=await send(),result=await response.json();if(response.status===409){if(!confirm(result.message))return;response=await send('1');result=await response.json()}if(!response.ok){alert(result.message||'予算項目のコピーに失敗しました。');return}location.href=result.redirect}catch{alert('予算項目のコピーに失敗しました。')}});document.querySelectorAll('.finance-budget-section').forEach(section=>{const rows=section.querySelector('.finance-budget-rows'),total=document.createElement('div');total.className='finance-budget-total';total.innerHTML='予算合計：<strong>¥0</strong>';rows.after(total);const update=()=>{const sum=[...rows.querySelectorAll('.finance-amount-input')].reduce((n,input)=>n+(Number(input.value.replace(/,/g,''))||0),0);total.querySelector('strong').textContent='¥'+sum.toLocaleString('ja-JP')};section.addEventListener('input',update);section.addEventListener('click',()=>setTimeout(update,0));update()})})();</script>
<script>(()=>{const form=document.querySelector('.finance-budget-form'),tabInput=document.createElement('input');tabInput.type='hidden';tabInput.name='budgetTab';tabInput.value='<%= budgetTab || "収入" %>';form?.append(tabInput);const active='<%= budgetTab || "収入" %>';document.querySelectorAll('[data-budget-tab]').forEach(tab=>{tab.classList.toggle('is-active',tab.dataset.budgetTab===active);tab.addEventListener('click',()=>{tabInput.value=tab.dataset.budgetTab})});document.querySelectorAll('[data-budget-panel]').forEach(panel=>{panel.hidden=panel.dataset.budgetPanel!==active});})();</script>
<script>(()=>{document.addEventListener('close',event=>{const dialog=event.target;if(!dialog.matches('.finance-detail-budget-dialog')||dialog.returnValue!=='ok'||!dialog.row)return;const total=[...dialog.querySelectorAll('[data-key="budget"]')].reduce((sum,input)=>sum+(Number(input.value.replace(/,/g,''))||0),0),amount=dialog.row.querySelector('.finance-amount-input');if(amount){amount.value=total.toLocaleString('ja-JP');amount.readOnly=true}});})();</script>
<script>(()=>{const form=document.querySelector('.finance-budget-form'),saved=<%- JSON.stringify(Object.fromEntries(budgets.filter(item=>item.cf==='支出').map(item=>[item.expense_item||'',item.details||[]]))) %>,states=new WeakMap();let modal;const makeModal=()=>{modal=document.createElement('dialog');modal.className='finance-detail-budget-dialog';modal.innerHTML='<form method="dialog" class="form-card"><h3>明細予算</h3><div class="finance-detail-rows"></div><button type="button" class="button button-quiet finance-detail-add">＋明細追加</button><div class="form-actions"><button value="cancel" class="button button-quiet">キャンセル</button><button value="ok" class="button button-primary">明細を反映</button></div></form>';document.body.append(modal);modal.querySelector('.finance-detail-add').onclick=()=>addDetail({});modal.addEventListener('close',()=>{if(modal.returnValue==='ok'&&modal.row)states.set(modal.row,readDetails())})};const addDetail=detail=>{const row=document.createElement('div');row.className='finance-detail-row';row.innerHTML='<input placeholder="明細名称" data-key="name"><input placeholder="明細内容" data-key="content"><input placeholder="予算額" inputmode="numeric" data-key="budget"><input placeholder="メモ" data-key="memo"><button type="button" class="button button-danger-outline">削除</button>';Object.entries(detail).forEach(([key,value])=>{const input=row.querySelector(`[data-key="${key}"]`);if(input)input.value=value});row.querySelector('button').onclick=()=>row.remove();modal.querySelector('.finance-detail-rows').append(row)};const readDetails=()=>[...modal.querySelectorAll('.finance-detail-row')].map(row=>Object.fromEntries([...row.querySelectorAll('[data-key]')].map(input=>[input.dataset.key,input.dataset.key==='budget'?Number(input.value.replace(/,/g,''))||0:input.value.trim()]))).filter(detail=>detail.name||detail.content||detail.budget||detail.memo);const bind=section=>{if(section.dataset.budgetPanel!=='支出')return;section.querySelector('.finance-budget-rows').querySelectorAll('.finance-budget-row').forEach(row=>{if(row.dataset.detailsBound)return;row.dataset.detailsBound='1';const name=row.querySelector('[name="itemName"]');const hidden=document.createElement('input');hidden.type='hidden';hidden.name='itemDetails';row.append(hidden);const details=saved[name?.value]||[];states.set(row,details);const button=document.createElement('button');button.type='button';button.className='button button-quiet finance-detail-edit';button.textContent='明細予算';button.onclick=()=>{if(!modal)makeModal();modal.row=row;modal.querySelector('.finance-detail-rows').replaceChildren();(states.get(row)||[]).forEach(addDetail);modal.showModal()};row.append(button);row.querySelector('.finance-amount-input').readOnly=details.length>0})};document.querySelectorAll('.finance-budget-section').forEach(bind);document.addEventListener('finance-budget-row-added',event=>{const section=event.target.closest('.finance-budget-section');if(section)bind(section)});form?.addEventListener('submit',()=>{document.querySelectorAll('.finance-budget-section').forEach(section=>section.querySelectorAll('.finance-budget-row').forEach(row=>{if(row.dataset.detailsBound){row.querySelector('[name="itemDetails"]').value=JSON.stringify(states.get(row)||[])}}))});})();</script>
