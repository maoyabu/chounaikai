<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/manage">← グループ管理へ戻る</a><section class="page-heading"><h1><%= group.name %> グループ行事管理</h1></section><section class="content-card management-card"><div class="section-heading"><h2>行事一覧</h2><button type="button" class="button button-primary" data-event-open="new-event-dialog">新しい行事を登録</button></div><div class="association-event-manage-list"><% events.forEach(event => { %><article class="association-event-manage-item <%= event.completed ? 'is-completed' : '' %>"><div class="association-event-manage-heading"><span class="association-event-color" style="background-color:<%= event.color %>"></span><div><strong><%= event.title %></strong><small><%= event.startDate %>・<%= event.category %></small></div><div class="association-event-inline-actions"><button type="button" class="button button-quiet button-small" data-event-open="edit-event-<%= event._id %>">編集</button><form action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/events/<%= event._id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline button-small">削除</button></form></div></div></article><dialog class="association-event-dialog" id="edit-event-<%= event._id %>"><div class="dialog-heading"><h3><%= event.title %>を編集</h3><button type="button" class="dialog-close" data-event-close>×</button></div><%- include('partials/association-event-form', { action: `/associations/${group.association}/groups/${group._id}/manage/events/${event._id}`, event, categories, csrfToken }) %></dialog><% }) %></div></section><dialog class="association-event-dialog" id="new-event-dialog"><div class="dialog-heading"><h3>新しい行事を登録</h3><button type="button" class="dialog-close" data-event-close>×</button></div><%- include('partials/association-event-form', { action: `/associations/${group.association}/groups/${group._id}/manage/events`, event: null, categories, csrfToken }) %></dialog></main><script>document.addEventListener('click',e=>{const o=e.target.closest('[data-event-open]');if(o)document.getElementById(o.dataset.eventOpen)?.showModal();if(e.target.closest('[data-event-close]'))e.target.closest('dialog')?.close()});</script><%- include('partials/foot') %>
