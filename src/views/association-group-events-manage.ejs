<%- include('partials/head') %><%- include('partials/header') %><script>window.eventReports=<%- JSON.stringify(Object.fromEntries(events.map(event=>[String(event._id), event.implementationReport || '']))) %>;</script>
<main class="page-shell"><a class="back-link" href="/associations/<%= group.association %>/groups/<%= group._id %>/manage">← グループ管理へ戻る</a><section class="page-heading"><h1><%= group.name %> グループ行事管理</h1></section>
<section class="content-card management-card"><div class="section-heading"><h2>行事一覧</h2><button type="button" class="button button-primary" data-event-open="new-event-dialog">新しい行事を登録</button></div><div class="association-event-manage-list"><% events.forEach(event => { %><article class="association-event-manage-item"><div class="association-event-manage-heading"><span class="association-event-color" style="background-color:<%= event.color %>"></span><div><strong><%= event.title %></strong><small><%= event.startDate %>・<%= event.category %></small></div><% if (event.completed) { %><span class="association-event-completed-tag">完了</span><% } %><div class="association-event-inline-actions"><button type="button" class="button button-quiet button-small" data-event-open="edit-event-<%= event._id %>">編集</button><% if (event.completed) { %><form action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/events/<%= event._id %>/complete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small">未完了</button></form><% } else { %><button type="button" class="button button-quiet button-small" data-event-open="report-event-<%= event._id %>">完了</button><% } %><form action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/events/<%= event._id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline button-small">削除</button></form></div></div></article><dialog class="association-event-dialog event-report-dialog" id="report-event-<%= event._id %>"><div class="dialog-heading"><h3><%= event.title %>の実施報告</h3><button type="button" class="dialog-close" data-event-close>×</button></div><form class="resident-officer-form" action="/associations/<%= group.association %>/groups/<%= group._id %>/manage/events/<%= event._id %>/complete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="completed" value="on"><label>イベントの実施報告<textarea name="implementationReport" rows="7" placeholder="実施内容や結果を入力してください"></textarea></label><div class="form-actions"><button type="button" class="button button-quiet" data-event-close>キャンセル</button><button class="button button-primary">保存して完了</button></div></form></dialog><dialog class="association-event-dialog" id="edit-event-<%= event._id %>"><div class="dialog-heading"><h3><%= event.title %>を編集</h3><button type="button" class="dialog-close" data-event-close>×</button></div><%- include('partials/association-event-form', { action: `/associations/${group.association}/groups/${group._id}/manage/events/${event._id}`, event, categories, csrfToken }) %></dialog><% }); %></div></section><dialog class="association-event-dialog" id="new-event-dialog"><div class="dialog-heading"><h3>新しい行事を登録</h3><button type="button" class="dialog-close" data-event-close>×</button></div><%- include('partials/association-event-form', { action: `/associations/${group.association}/groups/${group._id}/manage/events`, event: null, categories, csrfToken }) %></dialog>
</main><script>document.addEventListener('click',e=>{const tag=e.target.closest('.association-event-completed-tag');if(tag){const item=tag.closest('.association-event-manage-item');const id=item?.querySelector('[data-event-open^="edit-event-"]')?.dataset.eventOpen?.replace('edit-event-','');const dialog=document.getElementById(`report-event-${id}`);if(dialog?.querySelector('textarea'))dialog.querySelector('textarea').value=window.eventReports[id]||'';}const o=e.target.closest('[data-event-open]');if(o)document.getElementById(o.dataset.eventOpen)?.showModal();if(e.target.closest('[data-event-close]'))e.target.closest('dialog')?.close()});</script><%- include('partials/foot') %>
