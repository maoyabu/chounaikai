<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-shell dashboard-shell">
  <% if (notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
  <section class="page-heading dashboard-heading">
    <% if (memberships.length) { const primaryMembership = memberships[0]; %><a class="dashboard-association-title" href="/associations/<%= primaryMembership.association._id %>"><span class="dashboard-title-main"><span class="dashboard-name-and-arrow"><span class="dashboard-association-name"><% if (primaryMembership.association.symbolImage?.url) { %><img class="dashboard-association-symbol" src="<%= primaryMembership.association.symbolImage.url %>" alt=""><% } %><span><%= primaryMembership.association.name %></span></span><span class="dashboard-title-arrow" aria-hidden="true">→</span></span><% if (primaryMembership.districtGroup?.name) { %><span class="status-badge"><%= primaryMembership.districtGroup.name %></span><% } %><% (primaryMembership.memberTags || ['メンバー']).forEach((tag) => { %><span class="status-badge member-attribute-tag"><%= tag %></span><% }) %></span></a><% } else { %><div><p class="eyebrow">ホーム</p><h1>町内会ホーム</h1><p>お知らせや地域の情報を確認できます。</p></div><% } %>
    <% if (memberships.length === 0) { %><a class="button button-primary" href="/associations">町内会一覧を見る</a><% } %>
  </section>
  <details class="admin-section application-section notification-inbox" <%= typeof currentPath !== 'undefined' && currentPath === '/dashboard' && typeof notificationInboxOpen !== 'undefined' && notificationInboxOpen ? 'open' : '' %>>
    <summary class="section-heading"><strong class="notification-heading">お知らせ</strong><span class="notification-summary-meta"><% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %><span class="status-badge question-unread notification-unread-tag">未読 <%= unreadNotificationCount %>件</span><% } %><span class="notification-chevron" aria-hidden="true">⌄</span></span></summary>
    <% if (notifications?.length) { %><div class="notification-list"><% notifications.forEach((item) => { %><article class="<%= item.readAt ? '' : 'notification-item-unread' %>"><div class="notification-item-heading"><strong><%= item.title %></strong><% if (!item.readAt) { %><span class="status-badge question-unread">未読</span><% } %></div><p><%= item.body %></p><small><%= item.association?.name || '' %></small><div class="notification-actions"><% if (item.actionUrl) { %><a class="button button-primary button-small" href="<%= item.actionUrl %>"><%= item.actionLabel || '内容を確認' %></a><% } %><% if (item.readAt) { %><button class="button button-quiet button-small" type="button" disabled>確認済み</button><% } else { %><form action="/notifications/<%= item._id %>/read" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit">確認済みにする</button></form><% } %><form action="/notifications/<%= item._id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger-outline button-small" type="submit">削除</button></form></div></article><% }) %></div><% } else { %><div class="admin-empty"><p>お知らせはありません。</p></div><% } %>
  </details>
  <% if (typeof associationEvents !== 'undefined' && memberships.length) { memberships.forEach(membership => { const events = associationEvents.filter(event => String(event.association) === String(membership.association._id)); const months = eventMonths; const associationName = memberships.length > 1 ? membership.association.name : null; const calendarWindow = eventWindow; const calendarPath = '/dashboard'; const calendarAnchor = `association-events-${membership.association._id}`; %><%- include('partials/association-event-calendar', { events, months, associationName, calendarWindow, calendarPath, calendarAnchor }) %><% }); } %>
  <% if (typeof officerNetworkBoxes !== 'undefined' && officerNetworkBoxes.length) { %><section class="admin-section question-home-section communication-theme communication-home-section"><div class="section-heading"><h2>役員間の連絡網</h2></div><div class="question-home-list"><% officerNetworkBoxes.forEach((box) => { %><a class="question-home-link" href="/associations/<%= box.association._id %>/officer-network/inbox"><span><strong class="dashboard-association-name"><% if (box.association.symbolImage?.url) { %><img class="dashboard-association-symbol" src="<%= box.association.symbolImage.url %>" alt=""><% } %><span><%= box.association.name %></span></strong><small>役員間の連絡を確認する</small></span><span class="question-home-counts"><% if (box.unreadCount) { %><span class="status-badge question-unread">未確認 <%= box.unreadCount %>件</span><% } %></span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% } %>
  <% if (typeof announcementBoxes !== 'undefined' && announcementBoxes.length) { %><section class="admin-section question-home-section communication-theme communication-home-section"><div class="section-heading"><h2>町内会役員から住人への連絡</h2></div><div class="question-home-list"><% announcementBoxes.forEach((box) => { %><a class="question-home-link" href="/associations/<%= box.association._id %>/announcements"><span><strong class="dashboard-association-name"><% if (box.association.symbolImage?.url) { %><img class="dashboard-association-symbol" src="<%= box.association.symbolImage.url %>" alt=""><% } %><span><%= box.association.name %></span></strong><small>班長・住人への連絡を確認する</small></span><span class="question-home-counts"><% if (box.unreadCount) { %><span class="status-badge question-unread">未確認 <%= box.unreadCount %>件</span><% } %></span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% } %>
  <% if (typeof districtMessageBoxes !== 'undefined' && districtMessageBoxes.length) { %><section class="admin-section question-home-section communication-theme communication-home-section"><div class="section-heading"><h2>班内の連絡</h2></div><div class="question-home-list"><% districtMessageBoxes.forEach((box) => { %><a class="question-home-link" href="/associations/<%= box.association._id %>/district-messages"><span><strong><%= box.districtGroup.name %></strong><small>班の住人に連絡する・届いた連絡を確認する</small></span><span class="question-home-counts"><% if (box.unreadCount) { %><span class="status-badge question-unread">未確認 <%= box.unreadCount %>件</span><% } %></span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% } %>
  <% if (typeof groupMessageBoxes !== 'undefined' && groupMessageBoxes.length) { %><section class="admin-section question-home-section communication-theme group-communication-theme communication-home-section"><div class="section-heading"><h2>町内会のグループの連絡</h2></div><div class="question-home-list"><% groupMessageBoxes.forEach((box) => { %><a class="question-home-link" href="/associations/<%= box.group.association %>/groups/<%= box.group._id %>/messages"><span><strong><%= box.group.name %></strong><small>グループ内の連絡を確認する</small></span><span class="question-home-counts"><% if (box.unreadCount) { %><span class="status-badge question-unread">未確認 <%= box.unreadCount %>件</span><% } %></span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% } %>
  <% if (applications?.length) { %>
    <section class="admin-section application-section"><div class="section-heading"><div><p class="eyebrow">申請状況</p><h2>承認待ち</h2></div></div><div class="admin-list">
      <% applications.forEach((association) => { %><a class="admin-list-item" href="/associations/<%= association._id %>"><span class="list-icon">申</span><span class="list-main"><strong><%= association.name %></strong><small><%= association.serviceArea || '対象地域未設定' %></small></span><span class="status-badge status-pending">承認待ち</span><span class="list-arrow">›</span></a><% }) %>
    </div></section>
  <% } %>
  <% if (memberships.length === 0) { %>
    <section class="empty-state">
      <div class="empty-mark" aria-hidden="true">町</div>
      <h2>参加中の町内会はありません</h2>
      <p>招待または参加申請が承認されると、ここに表示されます。</p>
      <a class="button button-primary" href="/associations">存在する町内会を選んで参加申請する</a>
    </section>
  <% } %>
  <% if (pendingJoins?.length) { %><section class="content-card join-section"><p class="eyebrow">参加申請</p><h2>参加申請を確認中</h2><div class="management-list"><% pendingJoins.forEach((application) => { %><div><span><%= application.status === 'awaiting_household' ? '世帯主の確認待ちです。' : '班長・町内会管理者の承認待ちです。' %></span><a class="button button-quiet button-small" href="/associations/<%= application.association %>/participation">申請状況を確認</a></div><% }) %></div></section><% } %>
  <% if (typeof residentRegistration !== 'undefined' && residentRegistration && !pendingJoins?.length && !memberships.length) { %><section class="content-card join-section"><h2>住民として町内会に参加</h2><p>世帯主として世帯を登録するか、一般メンバーとして同居する世帯に参加できます。</p><a class="button button-primary" href="/resident-onboarding">参加手続きを続ける</a></section><% } %>
  <% if (memberships.length === 0 && availableAssociations?.length) { %><section class="content-card join-section"><p class="eyebrow">町内会へ参加</p><h2>参加申請できる町内会</h2><div class="management-list"><% availableAssociations.forEach((association) => { %><div><span><strong><%= association.name %></strong><small><%= association.serviceArea || '対象地域未設定' %></small></span><a class="button button-primary button-small" href="/associations/<%= association._id %>/join">町内会と班を選択</a></div><% }) %></div></section><% } %>
  <% if (typeof financeReports !== 'undefined' && financeReports?.length) { %><section class="admin-section question-home-section finance-report-home finance-theme"><div class="section-heading"><h2>会計報告</h2><small>公開された町内会会計を確認できます。</small></div><div class="question-home-list"><% financeReports.forEach((box) => { %><a class="question-home-link" href="/associations/<%= box.association._id %>/finance/public"><span><strong class="dashboard-association-name"><%= box.association.name %></strong></span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% } %>
  <% if (typeof questionBoxes !== 'undefined' && questionBoxes?.length) { %><section class="admin-section question-home-section"><div class="section-heading"><h2>質問・ご意見箱</h2><small class="question-box-heading-note">町内会への質問や意見、行政への働きかけにつなげる窓口</small></div><div class="question-home-list"><% questionBoxes.forEach((box) => { %><a class="question-home-link" href="/associations/<%= box.association._id %>/questions"><span><strong class="dashboard-association-name"><% if (box.association.symbolImage?.url) { %><img class="dashboard-association-symbol" src="<%= box.association.symbolImage.url %>" alt=""><% } %><span><%= box.association.name %></span></strong></span><span class="question-home-counts"><% if (box.unreadAnswers) { %><span class="status-badge question-unread">新しい回答 <%= box.unreadAnswers %>件</span><% } %></span><span class="list-arrow" aria-hidden="true">›</span></a><% }) %></div></section><% } %>
</main>
<%- include('partials/foot') %>
