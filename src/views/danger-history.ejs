<%- include('partials/head') %><%- include('partials/header') %><main class="page-shell"><a href="/dashboard">← ホーム</a><section class="content-card danger-section"><p class="eyebrow"><%= association.name %></p><h1>緊急・危険情報の地図・履歴</h1><% if (reports.length) { %>
<% if (mapsKey) { %><div id="danger-history-map" class="danger-map" data-points="<%= JSON.stringify(reports.map(report => ({ latitude: report.latitude, longitude: report.longitude, title: report.title, url: `/associations/${association._id}/dangers/${report._id}` }))) %>"></div><script src="/assets/danger-map.js?v=<%= assetVersion %>"></script><script src="https://maps.googleapis.com/maps/api/js?key=<%= encodeURIComponent(mapsKey) %>&amp;callback=initDangerMap" async defer></script><% } else { %><p>履歴の「場所を地図で表示」を押すと、地図の表示場所が切り替わります。</p><iframe id="danger-history-frame" class="danger-map" title="緊急・危険情報のGoogleマップ" src="https://www.google.com/maps?q=<%= reports[0].latitude %>,<%= reports[0].longitude %>&amp;output=embed" referrerpolicy="no-referrer-when-downgrade"></iframe><% } %>
<p>このページの投稿（最大50件）を表示しています。</p><% reports.forEach(report => { %><article><%- include('partials/danger-card', { report }) %><button type="button" data-danger-position="<%= report.latitude %>,<%= report.longitude %>">場所を地図で表示</button></article><% }) %><% } else { %><p>緊急・危険情報の投稿はありません。</p><% } %><nav aria-label="履歴のページ"><% if (page > 1) { %><a href="?page=<%= page - 1 %>">← 前の50件</a><% } %> <% if (hasNext) { %><a href="?page=<%= page + 1 %>">次の50件 →</a><% } %></nav></section></main><script src="/assets/danger-history.js?v=<%= assetVersion %>" defer></script><%- include('partials/foot') %>