<%- include('partials/head') %>
<main class="page-shell resident-participation-shell">
  <a class="back-link" href="/login">← ログインへ戻る</a>
  <section class="content-card">
    <h1>パスワードの再設定</h1>
    <% if (message) { %><p role="status"><%= message %></p><% } %>
    <% if (formError) { %><div class="alert alert-error" role="alert"><%= formError %></div><% } %>
    <% if (mode === 'request') { %>
      <p>登録済みのメールアドレスに再設定リンクを送ります。</p>
      <form action="/forgot-password" method="post" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>メールアドレス<input type="email" name="email" autocomplete="email" maxlength="254" required></label>
        <button class="button button-primary">再設定メールを送る</button>
      </form>
    <% } else if (mode === 'reset') { %>
      <p>共通アカウントを使用する他のサービスのパスワードも変更されます。</p>
      <form action="/reset-password" method="post" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>新しいパスワード<input type="password" name="password" autocomplete="new-password" minlength="8" maxlength="128" required></label>
        <label>新しいパスワード（確認）<input type="password" name="passwordConfirmation" autocomplete="new-password" minlength="8" maxlength="128" required></label>
        <button class="button button-primary">パスワードを再設定</button>
      </form>
    <% } else if (mode === 'invalid') { %><p>リンクが無効、使用済み、または期限切れです。</p><a href="/forgot-password">再設定メールを再送する</a><% } %>
  </section>
</main>
<%- include('partials/foot') %>
