<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%= association._id %>/manage">← 運営管理へ戻る</a><section class="page-heading association-title-heading"><div><p class="eyebrow">住人一覧</p><h1><%= association.name %>住人一覧</h1><p>町内会に所属している住人を検索できます。</p></div></section>
<section class="content-card management-card"><div class="member-directory-filters"><label>班<select id="member-filter-district"><option value="">すべての班</option><% districtGroups.forEach(g=>{ %><option value="<%=g._id%>"><%=g.name%></option><% }) %></select></label><label>役職<select id="member-filter-role"><option value="">すべての役職</option><option value="manager">町内会管理者</option><option value="leader">班長</option><% roles.forEach(r=>{ %><option value="<%=r._id%>"><%=r.name%></option><% }) %></select></label><label>部会<select id="member-filter-department"><option value="">すべての部会</option><% departments.forEach(d=>{ %><option value="<%=d._id%>"><%=d.name%></option><% }) %></select></label><label>氏名・メールアドレス<input type="search" id="member-filter-query" placeholder="部分一致で検索" autocomplete="off"></label></div>
<div class="resident-selection-list member-directory-list"><% members.forEach(m=>{ const n=m.user.displayname||m.user.username,e=m.user.email||'メール未登録',d=m.districtGroup?.name||'班未設定',a=`〒${m.household?.address?.postalCode||'—'} ${m.household?.address?.street||''} ${m.household?.address?.building||''}`,roleId=String(m.officer?.role?._id||''),departmentId=m.officer?.department?._id||'',roleValues=[m.isAssociationManager?'manager':'',m.isLeader?'leader':'',roleId].filter(Boolean).join(' '); %><article class="record-editable" data-member-row data-district="<%=m.districtGroup?._id||''%>" data-roles="<%=roleValues%>" data-department="<%=departmentId%>" data-query="<%=[n,e].join(' ')%>"><div class="resident-row-button resident-row-static"><strong><%=n%>さん</strong><span class="resident-tags"><span class="status-badge"><%=d%></span><% if(m.isAssociationManager){ %><span class="status-badge member-attribute-tag">町内会管理者</span><% } %><% if(m.isLeader){ %><span class="status-badge member-attribute-tag">班長</span><% } %><% if(m.officer){ %><span class="status-badge member-attribute-tag">役員</span><% } %><% if(m.officer?.role?.name){ %><span class="status-badge member-attribute-tag"><%=m.officer.role.name%></span><% } %><% if(m.officer?.department?.name){ %><span class="status-badge member-attribute-tag"><%=m.officer.department.name%></span><% } %></span><span><%=e%></span><span class="resident-address"><%=a%></span></div></article><% }) %></div><p id="member-filter-empty" class="help-text" hidden>条件に一致する住人はいません。</p></section>
<script>
const editableMembers = <%- JSON.stringify(members) %>;
const memberLocations = <%- JSON.stringify(typeof locationOptions !== 'undefined' ? locationOptions : districtGroups.map((item) => ({ ...item, label: item.name }))) %>;
document.querySelectorAll('[data-member-row]').forEach((row, index) => { const member = editableMembers[index]; row.addEventListener('click', (event) => { if (event.target.closest('button,a,input,select,form,dialog')) return; const dialog = document.createElement('dialog'); dialog.className = 'officer-dialog record-edit-dialog'; const household = member.household || {}; dialog.innerHTML = `<div class="dialog-heading"><h3>住人情報を編集</h3><button type="button" class="dialog-close">×</button></div><form method="post" class="resident-officer-form" action="/associations/<%= association._id %>/manage/members/${member._id}/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>氏名<input name="name" value="${member.user?.displayname || member.user?.username || ''}" required></label><label>メールアドレス<input name="email" type="email" value="${member.user?.email || ''}" required></label><label>地区<select data-member-district required><option value="">地区を選択してください</option>${memberLocations.filter(item => !item.parentDistrict).map(item => `<option value="${item._id}">${item.label}</option>`).join('')}</select></label><label>班<select data-member-group><option value="">班を選択してください</option></select></label><input type="hidden" name="districtGroupId" data-member-location><label>郵便番号<input name="postalCode" value="${household.address?.postalCode || ''}"></label><label>住所<input name="address" value="${household.address?.street || ''}"></label><label>建物名<input name="building" value="${household.address?.building || ''}"></label><label>電話番号<input name="phone" type="tel" value="${household.phone || ''}"></label><div class="form-actions"><button type="button" class="button button-quiet dialog-cancel">キャンセル</button><button class="button button-primary">保存</button></div></form>`; const district = dialog.querySelector('[data-member-district]'), group = dialog.querySelector('[data-member-group]'), location = dialog.querySelector('[data-member-location]'); const current = String(member.districtGroup?._id || member.districtGroup || ''); const parent = memberLocations.find(item => String(item._id) === current)?.parentDistrict; district.value = String(parent || current); const refresh = () => { const groups = memberLocations.filter(item => String(item.parentDistrict) === String(district.value)); group.innerHTML = groups.length ? '<option value="">班を選択してください</option>' + groups.map(item => `<option value="${item._id}">${item.label.replace(memberLocations.find(d => String(d._id) === String(district.value))?.label || '', '')}</option>`).join('') : '<option value="">地区全体</option>'; group.required = Boolean(groups.length); group.value = groups.some(item => String(item._id) === current) ? current : ''; location.value = group.value || district.value; }; district.addEventListener('change', refresh); group.addEventListener('change', () => { location.value = group.value || district.value; }); refresh(); dialog.querySelector('.dialog-close').onclick = () => dialog.close(); dialog.querySelector('.dialog-cancel').onclick = () => dialog.close(); document.body.append(dialog); dialog.showModal(); }, true); });
const district=document.getElementById('member-filter-district'),role=document.getElementById('member-filter-role'),department=document.getElementById('member-filter-department'),query=document.getElementById('member-filter-query'),rows=[...document.querySelectorAll('[data-member-row]')],empty=document.getElementById('member-filter-empty'),norm=v=>String(v||'').normalize('NFKC').toLocaleLowerCase('ja');
rows.forEach((row,index)=>{const value=editableMembers[index]?.districtGroup;row.dataset.parentDistrict=value?.parentDistrict||value?._id||'';});
const parentLabel=document.createElement('label');parentLabel.textContent='地区';const parent=document.createElement('select');parent.id='member-filter-parent';parent.innerHTML='<option value="">すべての地区</option>'+memberLocations.filter(item=>!item.parentDistrict).map(item=>`<option value="${item._id}">${item.label}</option>`).join('');parentLabel.append(parent);document.querySelector('.member-directory-filters')?.prepend(parentLabel);const rebuildGroups=()=>{const districtId=parent.value;const groups=memberLocations.filter(item=>String(item.parentDistrict)===String(districtId));district.innerHTML='<option value="">すべての班</option>'+groups.map(item=>`<option value="${item._id}" data-parent="${item.parentDistrict}">${item.label}</option>`).join('');};parent.addEventListener('change',()=>{rebuildGroups();filter();});rebuildGroups();
const filter=()=>{const terms=norm(query.value).trim().split(/\s+/).filter(Boolean);let visible=0;[...district.options].forEach(option=>{if(option.value)option.hidden=Boolean(parent.value)&&option.dataset.parent!==parent.value;});if(district.value&&district.selectedOptions[0]?.hidden)district.value='';rows.forEach(row=>{const roles=row.dataset.roles.split(' '),match=(!parent.value||row.dataset.parentDistrict===parent.value)&&(!district.value||row.dataset.district===district.value)&&(!role.value||roles.includes(role.value))&&(!department.value||row.dataset.department===department.value)&&terms.every(t=>norm(row.dataset.query).includes(t));row.hidden=!match;if(match)visible++});empty.hidden=visible>0};[parent,district,role,department,query].forEach(input=>input.addEventListener('input',filter));filter();
</script></main><%- include('partials/foot') %>
