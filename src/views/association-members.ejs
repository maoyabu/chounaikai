<%- include('partials/head') %><%- include('partials/header') %>
<main class="page-shell"><a class="back-link" href="/associations/<%=association._id%>/manage">← 運営管理へ戻る</a><section class="page-heading association-title-heading"<% if (association.symbolImage?.url) { %> style="--symbol-url: url('<%= association.symbolImage.url %>')"<% } %>><div><p class="eyebrow">住人一覧</p><h1><%=association.name%>住人一覧</h1><p>町内会に所属している住人を検索できます。</p></div></section>
<section class="content-card management-card"><div class="member-directory-filters"><label>班<select id="member-filter-district"><option value="">すべての班</option><%districtGroups.forEach(g=>{%><option value="<%=g._id%>"><%=g.name%></option><%})%></select></label><label>役職<select id="member-filter-role"><option value="">すべての役職</option><option value="manager">町内会管理者</option><option value="leader">班長</option><%roles.forEach(r=>{%><option value="<%=r._id%>"><%=r.name%></option><%})%></select></label><label>部会<select id="member-filter-department"><option value="">すべての部会</option><%departments.forEach(d=>{%><option value="<%=d._id%>"><%=d.name%></option><%})%></select></label><label>氏名・メールアドレス<input type="search" id="member-filter-query" placeholder="部分一致で検索" autocomplete="off"></label></div>
<div class="resident-selection-list member-directory-list"><%members.forEach(m=>{const n=m.user.displayname||m.user.username,e=m.user.email||'メール未登録',d=m.districtGroup?.name||'班未設定',a=`〒${m.household?.address?.postalCode||'—'} ${m.household?.address?.street||''} ${m.household?.address?.building||''}`,roleId=String(m.officer?.role?._id||''),departmentId=m.officer?.department?._id||'',roleValues=[m.isAssociationManager?'manager':'',m.isLeader?'leader':'',roleId].filter(Boolean).join(' ');%><article data-member-row data-district="<%=m.districtGroup?._id||''%>" data-roles="<%=roleValues%>" data-department="<%=departmentId%>" data-query="<%=[n,e].join(' ')%>"><div class="resident-row-button resident-row-static"><%if(m.user.avatar){%><img class="profile-avatar resident-avatar" src="<%=m.user.avatar%>" alt=""><%}else{%><span class="profile-avatar resident-avatar profile-avatar-placeholder"><%=n.charAt(0)%></span><%}%><strong><%=n%>さん</strong><span class="resident-tags"><span class="status-badge"><%=d%></span><%if(m.isAssociationManager){%><span class="status-badge member-attribute-tag">町内会管理者</span><%}%><%if(m.isLeader){%><span class="status-badge member-attribute-tag">班長</span><%}%><%if(m.officer){%><span class="status-badge member-attribute-tag">役員</span><%}%><%if(m.officer?.role?.name){%><span class="status-badge member-attribute-tag"><%=m.officer.role.name%></span><%}%><%if(m.officer?.department?.name){%><span class="status-badge member-attribute-tag"><%=m.officer.department.name%></span><%}%></span><span><%=e%></span><span class="resident-address"><%=a%></span></div></article><%})%></div><p id="member-filter-empty" class="help-text" hidden>条件に一致する住人はいません。</p></section>
<script>(()=>{const district=document.getElementById('member-filter-district'),role=document.getElementById('member-filter-role'),department=document.getElementById('member-filter-department'),query=document.getElementById('member-filter-query'),rows=[...document.querySelectorAll('[data-member-row]')],empty=document.getElementById('member-filter-empty'),norm=v=>String(v||'').normalize('NFKC').toLocaleLowerCase('ja'),filter=()=>{const terms=norm(query.value).trim().split(/\s+/).filter(Boolean);let visible=0;rows.forEach(row=>{const roles=row.dataset.roles.split(' '),match=(!district.value||row.dataset.district===district.value)&&(!role.value||roles.includes(role.value))&&(!department.value||row.dataset.department===department.value)&&terms.every(t=>norm(row.dataset.query).includes(t));row.hidden=!match;if(match)visible++});empty.hidden=visible>0};[district,role,department,query].forEach(input=>input.addEventListener('input',filter));filter()})();</script></main><%- include('partials/foot') %>
